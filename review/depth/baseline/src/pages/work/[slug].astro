---
import Profile from '../../layouts/Profile.astro';
import {projects} from '../../data/profile-projects';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.id},props:{project}}));}
const {project}=Astro.props;
---
<Profile title={`${project.name} — Dave Bettner`} description={project.summary} page="work"><section class="page-intro wrap"><h1>{project.name}</h1><p class="lead">{project.summary}</p><div class="actions"><a class="button" href={project.repo}>View repository</a><a href="/work/">All projects</a></div></section><section class="paper"><div class="section wrap"><div class="case-prose"><p class="case-scope">{project.scope}</p><h2>The problem</h2><p>{project.problem}</p><h2>What I built</h2><p>{project.built}</p><h2>What you can inspect</h2><p>{project.inspect}</p><div class="case-links">{project.proof&&<a href={project.proof}>Read the verification notes</a>}<a href={project.repo}>Source code and documentation</a></div></div></div></section></Profile>
