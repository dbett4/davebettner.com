---
import { emailHref, githubUrl, linkedinUrl } from '../data/site-links';
---

<div class="contact-links">
  <a href={githubUrl} rel="me">GitHub</a>
  <a href={linkedinUrl} rel="me">LinkedIn</a>
  <a href={emailHref}>Email</a>
</div>

<style>
  .contact-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
