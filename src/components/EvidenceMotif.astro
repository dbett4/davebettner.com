---
type Motif = 'failure-retry' | 'guarded-readback' | 'code-fix';
type Props = { motif: Motif; compact?: boolean };
const { motif, compact = false } = Astro.props;
const labels = {
  'failure-retry': ['Write', 'Fault', 'Resume', '1 receipt'],
  'guarded-readback': ['Confirm', 'Write', 'Readback'],
  'code-fix': ['Legacy check', 'Narrow guard', 'Tests'],
}[motif];
---

<div class:list={['evidence-motif', `evidence-motif--${motif}`, { 'evidence-motif--compact': compact }]} data-evidence-motif={motif} aria-hidden="true">
  <span class="motif-trace"></span>
  <ol>{labels.map((label) => <li>{label}</li>)}</ol>
</div>
