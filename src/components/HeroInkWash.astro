---
/** Full-band ordered dither — opaque grain, even edge-to-edge. */
---
<canvas class="hero-ink-wash" aria-hidden="true" data-hero-ink></canvas>

<script is:inline>
  (() => {
    const canvas = document.querySelector('[data-hero-ink]');
    if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;
    const band = canvas.closest('.identity-band');
    if (!band) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const BAYER = [
      0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5,
    ];
    const CELL = 2;
    const PAPER = [243, 239, 229];
    const SHADE = [218, 210, 196];
    const BLUE = [33, 79, 229];
    const ORANGE = [207, 65, 32];

    let cols = 0;
    let rows = 0;
    let displayW = 0;
    let displayH = 0;
    let phase = 0;
    let raf = 0;
    let lastT = 0;
    const offscreen = document.createElement('canvas');
    const offCtx = offscreen.getContext('2d', { alpha: false });

    const resize = () => {
      const rect = band.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      displayW = rect.width;
      displayH = rect.height;
      cols = Math.max(1, Math.ceil(displayW / CELL));
      rows = Math.max(1, Math.ceil(displayH / CELL));
      canvas.width = Math.floor(displayW * dpr);
      canvas.height = Math.floor(displayH * dpr);
      canvas.style.width = `${displayW}px`;
      canvas.style.height = `${displayH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      offscreen.width = cols;
      offscreen.height = rows;
    };

    const draw = (t) => {
      if (!offCtx) return;

      if (!reduced) {
        const dt = lastT ? t - lastT : 16;
        lastT = t;
        phase += dt * 0.00003;
      }

      const image = offCtx.createImageData(cols, rows);
      const data = image.data;

      for (let y = 0; y < rows; y += 1) {
        for (let x = 0; x < cols; x += 1) {
          const bayer = BAYER[((y & 3) << 2) | (x & 3)] / 16;
          const nx = x / cols;
          const ny = y / rows;
          const threshold =
            0.5 +
            0.028 * Math.sin(nx * 3.2 + ny * 2.4 + phase) +
            0.02 * Math.sin(nx * 6.4 - ny * 4.8 - phase * 1.1);
          const on = threshold > bayer;
          const base = on ? SHADE : PAPER;
          const blueMix = 0.035 * (0.5 + 0.5 * Math.sin(nx * 3.8 + ny * 1.6 + phase * 0.8));
          const orangeMix = 0.03 * (0.5 + 0.5 * Math.cos(nx * 2.6 - ny * 2.1 - phase * 0.6));
          const mix = Math.min(0.14, blueMix + orangeMix);
          const accent = blueMix >= orangeMix ? BLUE : ORANGE;
          const r = Math.round(base[0] * (1 - mix) + accent[0] * mix);
          const g = Math.round(base[1] * (1 - mix) + accent[1] * mix);
          const b = Math.round(base[2] * (1 - mix) + accent[2] * mix);
          const i = (y * cols + x) * 4;
          data[i] = r;
          data[i + 1] = g;
          data[i + 2] = b;
          data[i + 3] = 255;
        }
      }

      offCtx.putImageData(image, 0, 0);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(offscreen, 0, 0, cols, rows, 0, 0, displayW, displayH);
    };

    const tick = (t) => {
      draw(t);
      if (!reduced) raf = requestAnimationFrame(tick);
    };

    const ro = new ResizeObserver(() => {
      resize();
      draw(performance.now());
    });
    ro.observe(band);

    resize();
    if (reduced) draw(0);
    else raf = requestAnimationFrame(tick);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        return;
      }
      if (!reduced) raf = requestAnimationFrame(tick);
    });
  })();
</script>

<style is:global>
  .hero-ink-wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
</style>
