---
type Variant = 'ticks' | 'grid' | 'rings' | 'cross';

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'ticks', class: className = '' } = Astro.props;
---

<svg
  class:list={['micro-graphic', `micro-graphic--${variant}`, className]}
  viewBox="0 0 120 120"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {variant === 'ticks' && (
    <>
      <circle cx="60" cy="60" r="38" stroke="currentColor" stroke-width="1" opacity="0.35" />
      <circle cx="63" cy="57" r="38" stroke="var(--orange)" stroke-width="1" opacity="0.22" />
      {Array.from({ length: 24 }, (_, i) => {
        const a = (i / 24) * Math.PI * 2;
        const x1 = 60 + Math.cos(a) * 28;
        const y1 = 60 + Math.sin(a) * 28;
        const x2 = 60 + Math.cos(a) * 44;
        const y2 = 60 + Math.sin(a) * 44;
        return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="currentColor" stroke-width="1" opacity="0.5" />;
      })}
      <rect x="54" y="54" width="12" height="12" stroke="currentColor" stroke-width="1" />
    </>
  )}
  {variant === 'grid' && (
    <>
      <rect x="8" y="8" width="104" height="104" stroke="currentColor" stroke-width="1" opacity="0.4" />
      <rect x="11" y="11" width="104" height="104" stroke="var(--orange)" stroke-width="1" opacity="0.2" />
      {Array.from({ length: 7 }, (_, row) =>
        Array.from({ length: 7 }, (_, col) => {
          const filled = (row + col) % 3 === 0;
          return (
            <rect
              x={16 + col * 14}
              y={16 + row * 14}
              width="10"
              height="10"
              fill={filled ? 'currentColor' : 'none'}
              stroke="currentColor"
              stroke-width="0.75"
              opacity={filled ? 0.55 : 0.3}
            />
          );
        }),
      )}
    </>
  )}
  {variant === 'rings' && (
    <>
      <circle cx="60" cy="60" r="46" stroke="currentColor" stroke-width="1" opacity="0.35" />
      <circle cx="57" cy="63" r="34" stroke="var(--blue)" stroke-width="1" opacity="0.28" />
      <circle cx="63" cy="57" r="22" stroke="var(--orange)" stroke-width="1" opacity="0.32" />
      <circle cx="60" cy="60" r="10" fill="currentColor" opacity="0.45" />
      <line x1="60" y1="6" x2="60" y2="22" stroke="currentColor" stroke-width="1" opacity="0.4" />
      <line x1="60" y1="98" x2="60" y2="114" stroke="currentColor" stroke-width="1" opacity="0.4" />
      <line x1="6" y1="60" x2="22" y2="60" stroke="currentColor" stroke-width="1" opacity="0.4" />
      <line x1="98" y1="60" x2="114" y2="60" stroke="currentColor" stroke-width="1" opacity="0.4" />
    </>
  )}
  {variant === 'cross' && (
    <>
      <line x1="60" y1="8" x2="60" y2="112" stroke="currentColor" stroke-width="1" opacity="0.35" />
      <line x1="8" y1="60" x2="112" y2="60" stroke="currentColor" stroke-width="1" opacity="0.35" />
      <line x1="63" y1="8" x2="63" y2="112" stroke="var(--orange)" stroke-width="1" opacity="0.22" />
      <line x1="8" y1="57" x2="112" y2="57" stroke="var(--blue)" stroke-width="1" opacity="0.22" />
      <rect x="44" y="44" width="32" height="32" stroke="currentColor" stroke-width="1" />
      <circle cx="60" cy="60" r="4" fill="currentColor" opacity="0.6" />
      {Array.from({ length: 8 }, (_, i) => {
        const x = 20 + i * 12;
        return <rect x={x} y="14" width="4" height="4" fill="currentColor" opacity={i % 2 ? 0.25 : 0.5} />;
      })}
    </>
  )}
</svg>

<style>
  .micro-graphic {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--ink);
  }
</style>
