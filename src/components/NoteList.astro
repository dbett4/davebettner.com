---
import type { CollectionEntry } from 'astro:content';
import { formatNoteDate, noteProjects } from '../lib/notes';
interface Props {
  notes: CollectionEntry<'notes'>[];
  headingLevel?: 'h2' | 'h3';
}
const { notes, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<ul class="note-list">
  {notes.map(note => <li>
    <Heading><a href={`/notes/${note.id}/`}>{note.data.title}</a></Heading>
    <div class="note-meta"><time datetime={note.data.date.toISOString().slice(0, 10)}>{formatNoteDate(note.data.date)}</time><span>{noteProjects[note.data.project].name}</span></div>
    <p>{note.data.description}</p>
  </li>)}
</ul>
