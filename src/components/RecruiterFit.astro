---
import {
  aiProviders,
  fitPromptTemplate,
  recruiterFitHeading,
  recruiterFitSubhead,
} from '../data/recruiter-fit';

const providersJson = JSON.stringify(
  aiProviders.map(({ id, label, baseUrl, buildUrl }) => ({
    id,
    label,
    baseUrl,
    prefix: buildUrl('').replace(/=$/, '='),
  })),
);
const templateJson = JSON.stringify(fitPromptTemplate);
---

<section id="fit-check" class="fit-check has-reg-marks" aria-labelledby="fit-check-heading">
  <div class="wrap fit-check-wrap">
    <div class="fit-check-header">
      <h1 class="section-title fit-check-title" id="fit-check-heading">{recruiterFitHeading}</h1>
      <p class="fit-lead">{recruiterFitSubhead}</p>
    </div>

    <div class="fit-form fit-form--deposition">
      <div class="fit-field">
        <span class="fit-field-label mono">Scope</span>
        <label class="fit-label" for="job-description">Job description</label>
        <textarea
          id="job-description"
          class="fit-textarea"
          name="job-description"
          rows="8"
          maxlength="12000"
          aria-describedby="fit-job-hint fit-status"
          aria-invalid="false"
          placeholder="Paste the role title, requirements, and responsibilities from your job posting…"
        ></textarea>
        <p class="fit-input-hint" id="fit-job-hint">Required. Maximum 12,000 characters.</p>
      </div>

      <div class="fit-field">
        <span class="fit-field-label mono">Evidence</span>
        <p class="fit-hint">Pick an assistant. The prompt copies to your clipboard and opens with pre-fill where supported.</p>

        <div class="fit-actions" role="group" aria-label="Open in AI assistant">
          {aiProviders.map((provider) => (
            <button
              type="button"
              class="round fit-ai-btn"
              data-provider={provider.id}
            >
              {provider.label} <span aria-hidden="true">↗</span>
            </button>
          ))}
          <button type="button" class="round blue fit-copy-btn" id="fit-copy-prompt">
            Copy prompt <span aria-hidden="true">⧉</span>
          </button>
        </div>
      </div>

      <div class="fit-field fit-field--readback">
        <span class="fit-field-label mono">Readback</span>
        <p class="fit-status mono" id="fit-status" role="status" aria-live="polite"></p>

        <details class="fit-details">
          <summary>What the prompt includes</summary>
          <p>
            A structured fit evaluation request, your pasted job description, and a concise public profile
            (experience, portfolio projects, skills, logistics). Résumé and LinkedIn links are included.
            Nothing is sent to this site. Processing happens in the assistant you choose.
          </p>
        </details>
      </div>
    </div>
  </div>
</section>

<script id="fit-providers-data" type="application/json" set:html={providersJson} is:inline></script>
<script id="fit-profile-data" type="application/json" set:html={templateJson} is:inline></script>

<script is:inline>
  const PROMPT_PLACEHOLDER = '{{JOB_DESCRIPTION}}';
  const MAX_JOB_DESCRIPTION_LENGTH = 12_000;
  const MAX_PREFILL_URL_LENGTH = 7_500;

  function readJsonScript(id, fallback) {
    const block = document.getElementById(id);
    try {
      return JSON.parse(block?.textContent ?? fallback);
    } catch {
      return JSON.parse(fallback);
    }
  }

  const providers = readJsonScript('fit-providers-data', '[]');

  function validatedJobDescription() {
    const el = document.getElementById('job-description');
    if (!(el instanceof HTMLTextAreaElement)) return null;

    const value = el.value.trim();
    if (!value) {
      el.setAttribute('aria-invalid', 'true');
      el.focus();
      setStatus('Paste a job description before opening or copying a fit prompt.');
      return null;
    }
    if (value.length > MAX_JOB_DESCRIPTION_LENGTH) {
      el.setAttribute('aria-invalid', 'true');
      el.focus();
      setStatus('Job description must be 12,000 characters or fewer.');
      return null;
    }
    el.setAttribute('aria-invalid', 'false');
    return value;
  }

  function buildPrompt(jobDescription) {
    const template = readJsonScript('fit-profile-data', '""');
    return typeof template === 'string' ? template.replace(PROMPT_PLACEHOLDER, jobDescription) : '';
  }

  function setStatus(message) {
    const status = document.getElementById('fit-status');
    if (status) status.textContent = message;
  }

  async function copyPrompt(prompt) {
    try {
      await navigator.clipboard.writeText(prompt);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = prompt;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      // Avoid Document.execCommand typings (deprecated); keep legacy copy fallback.
      const legacyCopy = Reflect.get(document, 'execCommand');
      const ok = typeof legacyCopy === 'function' ? Boolean(legacyCopy.call(document, 'copy')) : false;
      document.body.removeChild(ta);
      return ok;
    }
  }

  async function launchProvider(providerId) {
    const provider = providers.find((p) => p.id === providerId);
    if (!provider) return;

    const jobDescription = validatedJobDescription();
    if (jobDescription === null) return;

    const prompt = buildPrompt(jobDescription);
    const encoded = encodeURIComponent(prompt);
    const copied = await copyPrompt(prompt);
    const prefillUrl = provider.prefix + encoded;
    const usesPrefill = prefillUrl.length <= MAX_PREFILL_URL_LENGTH;

    window.open(usesPrefill ? prefillUrl : provider.baseUrl, '_blank', 'noopener,noreferrer');

    setStatus(
      usesPrefill
        ? copied
          ? `Copied prompt. Opened ${provider.label}. Paste if the assistant did not pre-fill.`
          : `Opened ${provider.label}. Copy the prompt manually if needed.`
        : copied
          ? `Copied prompt. Opened ${provider.label} without pre-fill because the prompt is too long for a safe URL. Paste it there.`
          : `Opened ${provider.label} without pre-fill. Copy the prompt manually if needed.`,
    );
  }

  document.querySelectorAll('.fit-ai-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-provider');
      if (id) launchProvider(id);
    });
  });

  document.getElementById('fit-copy-prompt')?.addEventListener('click', async () => {
    const jobDescription = validatedJobDescription();
    if (jobDescription === null) return;
    const prompt = buildPrompt(jobDescription);
    const copied = await copyPrompt(prompt);
    setStatus(copied ? 'Prompt copied to clipboard.' : 'Could not copy. Select and copy manually from the job description area.');
  });

  document.getElementById('job-description')?.addEventListener('input', () => {
    const el = document.getElementById('job-description');
    if (el instanceof HTMLTextAreaElement && el.value.trim() && el.value.length <= MAX_JOB_DESCRIPTION_LENGTH) {
      el.setAttribute('aria-invalid', 'false');
    }
  });
</script>

<style>
  .fit-check {
    background: var(--card);
    border-bottom: 1px solid var(--ink);
    padding: 72px 0;
  }
  .fit-check-wrap {
    display: grid;
    gap: 28px;
    max-width: 920px;
  }
  .fit-check-header {
    max-width: 760px;
  }
  .fit-check-title {
    margin-bottom: 12px;
  }
  .fit-form {
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 28px;
  }
  .fit-form--deposition {
    position: relative;
    overflow: hidden;
  }
  .fit-form--deposition::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(21, 21, 21, 0.14) 0.55px, transparent 0.65px);
    background-size: 6px 6px;
    opacity: 0.06;
  }
  .fit-field {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--rule);
    padding-top: 20px;
    margin-top: 20px;
  }
  .fit-field:first-child {
    border-top: 0;
    margin-top: 0;
    padding-top: 0;
  }
  .fit-field-label {
    display: block;
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 0.58rem;
  }
  .fit-lead {
    max-width: 720px;
    color: var(--muted);
    margin: 0;
    font-size: 1.02rem;
  }
  .fit-label {
    display: block;
    font-weight: 650;
    margin-bottom: 10px;
    font-size: 0.88rem;
  }
  .fit-textarea {
    width: 100%;
    max-width: none;
    min-height: 180px;
    padding: 16px 18px;
    border: 1px solid var(--ink);
    background: rgba(243, 239, 229, 0.92);
    color: var(--ink);
    font-family: "Plus Jakarta Sans Variable", system-ui, sans-serif;
    font-size: 0.95rem;
    line-height: 1.55;
    resize: vertical;
  }
  .fit-textarea:focus {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  .fit-textarea[aria-invalid='true'] {
    border-color: #b42318;
  }
  .fit-input-hint {
    color: var(--muted);
    font-size: 0.76rem;
    margin: 8px 0 0;
  }
  .fit-textarea::placeholder {
    color: var(--muted);
  }
  .fit-hint {
    color: var(--muted);
    margin: 0 0 14px;
    font-size: 0.88rem;
  }
  .fit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: none;
  }
  .fit-ai-btn,
  .fit-copy-btn {
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-size: 0.8rem;
    min-height: 40px;
    padding: 8px 14px;
    border-radius: 999px;
    transition: background 0.15s, border-color 0.15s;
  }
  .fit-ai-btn:hover,
  .fit-copy-btn:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .fit-copy-btn {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }
  .fit-copy-btn:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }
  .fit-field--readback .fit-status {
    min-height: 1.2em;
    margin-top: 0;
  }
  .fit-status {
    min-height: 1.2em;
    margin-top: 16px;
    color: var(--blue);
    font-family: "DM Mono", monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .fit-details {
    margin-top: 18px;
    max-width: 720px;
    font-size: 0.88rem;
    color: var(--muted);
    border-top: 1px solid var(--rule);
    padding-top: 16px;
  }
  .fit-details summary {
    cursor: pointer;
    font-weight: 650;
    color: var(--ink);
    margin-bottom: 8px;
  }
  #fit-profile-data,
  #fit-providers-data {
    display: none;
  }
  @media (max-width: 560px) {
    .fit-check {
      padding: 52px 0;
    }
    .fit-form {
      padding: 20px;
    }
    .fit-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .fit-ai-btn,
    .fit-copy-btn {
      width: 100%;
      justify-content: center;
    }
    .fit-check-title {
      font-size: clamp(1.75rem, 7.5vw, 2.35rem);
    }
  }
</style>
