---
type Props = {
  backHref?: string;
  backLabel?: string;
  context: string;
};

const { backHref = '/', backLabel = 'Home', context } = Astro.props;
const currentPath = Astro.url.pathname;
const navItems = [
  ['/work/', 'Work'],
  ['/experience/', 'Experience'],
  ['/about/', 'About'],
  ['/fit/', 'Deployment approach'],
] as const;
---

<header class="page-mast" data-secondary-masthead>
  <div class="wrap mast-row">
    <a class="back-link mono" href={backHref}>← {backLabel}</a>
    <nav class="mast-nav" aria-label="Site navigation">
      {navItems.map(([href, label]) => (
        <a href={href} aria-current={currentPath.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <span class="mast-context mono">{context}</span>
  </div>
</header>

<style>
  .mast-row {
    display:grid;
    grid-template-columns:auto minmax(0,1fr) auto;
    align-items:center;
    gap:20px;
  }
  .mast-nav {
    min-width:0;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:clamp(12px,2vw,28px);
  }
  .mast-nav a {
    min-height:44px;
    display:inline-flex;
    align-items:center;
    color:var(--muted);
    font-size:.74rem;
    white-space:nowrap;
  }
  .mast-nav a:hover,
  .mast-nav a[aria-current='page'] {
    color:var(--ink);
    text-decoration:underline;
    text-underline-offset:5px;
  }
  @media(max-width:760px) {
    .mast-row { grid-template-columns:auto minmax(0,1fr); gap:12px; }
    .mast-context { display:none; }
    .mast-nav { justify-content:flex-end; gap:12px; }
    .mast-nav a:nth-child(3),
    .mast-nav a:nth-child(4) { display:none; }
  }
</style>
