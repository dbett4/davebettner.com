---
const { headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const products = [
  { id: 'passal', name: 'Passal', description: 'Study choices and practice tied to lecture sources.', contribution: 'I design and build the workflow from lecture material to practice, helping students decide what to study next.', href: 'https://passal.app/', domain: 'passal.app', desktop: [1440, 1667], mobile: [780, 5398], alt: 'Passal exam preparation with quiz, course, and review actions.' },
  { id: 'leasekite', name: 'Leasekite', description: 'Vehicle comparison and lease requests.', contribution: 'I design and build the comparison and request flows. Drafts remain available for review, with negotiation decisions kept with the user.', desktop: [1440, 2076], mobile: [390, 2767], alt: 'Leasekite vehicle comparison interface with lease search options.' },
  { id: 'krowbar', name: 'Krowbar', description: 'A project workspace that helps people and AI assistants pick up work without rebuilding its context. The first integration supports Workiva reporting.', contribution: 'I own product direction, interface design, and implementation through AI coding tools. My reporting-delivery experience shaped the review workflow: proposed changes show their expected results before they run, with a record of what happened and a way to undo them.', href: 'https://krowbar.app/', detail: '/work/krowbar/', domain: 'Interactive demo', extension: 'png', desktop: [1440, 900], mobile: [375, 900], alt: 'Krowbar demo workspace with fictional reporting engagements and work awaiting review.' },
  { id: 'lockfield', name: 'Lockfield', description: 'A Workiva consulting practice built around training and client ownership.', contribution: 'I shaped the positioning, website, and reporting resources, translating reporting expertise into a service offering and supporting materials.', href: 'https://lockfield.co/', domain: 'lockfield.co', desktop: [1440, 1000], mobile: [390, 844], alt: 'Lockfield website introducing its Workiva consulting practice.' },
];
---
<article class="featured-homebase">
  <div class="featured-copy">
    <Heading><a href="/work/homebase/">Homebase</a></Heading>
    <p class="featured-summary">An operating workspace for a founder running five businesses.</p>
    <p>My main project. Each business has its own clients, deadlines, and delivery requirements. I’m building a shared workspace for client records, projects, content, and agent assignments, designed to keep drafts, owner approvals, and delivery records distinct.</p>
    <p class="featured-scope">Private application in active development. Agent execution and external integrations are still being developed. Preview uses fictional work.</p>
    <a class="featured-link" href="/work/homebase/">Read the Homebase case study</a>
  </div>
  <a class="featured-screen" href="/work/homebase/" aria-label="Explore Homebase, a private business operating workspace">
    <picture>
      <source media="(max-width: 700px)" srcset="/images/selected-work/homebase-mobile.webp" width="780" height="1800" />
      <img src="/images/selected-work/homebase-desktop.webp" alt="Homebase Work view in a sandbox with fictional projects, owners, and review steps." width="1440" height="1000" loading="lazy" decoding="async" />
    </picture>
  </a>
</article>
<div class="selected-products">
  {products.map(product => {
    const Preview = product.href ? 'a' : 'div';
    return <article class={`selected-product selected-product-${product.id}`}>
    <div class="product-copy">
      <div class="product-heading">
        <Heading>{product.href ? <a href={product.detail || product.href}>{product.name}</a> : product.name}</Heading>
        {product.href ? <a class="product-link" href={product.href} aria-label={`Visit ${product.name}`}>{product.domain}</a> : <span class="product-status">Work in progress</span>}
      </div>
      <p>{product.description}</p>
      <p class="product-contribution">{product.contribution}</p>
    </div>
    <Preview class="product-screen" href={product.href} aria-label={product.href ? `Open ${product.name} site` : undefined}>
      <picture>
        <source media="(max-width: 700px)" srcset={`/images/selected-work/${product.id}-mobile.${product.extension || 'webp'}`} width={product.mobile[0]} height={product.mobile[1]} />
        <img src={`/images/selected-work/${product.id}-desktop.${product.extension || 'webp'}`} alt={product.alt} width={product.desktop[0]} height={product.desktop[1]} loading="lazy" decoding="async" />
      </picture>
    </Preview>
  </article>; })}
</div>
<style>
  .featured-homebase { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 40px; align-items: center; margin-top: 28px; padding-block: 0 36px; border-bottom: 1px solid var(--border); }
  .featured-copy h2, .featured-copy h3 { margin: 0; font-size: 28px; line-height: 1.3; letter-spacing: -.025em; }
  .featured-copy h2 a, .featured-copy h3 a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .featured-copy h2 a:hover, .featured-copy h3 a:hover { text-decoration: underline; }
  .featured-copy p { margin-top: 14px; color: var(--secondary); font-size: 15px; line-height: 1.75; }
  .featured-copy .featured-summary { margin-top: 8px; color: var(--text); font-size: 20px; line-height: 1.5; letter-spacing: -.015em; }
  .featured-copy .featured-scope { font-size: 13px; }
  .featured-link { display: inline-flex; min-height: 44px; align-items: center; margin-top: 12px; font-size: 14px; }
  .featured-screen { display: block; overflow: hidden; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  .featured-screen img { width: 100%; height: auto; }
  @media (max-width: 700px) {
    .featured-homebase { grid-template-columns: 1fr; gap: 20px; margin-top: 22px; padding-bottom: 30px; }
    .featured-copy h2, .featured-copy h3 { font-size: 26px; }
  }
  .selected-products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 28px; margin-top: 28px; }
  .selected-product { display: flex; flex-direction: column; min-width: 0; }
  .product-screen { display: block; order: -1; aspect-ratio: 1.6; overflow: hidden; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  picture { display: block; width: 100%; height: 100%; }
  .product-screen img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 220ms cubic-bezier(.16, 1, .3, 1); }
  @media (hover: hover) and (pointer: fine) {
    a.product-screen:hover img { transform: scale(1.015); }
  }
  a.product-screen:active img { transform: scale(.97); }
  .product-copy { padding-top: 14px; }
  .product-heading { display: flex; min-height: 44px; justify-content: space-between; align-items: center; gap: 10px; }
  .product-copy h2, .product-copy h3 { margin: 0; font-size: 20px; font-weight: 650; line-height: 1.3; letter-spacing: -.02em; }
  .product-copy h2 a, .product-copy h3 a { display: inline-flex; align-items: center; min-height: 44px; }
  .product-copy h2 a, .product-copy h3 a { text-decoration: none; }
  .product-copy h2 a:hover, .product-copy h3 a:hover { text-decoration: underline; }
  .product-copy p { margin: 4px 0 0; max-width: 460px; color: var(--secondary); font-size: 15px; line-height: 1.7; }
  .product-copy .product-contribution { margin-top: 10px; }
  .product-link, .product-status { display: inline-flex; align-items: center; min-height: 44px; flex-shrink: 0; font-size: 12px; }
  .product-status { color: var(--secondary); }
  @media (min-width: 701px) {
    .selected-product-lockfield, .selected-product-krowbar { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: 48px; align-items: center; padding-top: 32px; border-top: 1px solid var(--border); }
    .selected-product-lockfield .product-copy, .selected-product-krowbar .product-copy { padding-top: 0; }
    .selected-product-lockfield .product-screen, .selected-product-krowbar .product-screen { order: 0; }
    .selected-product-krowbar { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
  }
  @media (min-width: 701px) and (max-width: 900px) {
    .selected-products { gap: 18px; }
    .product-heading { align-items: flex-start; flex-direction: column; gap: 0; }
    .product-link, .product-status { min-height: 32px; }
    .product-copy h2 a, .product-copy h3 a { min-height: 32px; }
  }
  @media (max-width: 700px) {
    .selected-products { grid-template-columns: 1fr; gap: 30px; margin-top: 22px; }
    .product-screen { order: 0; aspect-ratio: .85; }
    .product-copy { padding-top: 0; padding-bottom: 12px; }
    .product-copy p { max-width: none; }
    .selected-product-passal img { object-position: center 10%; }
    .selected-product-leasekite .product-screen { aspect-ratio: .6; }
    .selected-product-leasekite img { object-position: center 46.4%; }
    .selected-product-krowbar .product-screen { aspect-ratio: 375 / 900; }
  }
</style>
