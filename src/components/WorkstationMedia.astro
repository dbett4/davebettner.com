<div class="workstation-unit" data-workstation>
  <div class="workstation-media">
    <img class="scene-render" src="/images/workstation-seated-poster.webp" alt="Dave seated at his dual-monitor desk, using a mouse beside a light spreadsheet and a dark coding-agent workspace, with his dog resting on the rug." width="1000" height="1000" fetchpriority="high" decoding="async" />
    <video class="workstation-video" data-src="/video/workstation-seated.mp4" muted playsinline preload="none" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
  </div>
</div>
<style>
  .workstation-unit { position: relative; width: 100%; }
  .workstation-media { position: relative; width: 100%; aspect-ratio: 1; }
  .scene-render { display: block; width: 100%; height: auto; }
  .workstation-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; visibility: hidden; pointer-events: none; }
  [data-video-visible='true'] .workstation-video { visibility: visible; }

</style>
<script>
  // One quiet sequence under five seconds; no controls or looping.
  // Play this finite sequence regardless of the OS motion preference.
  // No video is requested until the scene is visible.
  // The matching poster remains underneath during loading, errors and JS failure.
  document.querySelectorAll<HTMLElement>('[data-workstation]').forEach(root => {
    if (root.dataset.motionInitialized) return;
    root.dataset.motionInitialized = 'true';
    const video = root.querySelector<HTMLVideoElement>('video')!;

    let visible = false, complete = false, failed = false, attempting = false;
    video.muted = true;
    const allowed = () => visible && !document.hidden && !failed;
    const ui = () => {
      const active = !video.paused && allowed() && !complete;
      root.dataset.motionActive = String(active);
      root.dataset.motionComplete = String(complete);

    };
    const sync = () => {

      if (!allowed() || complete) { video.pause(); ui(); return; }
      if (!video.src) video.src = video.dataset.src!;
      if (attempting || !video.paused) { ui(); return; }
      attempting = true;
      video.play().then(() => {
        // A viewport or page-visibility change may race play().
        if (!allowed() || complete) video.pause();
      }).catch(error => {
        if (error.name !== 'AbortError') { failed = true; root.dataset.videoVisible = 'false'; }
      }).finally(() => { attempting = false; ui(); });
    };
    video.addEventListener('playing', () => {
      if (!allowed() || complete) { video.pause(); return; }
      root.dataset.videoVisible = 'true'; ui();
    });
    video.addEventListener('pause', ui);
    video.addEventListener('ended', () => { complete = true; ui(); });
    video.addEventListener('error', () => { failed = true; root.dataset.videoVisible = 'false'; video.pause(); ui(); });
    const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }, {threshold: .05});
    observer.observe(root);

    document.addEventListener('visibilitychange', sync);
    root.dataset.motionComplete = 'false';
    sync();
  });
</script>
