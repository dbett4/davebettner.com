---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/profile.css';
import { siteDescription, siteTitle, personSchema } from '../data/seo';
const {title=siteTitle, description=siteDescription, page='home'}=Astro.props;
const canonical=`https://davebettner.com${Astro.url.pathname}`;
const nav=[['experience','Experience','/experience/'],['work','Projects','/work/'],['fit','Approach','/fit/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content="noindex, nofollow"/><meta name="theme-color" content="#101416"/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><meta property="og:type" content="profile"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://davebettner.com/images/dave-bettner-profile-social.jpg"/><meta property="og:image:alt" content="Dave Bettner — Financial systems consulting"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content="https://davebettner.com/images/dave-bettner-profile-social.jpg"/><script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}/></head><body><a class="skip" href="#main">Skip to content</a><header class="masthead wrap"><a class="brand" href="/" aria-label="Dave Bettner home">Dave Bettner</a><nav aria-label="Main navigation">{nav.map(([id,label,url])=><a href={url} aria-current={page===id?'page':undefined}>{label}</a>)}</nav><a class="header-email" href="mailto:dbett4@gmail.com">Email Dave</a></header><main id="main"><slot/></main><footer class="footer wrap"><div><a class="brand" href="/">Dave Bettner</a><p>Des Moines, Iowa</p></div><nav aria-label="Further information"><a href="/about/">About</a><a href="/dave-bettner-resume.pdf">Résumé</a><a href="https://github.com/dbett4">GitHub</a><a href="https://www.linkedin.com/in/dave-bettner/">LinkedIn</a><a href="mailto:dbett4@gmail.com">Email</a></nav></footer></body></html>
