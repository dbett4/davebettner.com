---
import '../styles/theme.css';
import '../styles/profile.css';

import { siteDescription, siteTitle, siteUrl, personSchema, websiteSchema, createPageSchema } from '../data/seo';
const {title=siteTitle, description=siteDescription, page='home', footerMessage}=Astro.props;
const canonical=new URL(Astro.url.pathname, siteUrl).href;
const isProfilePage=page === 'about';
const pageSchema=createPageSchema({ title, description, url: canonical, isProfile: isProfilePage });
const structuredData={ '@context': 'https://schema.org', '@graph': [personSchema, websiteSchema, pageSchema] };
const nav=[['work','Projects','/work/'],['fit','Approach','/fit/'],['experience','Experience','/experience/'],['about','About','/about/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Dave Bettner" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:type" content={isProfilePage ? 'profile' : 'website'} />
    <meta property="og:site_name" content="Dave Bettner" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://davebettner.com/images/dave-bettner-profile-social.jpg" />
    <meta property="og:image:alt" content="Dave Bettner" />
    {isProfilePage && <>
      <meta property="profile:first_name" content="Dave" />
      <meta property="profile:last_name" content="Bettner" />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://davebettner.com/images/dave-bettner-profile-social.jpg" />
    <meta name="twitter:image:alt" content="Dave Bettner" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead wrap">
      <a class="brand masthead-brand" href="/" aria-label="Dave Bettner home"><img src="/images/dave-bettner-headshot-20260808-square.webp" alt="" width="32" height="32" decoding="async" /><span>Dave Bettner</span></a>
      <nav aria-label="Main navigation">
        {nav.map(([id, label, url]) => <a href={url} aria-current={page === id ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-tools">

        <a class="header-email" href="mailto:dbett4@gmail.com">Email Dave</a>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="footer wrap">
      <div class="footer-copy">
        {footerMessage && <><h2>{footerMessage.title}</h2><p>{footerMessage.body}</p><a class="contact-email" href="mailto:dbett4@gmail.com" aria-label="Get in touch">dbett4@gmail.com</a></>}
        <a class="brand" href="/">Dave Bettner</a><p>Des Moines, Iowa</p>
      </div>
      <nav aria-label="Further information">
        <a href="/about/">About</a>
        <a href="/dave-bettner-resume.pdf">Résumé</a>
        <a href="https://github.com/dbett4">GitHub</a>
        <a href="https://www.linkedin.com/in/dave-bettner/">LinkedIn</a>
        {!footerMessage && <a href="mailto:dbett4@gmail.com">Email</a>}
      </nav>
    </footer>
  </body>
</html>
