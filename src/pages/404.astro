---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/dm-mono/400.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

const title = 'Page not found | Dave Bettner';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#F5F2EA" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/working-record.css" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <section class="section not-found" aria-labelledby="not-found-heading">
        <div class="wrap">
          <p class="eyebrow mono">404 / Page not found</p>
          <h1 id="not-found-heading">This address does not match a page.</h1>
          <p class="lead">Return home to browse Dave’s work and experience.</p>
          <a class="action action-primary" href="/">Return home <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .not-found {
    min-height: calc(100vh - 65px);
    display: flex;
    align-items: center;
  }

  .not-found .action {
    margin-top: var(--space-3);
  }
</style>
