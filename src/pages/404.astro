---
const title = 'Page not found | Dave Bettner';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="stylesheet" href="/styles/editorial-paper-system.css" />
    <link rel="stylesheet" href="/styles/interstellar-system.css" />
    <title>{title}</title>
    <style>
      *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;font-family:system-ui,sans-serif;background:var(--paper);color:var(--ink)}main{width:min(720px,100%);border:1px solid;padding:clamp(32px,8vw,72px);box-shadow:10px 10px 0 var(--orange)}p:first-child{font:700 .75rem/1.4 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--blue)}h1{font:400 clamp(4rem,14vw,8rem)/1.11 Georgia,serif;letter-spacing:-.04em;margin:.3em 0}p{max-width:48ch;line-height:1.6}a{display:inline-flex;min-height:44px;align-items:center;margin-top:18px;border:1px solid;border-radius:999px;padding:12px 18px;color:inherit;text-decoration:none;font-weight:700}@media(hover:hover){a:hover{background:var(--ink);color:var(--paper)}}
    </style>
  </head>
  <body><main><p>404 / Off the map</p><h1>Nothing lives here.</h1><p>The work is real. This address is not.</p><a href="/">Return home →</a></main><script is:inline type="module" src="/interstellar.js"></script></body>
</html>
