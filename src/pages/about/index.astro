---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import { aboutSection } from '../../data/homepage-framing';
import { identitySeoLead, personSchema, siteUrl } from '../../data/seo';
import { emailHref, githubUrl, linkedinUrl } from '../../data/site-links';

const canonical = `${siteUrl}/about/`;
const title = 'About Dave Bettner | AI Implementation and Strategic Operations';
const description =
  'Dave Bettner builds agent workflows and business systems for complicated enterprise work.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="wrap content-page">
      <a class="back-link mono" href="/">← Home</a>
      <p class="eyebrow mono">About</p>
      <h1>About Dave Bettner</h1>
      <p class="lead">{identitySeoLead}</p>

      <div class="prose">
        {aboutSection.body.map((paragraph) => <p>{paragraph}</p>)}
        <p>
          I work on AI implementation, business systems, workflow automation, and reporting technology.
          The part I enjoy most is turning a complicated idea into something a team can actually operate.
        </p>
      </div>

      <nav class="page-links" aria-label="Related pages">
        <a href="/work/">Selected work and case studies</a>
        <a href="/experience/">Career timeline</a>
        <a href={githubUrl} rel="me">GitHub</a>
        <a href={linkedinUrl} rel="me">LinkedIn</a>
        <a href={emailHref}>Email</a>
      </nav>
    </main>
  </body>
</html>

<style is:global>
  :root{--paper:#f3efe5;--ink:#151515;--blue:#214fe5;--muted:#62615d;--max:1320px}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:"Plus Jakarta Sans Variable",system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.55}
  a{color:inherit}
  .skip-link{position:absolute;left:-9999px}
  .skip-link:focus{left:16px;top:16px;z-index:9;background:#fff;padding:8px 12px}
  .content-page{padding:clamp(32px,6vw,72px) 24px 80px;max-width:760px;margin:0 auto}
  .mono{font-family:"DM Mono",ui-monospace,monospace;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
  .back-link{display:inline-block;margin-bottom:24px;color:var(--muted)}
  .eyebrow{color:var(--muted);margin-bottom:12px}
  h1{font-family:"Newsreader Variable",Georgia,serif;font-size:clamp(2rem,4vw,2.8rem);line-height:1.1;margin-bottom:16px}
  .lead{font-size:1.15rem;margin-bottom:28px}
  .prose p{margin-bottom:1rem;color:var(--ink)}
  .page-links{display:flex;flex-wrap:wrap;gap:12px 20px;margin-top:36px;padding-top:24px;border-top:1px solid #c9c3b5}
  .page-links a{text-decoration:underline;text-underline-offset:3px}
</style>
