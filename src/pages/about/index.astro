---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/dm-mono/400.css';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { aboutSection } from '../../data/homepage-framing';
import { ogImagePath, personSchema, siteUrl } from '../../data/seo';
import { emailHref } from '../../data/site-links';

const canonical = `${siteUrl}/about/`;
const title = 'About | Dave Bettner';
const description = 'Dave Bettner’s working method and the personal throughline behind his customer-facing delivery.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F5F2EA" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/working-record.css" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImagePath}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <section class="section" aria-labelledby="about-heading">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow mono">About</p>
            <h1 id="about-heading">{aboutSection.title}</h1>
            <p class="lead">{aboutSection.intro}</p>
            <div class="hero-actions">
              <a class="action action-primary" href={emailHref}>Email Dave</a>
              <a class="quiet-link" href="/experience/">Career timeline <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <figure class="hero-portrait">
            <img
              src="/images/dave-bettner-headshot-portrait.webp"
              alt="Dave Bettner smiling in a gray suit"
              width="1200"
              height="1200"
            />
          </figure>
        </div>
      </section>

      <section class="section" aria-labelledby="throughline-heading">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow mono">The throughline</p>
            <h2 id="throughline-heading">Why I stay close to the people using the system</h2>
          </div>
          <div class="about-prose">
            {aboutSection.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="method-heading">
        <div class="wrap">
          <p class="eyebrow mono">Working method</p>
          <h2 id="method-heading">{aboutSection.method.title}</h2>
          <p class="lead">{aboutSection.method.body}</p>
          <nav class="footer-nav related-nav" aria-label="Related pages">
            <a href="/work/">Work and case studies <span aria-hidden="true">→</span></a>
            <a href="/experience/">Career timeline <span aria-hidden="true">→</span></a>
            <a href="/fit/">First 90 days <span aria-hidden="true">→</span></a>
          </nav>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .about-prose {
    max-width: 62ch;
    display: grid;
    gap: var(--space-3);
  }

  .related-nav {
    margin-top: var(--space-3);
  }
</style>
