---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import { aboutSection } from '../../data/homepage-framing';
import { personSchema, siteUrl } from '../../data/seo';
import { emailHref, githubUrl, linkedinUrl } from '../../data/site-links';

const canonical = `${siteUrl}/about/`;
const title = 'About Dave Bettner | Enterprise Agent Deployment and Solutions Engineering';
const description =
  'Dave Bettner leads enterprise solution delivery for agent workflows and customer deployments, with domain depth in finance and regulated work.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="page-mast">
      <div class="wrap mast-row">
        <a class="back-link mono" href="/">← Home</a>
        <span class="mast-status mono">Operator profile</span>
      </div>
    </header>
    <main id="main">
      <section class="about-cover">
        <div class="wrap about-cover-grid">
          <div class="about-intro">
            <p class="eyebrow mono">About Dave Bettner</p>
            <h1>Customer context, engineering rigor, and a path to adoption.</h1>
            <p class="cover-lead">Enterprise solutions are useful only when the deployment holds from first decision through handoff.</p>
            <p class="cover-actions">
              <a class="round blue" href={emailHref}>Start a conversation <span aria-hidden="true">↗</span></a>
              <a class="round" href="/experience/">Career timeline <span aria-hidden="true">→</span></a>
            </p>
          </div>
          <figure class="portrait-plate">
            <span class="portrait-chrome mono">PROFILE · DES MOINES, IA</span>
            <img src="/images/dave-bettner-headshot-portrait.webp" alt="Dave Bettner smiling in a gray suit" width="1280" height="1600" />
            <figcaption class="mono">Discovery → integration → proof → adoption</figcaption>
          </figure>
        </div>
      </section>

      <section class="principles-section" aria-labelledby="principles-heading">
        <div class="wrap content-page">
          <div class="section-head">
            <p class="eyebrow mono">Operating principles</p>
            <h2 id="principles-heading">What survives contact with a customer.</h2>
          </div>
          <ol class="principles">
            <li><span class="principle-mark principle-mark--square" aria-hidden="true"></span><div><p class="mono">01 · Visible permissions</p><strong>Clear permissions</strong><span>Systems should make authority and scope explicit.</span></div></li>
            <li><span class="principle-mark principle-mark--circle" aria-hidden="true"></span><div><p class="mono">02 · Observable operation</p><strong>Visible failures</strong><span>Failure states should be readable before they become expensive.</span></div></li>
            <li><span class="principle-mark principle-mark--diamond" aria-hidden="true"></span><div><p class="mono">03 · Proof + recovery</p><strong>Reliable readback and a recovery path</strong><span>Changes need evidence, and operators need a route back when a path breaks.</span></div></li>
          </ol>
        </div>
      </section>

      <section class="narrative-section">
        <div class="wrap narrative-grid">
          <div class="section-head">
            <p class="eyebrow mono">The throughline</p>
            <h2>One operating pattern across regulated work and agent systems.</h2>
          </div>
          <div class="prose">
            {aboutSection.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="next-section">
        <div class="wrap next-grid">
          <p class="eyebrow mono">Continue</p>
          <h2>Follow the evidence.</h2>
          <nav class="page-links" aria-label="Related pages">
            <a href="/work/">Public engineering proof <span aria-hidden="true">→</span></a>
            <a href="/experience/">Career timeline <span aria-hidden="true">→</span></a>
            <a href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
            <a href={linkedinUrl} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
            <a href={emailHref}>Email <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root{--paper:#f3efe5;--ink:#151515;--blue:#214fe5;--orange:#cf4120;--orange-ink:#9a2f14;--muted:#62615d;--rule:#c9c3b5;--card:#eee8dc;--max:1280px}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:"Plus Jakarta Sans Variable",system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.52}
  a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  .skip-link{position:fixed;left:16px;top:16px;z-index:1000;background:var(--ink);color:var(--paper);padding:12px 16px;transform:translateY(-200%)}.skip-link:focus{transform:none}
  .wrap{width:min(var(--max),calc(100% - 48px));margin-inline:auto}.content-page{padding:clamp(48px,6vw,88px) 0}
  .mono{font-family:"DM Mono",ui-monospace,monospace;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}
  .page-mast{position:sticky;top:0;z-index:10;background:var(--paper);border-bottom:1px solid var(--ink)}.mast-row{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px}.back-link{min-height:44px;display:inline-flex;align-items:center;color:var(--muted)}.mast-status{color:var(--muted)}
  .about-cover{border-bottom:1px solid var(--ink);background:linear-gradient(90deg,transparent 79px,rgba(201,195,181,.32) 79px 80px,transparent 80px),var(--paper)}.about-cover-grid{padding:clamp(40px,6vw,88px) 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.68fr);gap:clamp(28px,5vw,72px);align-items:center}
  .eyebrow{color:var(--orange-ink);margin-bottom:14px}h1,h2{font-family:"Newsreader Variable",Georgia,serif;font-weight:500;letter-spacing:-.04em;line-height:1.04}h1{max-width:16ch;font-size:clamp(2.5rem,5vw,4.5rem)}h2{font-size:clamp(1.9rem,3.4vw,2.9rem)}.cover-lead{max-width:48ch;margin-top:20px;color:var(--muted);font-size:1.03rem}.cover-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}.round{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--ink);font-size:.8rem;font-weight:650;transition:background .2s,color .2s,border-color .2s}.round.blue{background:var(--blue);color:#fff;border-color:var(--blue)}.round:hover,.round:focus-visible{background:var(--ink);color:var(--paper);border-color:var(--ink)}.round.blue:hover,.round.blue:focus-visible{background:var(--orange);border-color:var(--orange);color:#fff}
  .portrait-plate{position:relative;margin:0;border:1px solid var(--ink);background:var(--ink);padding:12px;overflow:hidden}.portrait-plate::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 8px,rgba(33,79,229,.22) 8px 9px);pointer-events:none}.portrait-plate img{display:block;position:relative;width:100%;height:auto;filter:grayscale(1) contrast(1.06)}.portrait-chrome,.portrait-plate figcaption{position:absolute;z-index:2;background:var(--ink);color:var(--paper);padding:5px 6px;font-size:.58rem}.portrait-chrome{top:12px;left:12px}.portrait-plate figcaption{right:12px;bottom:12px;max-width:23ch;text-align:right}
  .principles-section{background:var(--card);border-bottom:1px solid var(--ink)}.section-head{display:grid;gap:10px;max-width:700px}.principles{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin-top:36px;border:1px solid var(--ink)}.principles li{min-width:0;padding:22px;display:grid;grid-template-columns:auto 1fr;gap:12px;border-right:1px solid var(--ink)}.principles li:last-child{border-right:0}.principle-mark{width:13px;height:13px;margin-top:3px;border:1px solid var(--ink)}.principle-mark--square{background:var(--blue);border-color:var(--blue)}.principle-mark--circle{border-radius:50%;background:var(--paper)}.principle-mark--diamond{transform:rotate(45deg);border-color:var(--orange)}.principles p{color:var(--orange-ink);font-size:.6rem;margin-bottom:7px}.principles strong{display:block;font-size:1rem;line-height:1.2}.principles span:not(.principle-mark){display:block;color:var(--muted);font-size:.82rem;line-height:1.45;margin-top:7px}
  .narrative-section{border-bottom:1px solid var(--ink)}.narrative-grid{padding:clamp(48px,6vw,88px) 0;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(28px,6vw,96px)}.prose{max-width:59ch}.prose p{font-size:1.02rem;margin-bottom:1.25rem}.prose p:last-child{margin-bottom:0}
  .next-section{background:var(--ink);color:var(--paper)}.next-grid{padding:clamp(40px,6vw,72px) 0;display:grid;gap:12px}.next-section .eyebrow{color:#c9c3b5}.page-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.page-links a{min-height:44px;display:inline-flex;align-items:center;padding:0 14px;border:1px solid #c9c3b5;font-size:.82rem}.page-links a:hover{background:var(--paper);color:var(--ink);border-color:var(--paper)}
  @media(max-width:700px){.wrap{width:min(100% - 28px,var(--max))}.mast-status{display:none}.about-cover-grid,.narrative-grid{grid-template-columns:1fr}.portrait-plate{max-width:360px}.principles{grid-template-columns:1fr}.principles li{border-right:0;border-bottom:1px solid var(--ink)}.principles li:last-child{border-bottom:0}}
  @media(prefers-reduced-motion:reduce){.round{transition:none}}
</style>
