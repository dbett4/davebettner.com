---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/dm-mono/400.css';
import SecondaryMasthead from '../../components/SecondaryMasthead.astro';
import { cvEntries } from '../../data/portfolio-entries';
import { siteUrl } from '../../data/seo';

const canonical = `${siteUrl}/experience/`;
const title = 'Experience | Dave Bettner — Customer Implementation Since 2015';
const description =
  'Dave Bettner’s dated career record across enterprise implementation, solutions architecture, healthcare integrations, and regulated reporting.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/interstellar-system.css" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SecondaryMasthead context="Experience · dated record" />
    <main id="main">
      <section class="work-cover route-intro">
        <div class="wrap">
          <p class="eyebrow mono">EXP · TIMELINE</p>
          <h1>Experience</h1>
          <p class="lead">A dated record of customer-facing enterprise implementation since 2015, including solutions and architecture roles across Ambra, Workiva, Citrin Cooperman, and LSL.</p>
        </div>
      </section>
      <div class="wrap content-page experience-record">

      <ol class="timeline">
        {cvEntries.map((entry) => (
          <li>
            <span class="timeline-mark" aria-hidden="true"></span>
            <p class="mono dates">{entry.dates}</p>
            <h2>{entry.title}</h2>
            {entry.location ? <p class="location">{entry.location}</p> : null}
            <p>{entry.line}</p>
            {entry.bullets?.length ? (
              <ul>
                {entry.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}
      </ol>

      <p class="pdf-note">
        <a href="/dave-bettner-resume.pdf" download data-shader-host><span data-shader-label>Download full résumé (PDF) <span aria-hidden="true">↓</span></span></a>
      </p>

      <nav class="page-links" aria-label="Related pages">
        <a href="/about/">About Dave Bettner</a>
        <a href="/work/">Selected work</a>
        <a href="/fit/">First 90 days</a>
        <a href="/#contact">Contact</a>
      </nav>
      </div>
    </main>
    <script is:inline type="module" src="/interstellar.js"></script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Archivo Variable', system-ui, sans-serif;
    background:
      radial-gradient(circle, rgba(33, 79, 229, 0.12) 0 1px, transparent 1.4px),
      var(--paper);
    background-size: 10px 10px;
    color: var(--ink);
    line-height: 1.55;
  }

  a {
    color: inherit;
  }

  .skip-link {
    position: fixed;
    left: 16px;
    top: 16px;
    z-index: 1000;
    background: #fff;
    padding: 8px 12px;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .wrap {
    width: min(100% - 32px, 760px);
    margin-inline: auto;
  }

  .page-mast {
    border-bottom: 1px solid var(--ink);
    background: rgba(243, 239, 229, 0.92);
  }

  .mast-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 52px;
  }

  .mono {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--ink);
  }

  .mast-utils {
    display: flex;
    gap: 16px;
    font-size: 0.8rem;
  }

  .mast-utils a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .content-page {
    padding: clamp(28px, 5vw, 64px) 0 80px;
  }

  .eyebrow {
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  h1 {
    font-family: 'Archivo Variable', system-ui, sans-serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .lead {
    margin-bottom: 36px;
    max-width: 58ch;
    color: var(--muted);
  }

  .timeline {
    list-style: none;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink);
  }

  .timeline > li {
    position: relative;
    padding: 22px 0 22px 28px;
    border-bottom: 1px solid var(--rule);
  }

  .timeline-mark {
    position: absolute;
    left: 0;
    top: 28px;
    width: 10px;
    height: 10px;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .timeline > li:nth-child(3n + 1) .timeline-mark {
    background: var(--blue);
    border-color: var(--blue);
  }

  .timeline > li:nth-child(3n + 2) .timeline-mark {
    transform: rotate(45deg);
    border-color: var(--orange);
  }

  .dates {
    color: var(--muted);
    margin-bottom: 8px;
  }

  .timeline h2 {
    font-size: 1.08rem;
    font-weight: 650;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .location {
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .timeline ul {
    margin: 10px 0 0 18px;
  }

  .timeline ul li {
    padding: 0;
    border: 0;
    margin-bottom: 6px;
  }

  .pdf-note {
    margin-top: 32px;
  }

  .pdf-note a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 16px;
    border: 1px solid var(--ink);
    font-size: 0.8rem;
    font-weight: 650;
    text-decoration: none;
  }

  .page-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
  }

  .page-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 520px) {
    .wrap {
      width: min(100% - 28px, 760px);
    }

    .timeline > li {
      padding-left: 22px;
    }
  }
</style>
