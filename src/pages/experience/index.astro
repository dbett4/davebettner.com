---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/dm-mono/400.css';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { cvEntries } from '../../data/portfolio-entries';
import { ogImagePath, siteUrl } from '../../data/seo';

const canonical = `${siteUrl}/experience/`;
const title = 'Experience | Dave Bettner';
const description =
  'Dave Bettner’s dated career record across enterprise implementation, solutions architecture, healthcare integrations, and regulated reporting since 2015.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F5F2EA" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/working-record.css" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImagePath}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <section class="section" aria-labelledby="experience-heading">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow mono">Experience</p>
            <h1 id="experience-heading">A dated record of customer-facing delivery since 2015.</h1>
            <p class="lead">
              Solutions and architecture roles across LSL, Citrin Cooperman, Workiva, and Ambra Health, ordered most
              recent first.
            </p>
          </div>

          <ol class="ruled-list">
            {cvEntries.map((entry) => (
              <li class="ruled-row evidence-row-grid">
                <div class="evidence-row-meta">
                  <p class="mono">{entry.dates}</p>
                  <h2>{entry.title}</h2>
                  {entry.location ? <p class="muted location-line">{entry.location}</p> : null}
                </div>
                <div class="evidence-row-body">
                  <p>{entry.line}</p>
                  {entry.bullets?.length ? (
                    <ul class="entry-bullets">
                      {entry.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  ) : null}
                </div>
              </li>
            ))}
          </ol>

          <p class="section-link">
            <a class="text-link" href="/dave-bettner-resume.pdf" download>Download full résumé (PDF) <span aria-hidden="true">↓</span></a>
          </p>

          <nav class="footer-nav related-nav" aria-label="Related pages">
            <a href="/about/">About Dave Bettner</a>
            <a href="/work/">Work and case studies</a>
            <a href="/fit/">First 90 days</a>
            <a href="/#contact">Contact</a>
          </nav>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .location-line {
    margin-top: 4px;
    font-size: 0.86rem;
  }

  .entry-bullets {
    margin-top: var(--space-2);
    display: grid;
    gap: 6px;
  }

  .entry-bullets li {
    padding-left: 1em;
    position: relative;
  }

  .entry-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--orange-dark);
  }

  .related-nav {
    margin-top: var(--space-4);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-3);
  }
</style>
