---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/dm-mono/400.css';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import jakartaFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import monoFont from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';
import { identity } from '../../data/portfolio-entries';
import { emailHref, githubUrl, linkedinUrl } from '../../data/site-links';

const siteUrl = 'https://davebettner.com';
const title = 'My first 90 days on an FDE team | Dave Bettner';
const description =
  'Dave Bettner\'s approach to forward-deployed engineering: learn the product and customer workflow, own a bounded integration, debug real failures, and feed the lessons back to the team.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={`${siteUrl}/fit/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/editorial-paper-system.css" />
    <link rel="stylesheet" href="/styles/interstellar-system.css" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="wrap fit-page-header">
      <a class="back-link mono" href="/">← Home</a>
      <a class="round blue" href={emailHref} data-shader-host>
        <span data-shader-label>Contact <span aria-hidden="true">↗</span></span>
      </a>
    </header>
    <main id="main">
      <section id="ninety-days" class="fit-check has-reg-marks" aria-labelledby="fit-check-heading">
        <div class="wrap fit-check-wrap">
          <div class="fit-check-header">
            <p class="mono fit-check-eyebrow">First 90 days on an FDE team</p>
            <h1 class="section-title fit-check-title" id="fit-check-heading">
              My first 90 days on an FDE team.
            </h1>
            <p class="fit-lead">
              I would learn the product and its deployment path, spend time with the people using it, own a bounded
              integration, and turn what breaks into better product feedback and a more repeatable deployment.
            </p>
          </div>

          <ol class="ninety-plan">
            <li>
              <span class="ninety-plan-mark mono">Weeks 1–2</span>
              <div>
                <strong>Learn the product and the work.</strong>
                <p>
                  Understand how the product is built, deployed, supported, and used. Pair with product,
                  engineering, and customer-facing teammates. Spend time with the customer workflow before drawing
                  conclusions. See my <a href="/experience/">experience</a>.
                </p>
              </div>
            </li>
            <li>
              <span class="ninety-plan-mark mono">Weeks 3–6</span>
              <div>
                <strong>Own a bounded deployment slice.</strong>
                <p>
                  Scope tools and access explicitly, default to guarded writes over broad ones, and make
                  authority legible from the start. This is the same pattern behind the guarded-default MCP
                  server and confirm-before-write tooling in my
                  {' '}<a href="/work/">selected engineering work</a>.
                </p>
              </div>
            </li>
            <li>
              <span class="ninety-plan-mark mono">Weeks 6–10</span>
              <div>
                <strong>Debug the hard path and feed back.</strong>
                <p>
                  Work through a real failure. Reproduce it, make the boundary clear, fix what belongs in the
                  implementation, and bring product gaps back to the team. A good deployment teaches us something.
                </p>
              </div>
            </li>
            <li>
              <span class="ninety-plan-mark mono">Weeks 10–13</span>
              <div>
                <strong>Make the next deployment easier.</strong>
                <p>
                  Turn what I learned into better tests, examples, integration guidance, or runbooks. Stay close
                  to adoption, and leave the team with a clearer product and a better path for the next customer.
                </p>
              </div>
            </li>
          </ol>

          <div class="fit-field fit-field--readback">
            <span class="fit-field-label mono">More</span>
            <nav class="page-links" aria-label="Related pages">
              <a href="/about/">About Dave Bettner</a>
              <a href="/experience/">Career timeline</a>
              <a href="/work/">Selected work</a>
              <a href={emailHref}>Start a conversation <span aria-hidden="true">↗</span></a>
            </nav>
          </div>
        </div>
      </section>
    </main>
    <footer class="wrap fit-page-footer">
      <span>{identity.location}</span>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
        <a href={linkedinUrl} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={emailHref}>Email <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
    <script is:inline type="module" src="/interstellar.js"></script>
  </body>
</html>

<style is:global>
  :root {
    --max: 920px;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    font-family: 'Archivo Variable', system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .mono {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .wrap {
    width: min(var(--max), calc(100% - 52px));
    margin-inline: auto;
  }
  .skip-link {
    position: fixed;
    left: 16px;
    top: 16px;
    z-index: 1000;
    background: var(--ink);
    color: var(--paper);
    padding: 12px 16px;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  .fit-page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--ink);
    max-width: 1320px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
  }
  .back-link:hover {
    color: var(--ink);
  }
  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--ink);
    border-radius: 0;
    min-height: 44px;
    padding: 10px 16px;
    font-size: 0.8rem;
    font-weight: 650;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .round.blue {
    background: var(--blue);
    color: #fff;
    border-color: var(--blue);
  }
  /* Hover states after every variant; each sets background and color together. */
  .round:hover,
  .round:focus-visible {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .round.blue:hover,
  .round.blue:focus-visible {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }
  .section-title {
    font-family: 'Newsreader Variable', Georgia, serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .fit-page-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 0 40px;
    font-size: 0.78rem;
    max-width: 1320px;
    gap: 20px;
    flex-wrap: wrap;
  }
  .footer-links {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  @media (max-width: 560px) {
    .wrap {
      width: min(100% - 28px, var(--max));
    }
    .fit-page-header {
      padding: 20px 0;
    }
  }
</style>

<style>
  .fit-check {
    background: var(--card);
    border-bottom: 1px solid var(--ink);
    padding: 72px 0;
  }
  .fit-check-wrap {
    display: grid;
    gap: 28px;
    max-width: 920px;
  }
  .fit-check-header {
    max-width: 760px;
  }
  .fit-check-eyebrow {
    color: var(--orange-ink, var(--muted));
    margin-bottom: 10px;
  }
  .fit-check-title {
    margin-bottom: 12px;
  }
  .fit-lead {
    max-width: 720px;
    color: var(--muted);
    margin: 0;
    font-size: 1.02rem;
  }
  .ninety-plan {
    list-style: none;
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .ninety-plan li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
    padding: 24px 28px;
    border-top: 1px solid var(--rule);
  }
  .ninety-plan li:first-child {
    border-top: 0;
  }
  .ninety-plan-mark {
    color: var(--muted);
    padding-top: 3px;
  }
  .ninety-plan strong {
    display: block;
    font-size: 1rem;
    margin-bottom: 8px;
  }
  .ninety-plan p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }
  .ninety-plan a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .fit-field {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--rule);
    padding-top: 20px;
    margin-top: 4px;
  }
  .fit-field-label {
    display: block;
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 0.58rem;
  }
  .page-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .page-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border: 1px solid var(--ink);
    font-size: 0.82rem;
  }
  .page-links a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 560px) {
    .fit-check {
      padding: 52px 0;
    }
    .ninety-plan li {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 20px;
    }
    .fit-check-title {
      font-size: clamp(1.75rem, 7.5vw, 2.35rem);
    }
  }
</style>
