---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/dm-mono/400.css';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { emailHref } from '../../data/site-links';
import { siteUrl } from '../../data/seo';

const title = 'How I would lead my first 90 days as an FDE | Dave Bettner';
const description =
  'Dave Bettner’s first-90-days approach to discovery, a bounded deployment, failure decisions, and reusable product feedback.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F5F2EA" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={`${siteUrl}/fit/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/working-record.css" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <section class="section" aria-labelledby="fit-heading">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow mono">First 90 days as an FDE</p>
            <h1 id="fit-heading">How I would lead my first 90 days as an FDE.</h1>
            <p class="lead fit-lead">
              I would learn the product and customer environment, choose one measurable workflow, lead its first
              deployment, and turn the failures and decisions into useful product feedback.
            </p>
          </div>

          <ol class="ruled-list ninety-plan">
            <li class="ruled-row evidence-row-grid">
              <div class="evidence-row-meta"><span class="mono">Weeks 1–2</span></div>
              <div class="evidence-row-body">
                <h2>Choose the first problem.</h2>
                <p>
                  Learn the product, deployment model, customer workflow, and current constraints. Pair with product,
                  engineering, and customer-facing teammates. Leave the first two weeks with a named owner, a success
                  measure, launch criteria, and the tradeoffs we will accept. See my <a class="text-link" href="/experience/">experience</a>.
                </p>
              </div>
            </li>
            <li class="ruled-row evidence-row-grid">
              <div class="evidence-row-meta"><span class="mono">Weeks 3–6</span></div>
              <div class="evidence-row-body">
                <h2>Own the first deployment.</h2>
                <p>
                  Lead one bounded workflow from technical approach through working integration. Coordinate the
                  customer, product, and engineering sides. Instrument the path, test its failure modes, and decide
                  what must be fixed before launch. See the <a class="text-link" href="/work/">public engineering work</a>.
                </p>
              </div>
            </li>
            <li class="ruled-row evidence-row-grid">
              <div class="evidence-row-meta"><span class="mono">Weeks 6–10</span></div>
              <div class="evidence-row-body">
                <h2>Lead through failure.</h2>
                <p>
                  When an integration or agent run breaks, separate configuration issues, product gaps, and
                  infrastructure problems. State the customer impact and decide whether to fix, narrow scope, work
                  around, or stop the launch.
                </p>
              </div>
            </li>
            <li class="ruled-row evidence-row-grid">
              <div class="evidence-row-meta"><span class="mono">Weeks 10–13</span></div>
              <div class="evidence-row-body">
                <h2>Make the next deployment easier.</h2>
                <p>
                  Convert what the deployment teaches into tests, telemetry, integration guidance, tooling, or
                  runbooks. Give product and engineering a prioritized record of recurring gaps and the customer
                  context behind them.
                </p>
              </div>
            </li>
          </ol>

          <nav class="footer-nav related-nav" aria-label="Related pages">
            <a href="/about/">About Dave Bettner</a>
            <a href="/experience/">Career timeline</a>
            <a href="/work/">Public engineering proof</a>
            <a href={emailHref}>Start a conversation <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .ninety-plan h2 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 650;
    margin-bottom: 6px;
  }

  .related-nav {
    margin-top: var(--space-4);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-3);
  }
</style>
