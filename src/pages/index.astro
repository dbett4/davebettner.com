---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import archivoFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoFont from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';
import EvidenceMotif from '../components/EvidenceMotif.astro';

import {
  buildingNow,
  closingCta,
  homeSynthesis,

  selectedProof,
  thesis,
} from '../data/homepage-framing';
import { identity } from '../data/portfolio-entries';
import { homepageProvenanceNote } from '../data/public-proof';
import {
  personSchema,
  siteDescription,
  siteTitle,
  siteUrl,
} from '../data/seo';
import { emailHref } from '../data/site-links';
import ContactLinks from '../components/ContactLinks.astro';

const roleByProjectId: Record<string, string> = {
  'regulated-reporting-mcp': 'Guarded access · readback · receipts',
  'hermes-field-kit': 'Policy · independent checks · human review',
  'agent-operating-system': 'Context · authority · recovery',
};


const outcomeMarks = ['outcome-mark--square', 'outcome-mark--circle', 'outcome-mark--diamond'] as const;

const featuredProjects = buildingNow.featuredProjects;


---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles/interstellar-system.css" />
    <link rel="stylesheet" href="/styles/sphere-gradient.css" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og-interstellar.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dave Bettner — forward-deployed delivery and AI-agent systems" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={`${siteUrl}/images/dave-bettner-og-interstellar.jpg`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{siteTitle}</title>
  </head>
  <body>
    <!--
      AUDIT-SEED: interstellar-tide-sphere-20260816
      THESIS: Dave stands in front of one sculptural Tide sphere; the site refuses cream editorial default, dashboard chrome, and literal sci-fi UI.
      OWN-WORLD: Near-black carbon ground, warm white type, tide teal #73bfc4, signal orange #ff810a, periwinkle #8da0ce, restrained graphite rules, and film grain. One shader system owns motion and depth across the site.
      STORY: Visitors identify Dave and his customer-facing deployment lane in seconds, then descend through outcomes, selected work, a short working synthesis, and contact without leaving the world.
      FIRST VIEWPORT: Monumental DAVE BETTNER left, concise role/support/actions below, exact source portrait large at right, full fluid shader field behind both, evidence beginning below fold.
      FORM: Tide Sphere, selected by Dave. Preserve semantic content and accessibility while translating the comp responsively.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap masthead">
        <a class="mast-brand" href="#top">
          <span class="mast-mark" aria-hidden="true"></span>
          <span class="mast-name">{identity.name}</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/work/">Work</a>
          <a href="/experience/">Experience</a>
          <a href="/fit/">First 90 days</a>
        </nav>
        <a class="mast-cta" href={emailHref}>Email <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section id="top" class="cover" aria-labelledby="thesis-heading">
        <div class="interstellar-field sphere-field" data-interstellar-field data-sphere-gradient aria-hidden="true"></div>
        <div id="thesis" class="wrap cover-grid">
          <div class="cover-copy">
            <p class="cover-kicker mono">Forward-deployed engineering · Agent systems</p>
            <h1 id="thesis-heading"><span>Dave</span><span>Bettner</span></h1>
            <p class="cover-role">{thesis.title}</p>
            <div class="cover-actions" aria-label="Candidate actions">
              <div class="cover-actions-primary">
                <a class="round blue" href={emailHref} data-primary-action data-shader-host><span class="action-label" data-shader-label>Start a conversation</span></a>
                <a class="round ghost" href="/dave-bettner-resume.pdf" download><span class="action-label">Résumé</span></a>
              </div>
            </div>
          </div>
          <figure class="cover-specimen">
            <span class="portrait-halftone" data-portrait-backdrop aria-hidden="true"></span>
            <img
              class="cover-portrait"
              src="/images/dave-bettner-headshot-20260816-cutout.png"
              alt="Dave Bettner in a gray suit and navy tie"
              width="1312"
              height="1199"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              data-portrait-source
              data-source-portrait
            />
          </figure>
        </div>
      </section>

      <section id="proof" class="proof-section" aria-labelledby="proof-heading">
        <div class="wrap section-pad">
          <div class="proof-head">
            <p class="mono section-index">Delivery outcomes</p>
            <h2 id="proof-heading">{selectedProof.title}</h2>
            <p class="section-lead">{selectedProof.lead}</p>
          </div>
          <div class="proof-ledger">
            {selectedProof.stories.map((story, index) => (
              <article class="proof-row" id={story.id}>
                <span class={`outcome-mark ${outcomeMarks[index]}`} aria-hidden="true"></span>
                <div class="proof-main">
                  <p class="proof-label">{story.label}</p>
                  <p class="proof-context">{story.context}</p>
                  <h3>{story.title}</h3>
                </div>
                <p class="proof-result">{story.result}</p>
              </article>
            ))}
          </div>
        </div>
      </section>


      <section id="work" class="work-section" aria-labelledby="work-heading">
        <div class="wrap section-pad">
          <div class="work-head">
            <p class="mono section-index">Evidence plates</p>
            <h2 id="work-heading">{buildingNow.title}</h2>
            <p class="section-lead">{buildingNow.lead}</p>
            <p class="proof-index-cue mono" id="proof-index-cue">Three current case studies</p>
          </div>
          <div class="building-list" role="region" aria-label="Selected engineering work" aria-describedby="proof-index-cue">
            {featuredProjects.map((project) => (
              <article class="building-card" id={project.id}>
                <div class="building-visual">
                  <span class="building-role mono">{roleByProjectId[project.id]}</span>
                  <EvidenceMotif motif={project.id === 'regulated-reporting-mcp' ? 'guarded-mutation' : 'guarded-readback'} compact />
                </div>
                <div class="building-copy">
                  <h3>
                    <a href={project.href}>{project.title}</a>
                  </h3>
                  <p class="building-evidence">{project.problem}</p>
                  <p class="building-links">
                    <a class="text-link" href={project.href}>Detail</a>
                    <span aria-hidden="true"> · </span>
                    {project.repoUrl ? (
                      <a
                        class="text-link external-repo"
                        href={project.repoUrl}
                        rel="noopener noreferrer"
                        aria-label={`GitHub ${project.repoUrl.replace('https://github.com/', '')}`}
                      >
                        <span class="repo-slug">github.com/{project.repoUrl.replace('https://github.com/', '')}</span>
                        <span class="repo-short">GitHub</span>
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    ) : (
                      <a class="text-link" href="/work/">Evidence index <span aria-hidden="true">→</span></a>
                    )}
                  </p>
                </div>
              </article>
            ))}
          </div>
          <p class="work-more">
            <a class="text-link" href="/work/">See all selected work <span aria-hidden="true">→</span></a>
          </p>
          <p class="provenance-note">{homepageProvenanceNote}</p>
        </div>
      </section>

      <section id="about" class="about-section" aria-labelledby="about-heading">
        <div class="wrap section-pad about-grid">
          <div class="about-copy">
            <p class="mono section-index">Working approach</p>
            <h2 id="about-heading">{homeSynthesis.title}</h2>
            <p class="about-lead">{homeSynthesis.body}</p>
            <p class="resume-link-line">
              <a class="text-link" href="/experience/">Experience</a>
              <span aria-hidden="true"> · </span>
              <a class="text-link" href="/fit/">First 90 days</a>
              <span aria-hidden="true"> · </span>
              <a class="text-link" href="/dave-bettner-resume.pdf" download>Full résumé (PDF)</a>
            </p>
          </div>
        </div>
      </section>

      <section class="cta-block" id="contact" aria-labelledby="contact-heading">
        <div class="wrap cta-grid">
          <div class="cta-copy">
            <p class="mono cta-kicker">Next</p>
            <h2 id="contact-heading">{closingCta.title}</h2>
            <p>{closingCta.body}</p>
          </div>
          <div class="cta-actions">
            <a class="round blue" href={emailHref} data-shader-host><span data-shader-label>Start a conversation <span aria-hidden="true">↗</span></span></a>
            <a class="round ghost-dark" href="/dave-bettner-resume.pdf" download>Résumé</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-row">
        <span>{identity.location}</span>
        <div class="footer-links">
          <a href="/about/">About</a>
          <ContactLinks />
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/sphere-gradient';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 16px;
    --space-4: 24px;
    --space-5: 32px;
    --space-6: 48px;
    --space-7: 64px;
    --max: 1280px;
    --content-width: min(var(--max), calc(100% - 48px));
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 112px;
    overflow-x: clip;
  }

  body {
    font-family: 'Archivo Variable', system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  ::selection {
    background: var(--blue);
    color: #fff;
  }

  * {
    scrollbar-color: var(--orange) var(--paper);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    left: 16px;
    top: 16px;
    z-index: 1000;
    background: var(--ink);
    color: var(--paper);
    padding: 12px 16px;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .mono {
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .wrap {
    width: var(--content-width);
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }

  .masthead {
    min-height: 64px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3);
    align-items: center;
  }

  .mast-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding-inline: 2px;
  }

  .mast-mark {
    width: 8px;
    height: 8px;
    background: var(--orange);
    box-shadow: 2px -1px 0 var(--blue);
    flex: 0 0 auto;
  }

  .mast-name {
    font-family: 'Archivo Variable', 'Arial Narrow', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .primary-nav {
    display: flex;
    justify-content: center;
    gap: clamp(14px, 2vw, 24px);
    font-size: 0.86rem;
  }

  .primary-nav a,
  .footer-links a,
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size 0.2s;
  }

  .primary-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 2px;
  }

  .primary-nav a:hover,
  .footer-links a:hover,
  .text-link:hover {
    background-size: 100% 1px;
  }

  .mast-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--ink);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .mast-cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--ink);
    min-height: 44px;
    padding: 10px 16px;
    font-size: 0.8rem;
    font-weight: 650;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .round.blue {
    background: var(--blue);
    color: white;
    border-color: var(--blue);
  }

  .round.ghost {
    background: transparent;
  }

  .round.ghost-dark {
    border-color: var(--panel-ink);
    color: var(--panel-ink);
  }

  /* Hover states are declared after every variant so a variant's base
     background can never outrank the hover pairing it belongs to. Each
     rule sets background and color together — never one without the other. */
  .round:hover,
  .round:focus-visible {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .round.blue:hover,
  .round.blue:focus-visible {
    background: var(--orange);
    color: #fff;
    border-color: var(--orange);
  }

  .round.ghost:hover,
  .round.ghost:focus-visible {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .round.ghost-dark:hover,
  .round.ghost-dark:focus-visible {
    background: var(--panel-ink);
    color: var(--panel);
    border-color: var(--panel-ink);
  }

  .section-pad {
    padding: var(--space-6) 0 var(--space-7);
  }

  .section-index {
    color: var(--orange-ink);
    margin-bottom: var(--space-2);
  }

  .section-lead {
    max-width: 58ch;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.55;
    margin: 0 0 var(--space-5);
  }

  .anchor-slot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* Cover */
  .cover {
    border-bottom: 1px solid var(--ink);
    padding: var(--space-4) 0 var(--space-5);
  }

  .cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-4) var(--space-5);
    align-items: start;
  }

  .cover-kicker {
    color: var(--muted);
  }

  .cover-identity {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .cover-identity img {
    display: block;
    width: clamp(76px, 7vw, 96px);
    height: clamp(76px, 7vw, 96px);
    flex: 0 0 auto;
    border: 1px solid var(--ink);
    object-fit: cover;
    object-position: center 12%;
  }


  .cover h1 {
    font-family: 'Archivo Variable', 'Arial Narrow', sans-serif;
    font-size: clamp(1.9rem, 4.2vw, 3.2rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.04em;
    max-width: 15ch;
  }

  .cover-support {
    margin-top: var(--space-3);
    max-width: 48ch;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .cover-meta {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    max-width: 46ch;
  }

  .cover-meta div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--space-2);
  }

  .cover-meta dt {
    font-family: 'DM Mono', monospace;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding-top: 3px;
  }

  .cover-meta dd {
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .cover-actions {
    display: grid;
    gap: 10px;
    margin-top: var(--space-3);
  }

  .cover-actions-primary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .cover-specimen {
    min-width: 0;
  }

  /* Work proof index */
  .work-section {
    border-bottom: 1px solid var(--ink);
    background:
      linear-gradient(90deg, transparent 79px, rgba(201, 195, 181, 0.35) 79px, rgba(201, 195, 181, 0.35) 80px, transparent 80px),
      var(--paper);
  }

  #about .section-pad {
    padding-block: clamp(40px, 5vw, 72px) !important;
  }

  .work-head h2,
  .proof-head h2,
  .about-copy h2 {
    font-family: 'Archivo Variable', 'Arial Narrow', sans-serif;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: var(--space-2);
  }

  .proof-index-cue {
    display: none;
    color: var(--muted);
    margin: calc(var(--space-3) * -1) 0 var(--space-3);
  }

  .building-list {
    display: grid;
    gap: var(--space-4);
  }

  .repo-short {
    display: none;
  }

  .building-card {
    display: grid;
    grid-template-columns: minmax(140px, 0.42fr) minmax(0, 1fr);
    gap: 0;
    border: 1px solid var(--ink);
    background: var(--paper);
    min-width: 0;
    transition: transform 0.2s ease;
  }

  .building-card:hover,
  .building-card:focus-within {
    transform: translate(-2px, -2px);
  }

  .building-visual {
    position: relative;
    border-right: 1px solid var(--ink);
    min-height: 180px;
    overflow: hidden;
    background: var(--card);
  }

  .building-role {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    max-width: calc(100% - 24px);
    padding: 6px 8px;
    font-size: 0.62rem;
    line-height: 1.25;
    letter-spacing: 0.06em;
    color: var(--warm);
    background: rgba(8, 9, 11, 0.76);
    border: 1px solid var(--graphite);
  }

  .building-chrome {
    position: absolute;
    right: 12px;
    bottom: 10px;
    z-index: 2;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--orange-ink);
    background: rgba(243, 239, 229, 0.82);
    padding: 4px 6px;
    border: 1px solid var(--rule);
  }

  .building-visual::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border: 1px solid rgba(242, 234, 223, 0.07);
  }

  .building-copy {
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  .building-copy h3 {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .building-copy h3 a {
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size 0.2s;
  }

  .building-copy h3 a:hover {
    background-size: 100% 1px;
  }

  .building-evidence {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink);
    max-width: 58ch;
  }

  .building-links {
    font-size: 0.88rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .work-more {
    margin-top: var(--space-4);
    font-size: 0.92rem;
  }

  .provenance-note {
    margin-top: var(--space-5);
    max-width: 68ch;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-3);
  }

  /* Delivery ledger */
  .proof-section {
    border-bottom: 1px solid var(--ink);
  }

  .proof-ledger {
    border-top: 1px solid var(--ink);
  }

  .proof-row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1.05fr) minmax(0, 1.15fr) minmax(0, 0.9fr);
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--rule);
  }

  .outcome-mark {
    width: 14px;
    height: 14px;
    margin-top: 4px;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .outcome-mark--circle {
    border-radius: 50%;
    background: var(--blue);
    border-color: var(--blue);
  }

  .outcome-mark--diamond {
    transform: rotate(45deg);
    border-color: var(--orange);
  }

  .proof-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--orange-ink);
    margin-bottom: 4px;
  }

  .proof-context {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .proof-main h3 {
    font-size: 1.05rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
    max-width: 36ch;
  }

  .proof-result {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--muted);
    max-width: 42ch;
  }

  .proof-summary {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink);
    max-width: 48ch;
  }

  /* About */
  .about-section {
    border-bottom: 1px solid var(--ink);
  }

  .about-grid {
    max-width: 78ch;
  }

  .about-lead {
    font-size: 1.05rem;
    line-height: 1.58;
    max-width: 54ch;
    margin: var(--space-3) 0 var(--space-4);
  }

  .resume-link-line {
    font-size: 0.92rem;
    color: var(--muted);
  }

  /* Closing CTA */
  .cta-block {
    background: var(--panel);
    color: var(--panel-ink);
    padding: var(--space-6) 0;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-5);
    align-items: end;
  }

  .cta-kicker {
    color: var(--orange-ink);
    margin-bottom: var(--space-2);
  }

  .cta-copy h2 {
    font-family: 'Archivo Variable', 'Arial Narrow', sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 14ch;
    margin-bottom: var(--space-3);
  }

  .cta-copy p {
    color: var(--panel-muted);
    max-width: 48ch;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  footer {
    padding: var(--space-4) 0 var(--space-5);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.76rem;
  }

  .footer-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Tablet shell: keep intentional split compositions through 768 */
  @media (max-width: 960px) {
    html {
      /* Matches the 94px two-row mobile masthead plus clearance. */
      scroll-padding-top: 110px;
    }

    /* The three nav links stay on one row below the brand rather than
       collapsing into a second duplicated nav. */
    .masthead {
      grid-template-columns: 1fr auto;
      row-gap: 4px;
    }

    .primary-nav {
      grid-column: 1 / -1;
      order: 3;
      justify-content: flex-start;
      gap: clamp(6px, 2vw, 14px);
      /* Cancels the link padding below so the first label still lines up
         with the brand mark. */
      margin-inline-start: -10px;
      border-top: 1px solid var(--rule);
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* Short labels ("Work", "Fit") are narrower than the 44px minimum touch
       target on their own, so the padding carries them to size. */
    .primary-nav a {
      min-width: 44px;
      justify-content: center;
      padding-inline: 10px;
    }

    .cover-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-4);
      align-items: start;
    }

    .cover h1 {
      max-width: 15ch;
      font-size: clamp(1.9rem, 4vw, 2.9rem);
    }

    .building-list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
    }

    .building-card {
      grid-template-columns: 1fr;
    }

    .building-visual {
      border-right: 0;
      border-bottom: 1px solid var(--ink);
      min-height: 72px;
      max-height: 88px;
    }

    .building-role {
      font-size: 0.58rem;
      padding: 5px 7px;
    }

    .building-copy {
      padding: var(--space-3);
      gap: var(--space-2);
    }

    .proof-row {
      grid-template-columns: 44px 1fr;
    }

    .proof-summary,
    .proof-result {
      grid-column: 2;
    }


    .cta-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: end;
    }
  }

  /* Phone compositional boundary */
  @media (max-width: 720px) {
    #about .section-pad {
      padding-block: 36px !important;
    }

    :root {
      --content-width: min(calc(100% - 28px), var(--max));
    }

    .cover {
      padding: var(--space-4) 0 var(--space-5);
    }

    .cover-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .cover-copy {
      display: contents;
    }

    .cover-identity {
      order: 1;
      margin-bottom: 0;
    }

    .cover-identity img {
      width: 72px;
      height: 72px;
    }

    .cover h1 {
      order: 2;
      max-width: 18ch;
      font-size: clamp(1.7rem, 7.5vw, 2.15rem);
    }

    .cover-support {
      order: 3;
      margin-top: var(--space-2);
      font-size: 0.92rem;
    }

    .cover-actions {
      order: 4;
      margin-top: var(--space-2);
    }

    .cover-specimen {
      order: 5;
    }

    .cover-meta {
      order: 6;
    }

    .cover-actions-primary {
      display: grid;
      grid-template-columns: 1fr;
    }

    .cover-actions-primary .round {
      width: 100%;
    }


    .cover-meta div {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .building-list {
      display: grid;
      grid-template-columns: 1fr;
      grid-auto-flow: row;
      gap: var(--space-3);
      overflow: visible;
    }

    .building-card {
      min-width: 0;
    }

    .building-visual {
      min-height: 64px;
      max-height: 76px;
    }

    .building-role {
      display: none;
    }

    .repo-slug {
      display: none;
    }

    .repo-short {
      display: inline;
    }

    .cta-grid {
      grid-template-columns: 1fr;
    }

    .section-pad {
      padding: var(--space-5) 0 var(--space-6);
    }

    .proof-row {
      grid-template-columns: 20px 1fr;
      gap: var(--space-2);
    }

    .proof-result {
      grid-column: 2;
    }

    .cta-block {
      padding: var(--space-5) 0;
    }

    .footer-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 360px) {
    .mast-name {
      font-size: 0.95rem;
    }

    .cover h1 {
      font-size: 1.95rem;
    }

  }

  @media (min-width: 961px) and (max-height: 740px) {
    .cover {
      padding: var(--space-2) 0 var(--space-3);
    }

    .cover-grid {
      gap: var(--space-2) var(--space-4);
      align-items: start;
    }

    .cover-identity {
      margin-bottom: var(--space-1);
    }

    .cover-identity img {
      width: 72px;
      height: 72px;
    }

    .cover h1 {
      font-size: clamp(1.5rem, 2.5vw, 2.1rem);
      margin-bottom: var(--space-1);
    }

    .cover-support {
      margin-bottom: var(--space-2);
      font-size: 0.9rem;
    }

    .cover-meta {
      display: none;
    }

    .cover-actions {
      margin-top: var(--space-1);
    }

    .cover-specimen .signal-field__frame {
      aspect-ratio: 16 / 10;
      max-height: min(42vh, 280px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .building-card {
      transition: none;
    }

    .building-card:hover,
    .building-card:focus-within {
      transform: none;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }
  }
</style>

