---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import jakartaFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import monoFont from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';
import SignalField from '../components/SignalField.astro';
import {
  aboutSection,
  buildingNow,
  closingCta,
  selectedProof,
  thesis,
  whereHeading,
} from '../data/homepage-framing';
import { identity } from '../data/portfolio-entries';
import { provenanceNote } from '../data/public-proof';
import {
  personSchema,
  siteDescription,
  siteTitle,
  siteUrl,
} from '../data/seo';
import { emailHref, githubUrl, linkedinUrl } from '../data/site-links';

const operatingLoop = [
  {
    cue: 'Discover',
    title: 'Discover',
    detail: whereHeading.items[0],
    handoff: 'Decision criteria',
  },
  {
    cue: 'Shape',
    title: 'Shape',
    detail: whereHeading.items[1],
    handoff: 'Scoped proposal / SOW',
  },
  {
    cue: 'Demonstrate',
    title: 'Demonstrate',
    detail: whereHeading.items[2],
    handoff: 'Demo against criteria',
  },
  {
    cue: 'Deliver',
    title: 'Deliver',
    detail: whereHeading.items[3],
    handoff: 'Signed-off go-live',
  },
  {
    cue: 'Adopt',
    title: 'Adopt',
    detail: whereHeading.items[4],
    handoff: 'Operating cadence',
  },
] as const;

const roleByProjectId: Record<string, string> = {
  'hermes-deployment-lab': 'Failure recovery',
  'regulated-reporting-mcp': 'Guarded integration',
  'hermes-field-kit': 'Evaluation',
  wingman: 'Readback + restore',
};

const outcomeMarks = ['outcome-mark--square', 'outcome-mark--circle', 'outcome-mark--diamond'] as const;

const aboutLead = aboutSection.body[0];
const featuredProjects = buildingNow.featuredProjects;
const motifByIndex = ['scan', 'lattice', 'pulse', 'gate'] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f3efe5" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dave Bettner — enterprise agent deployment and solutions engineering" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{siteTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap masthead">
        <a class="mast-brand" href="#top">
          <span class="mast-mark" aria-hidden="true"></span>
          <span class="mast-name">{identity.name}</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="#proof">Proof</a>
          <a href="/experience/">Experience</a>
          <a href="/fit/">Fit</a>
          <a href="#contact">Contact</a>
        </nav>
        <a class="mast-cta" href={emailHref}>Email <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="mobile-section-nav wrap" aria-label="Primary section navigation">
        <a href="#proof">Proof</a>
        <a href="/experience/">Experience</a>
        <a href="/fit/">Fit</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="cover" aria-labelledby="thesis-heading">
        <div id="thesis" class="wrap cover-grid">
          <div class="cover-copy">
            <div class="cover-identity">
              <img
                src="/images/dave-bettner-headshot-20260808-square.webp"
                srcset="/images/dave-bettner-headshot-20260808-square.webp 800w, /images/dave-bettner-headshot-20260808-square.jpg 800w"
                sizes="(max-width: 720px) 72px, 96px"
                alt="Dave Bettner smiling in a gray suit"
                width="800"
                height="800"
                loading="eager"
                decoding="async"
              />
              <div>
                <p class="cover-kicker mono">Enterprise agent deployment · Solutions engineering</p>
              </div>
            </div>
            <h1 id="thesis-heading">{thesis.title}</h1>
            <p class="cover-support">{thesis.body[0]}</p>
            <div class="cover-actions" aria-label="Candidate actions">
              <div class="cover-actions-primary">
                <a class="round blue" href={emailHref}>Start a conversation <span aria-hidden="true">↗</span></a>
                <a class="round ghost" href="/dave-bettner-resume.pdf" download>Résumé</a>
                <a class="round ghost" href="/experience/">Experience <span aria-hidden="true">→</span></a>
              </div>
              <div class="cover-actions-secondary">
                <a class="text-link identity-action-secondary" href="#work">Public engineering proof <span aria-hidden="true">↓</span></a>
                <a class="text-link" href="/fit/">Check role fit <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <dl class="cover-meta">
              <div>
                <dt>Location</dt>
                <dd>{identity.location}</dd>
              </div>
              <div>
                <dt>Direction</dt>
                <dd>{whereHeading.title}</dd>
              </div>
            </dl>
          </div>
          <div class="cover-specimen">
            <SignalField />
          </div>
        </div>
      </section>

      <section id="proof" class="proof-section" aria-labelledby="proof-heading">
        <div class="wrap section-pad">
          <div class="proof-head">
            <p class="mono section-index">Delivery outcomes</p>
            <h2 id="proof-heading">{selectedProof.title}</h2>
            <p class="section-lead">{selectedProof.lead}</p>
          </div>
          <div class="proof-ledger">
            {selectedProof.stories.map((story, index) => (
              <article class="proof-row" id={story.id}>
                <span class={`outcome-mark ${outcomeMarks[index]}`} aria-hidden="true"></span>
                <div class="proof-main">
                  <p class="proof-label">{story.label}</p>
                  <p class="proof-context">{story.context}</p>
                  <h3>{story.title}</h3>
                </div>
                <p class="proof-result">{story.result}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="direction" class="loop-section" aria-labelledby="loop-heading">
        <div class="wrap section-pad">
          <div class="loop-head">
            <p class="mono section-index">Operating loop</p>
            <h2 id="loop-heading">Presales through delivery</h2>
            <p class="loop-lead">{whereHeading.lead}</p>
          </div>
          <div class="loop-field-wrap">
            <div class="loop-field" aria-label="Engagement method inside a customer environment">
              <div class="loop-chrome" aria-hidden="true">
                <span class="loop-chrome-tag">STATE · LOOP</span>
                <span class="loop-chrome-tag loop-chrome-tag--muted">RES · CONTROLLED</span>
                <span class="loop-chrome-tag loop-chrome-tag--accent">5 STAGES</span>
              </div>
              <div class="loop-context">
                <p class="loop-context-label mono">Inside the customer environment</p>
                <div class="loop-mechanism">
                  <div class="loop-sequence">
                    <ol class="loop-rail">
                      {operatingLoop.map((stage, index) => (
                        <li class="loop-stage">
                          <div class="loop-stage-panel">
                            <span class="loop-cue mono">{stage.cue}</span>
                            <div class="loop-body">
                              <h3>{stage.title}</h3>
                              <p>{stage.detail}</p>
                            </div>
                            <p class="loop-handoff">
                              Hands off <strong>{stage.handoff}</strong>
                            </p>
                          </div>
                          {index < operatingLoop.length - 1 ? (
                            <span class="loop-transition" aria-hidden="true"></span>
                          ) : null}
                        </li>
                      ))}
                    </ol>
                    <span class="loop-return-rail" aria-hidden="true"></span>
                  </div>
                  <div class="loop-feedback">
                    <p class="loop-feedback-cue mono">Adopt → next Discover</p>
                    <p class="loop-feedback-copy">Adoption evidence reshapes the next discovery.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="loop-close">{whereHeading.close}</p>
          <span id="bring" class="anchor-slot" tabindex="-1"></span>
        </div>
      </section>

      <section id="work" class="work-section" aria-labelledby="work-heading">
        <div class="wrap section-pad">
          <div class="work-head">
            <p class="mono section-index">Evidence plates</p>
            <h2 id="work-heading">{buildingNow.title}</h2>
            <p class="section-lead">{buildingNow.lead}</p>
            <p class="proof-index-cue mono" id="proof-index-cue">Swipe / drag evidence plates →</p>
          </div>
          <div class="building-list" role="region" aria-label="Public engineering evidence" aria-describedby="proof-index-cue">
            {featuredProjects.map((project, index) => (
              <article class={`building-card motif-${motifByIndex[index]}`} id={project.id}>
                <div class="building-visual">
                  <span class="building-chrome mono" aria-hidden="true">PLATE · EVIDENCE</span>
                  <span class="building-role mono">{roleByProjectId[project.id]}</span>
                  <div class="building-motif" aria-hidden="true"></div>
                </div>
                <div class="building-copy">
                  <h3>
                    <a href={project.href}>{project.title}</a>
                  </h3>
                  <p class="building-evidence">{project.built}</p>
                  <p class="building-links">
                    <a class="text-link" href={project.href}>Detail</a>
                    <span aria-hidden="true"> · </span>
                    <a
                      class="text-link external-repo"
                      href={project.repoUrl}
                      rel="noopener noreferrer"
                      aria-label={`Repository github.com/dbett4/${project.repoUrl.replace('https://github.com/dbett4/', '')}`}
                    >
                      <span class="repo-slug">github.com/dbett4/{project.repoUrl.replace('https://github.com/dbett4/', '')}</span>
                      <span class="repo-short">Repository</span>
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  </p>
                </div>
              </article>
            ))}
          </div>
          <p class="work-more">
            <a class="text-link" href="/work/">See remaining public work <span aria-hidden="true">→</span></a>
          </p>
          <p class="provenance-note">{provenanceNote}</p>
        </div>
      </section>

      <section id="about" class="about-section" aria-labelledby="about-heading">
        <div class="wrap section-pad about-grid">
          <div class="about-copy">
            <p class="mono section-index">About</p>
            <h2 id="about-heading">{aboutSection.title}</h2>
            <p class="about-lead">{aboutLead}</p>
            <p class="resume-link-line">
              <a class="text-link" href="/experience/">Career timeline</a>
              <span aria-hidden="true"> · </span>
              <a class="text-link" href="/dave-bettner-resume.pdf" download>Full résumé (PDF)</a>
              <span aria-hidden="true"> · </span>
              <a class="text-link" href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
              <span aria-hidden="true"> · </span>
              <a class="text-link" href={linkedinUrl} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
            </p>
          </div>
        </div>
      </section>

      <section class="cta-block" id="contact" aria-labelledby="contact-heading">
        <div class="wrap cta-grid">
          <div class="cta-copy">
            <p class="mono cta-kicker">Next</p>
            <h2 id="contact-heading">{closingCta.title}</h2>
            <p>{closingCta.body}</p>
          </div>
          <div class="cta-actions">
            <a class="round blue" href={emailHref}>Start a conversation <span aria-hidden="true">↗</span></a>
            <a class="round ghost-dark" href="/dave-bettner-resume.pdf" download>Résumé</a>
            <a class="round ghost-dark" href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
            <a class="round ghost-dark" href={linkedinUrl} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-row">
        <span>{identity.location}</span>
        <div class="footer-links">
          <a href="#thesis">Thesis</a>
          <a href="#direction">Loop</a>
          <a href="#work">Work</a>
          <a href="#proof">Delivery</a>
          <a href="#about">About</a>
          <a href="/about/">About page</a>
          <a href="/work/">Work pages</a>
          <a href="/experience/">Experience</a>
          <a href="#contact">Contact</a>
          <a href="/fit/">Role fit</a>
          <a href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
          <a href={linkedinUrl} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href={emailHref}>Email <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f3efe5;
    --ink: #151515;
    --blue: #214fe5;
    --orange: #cf4120;
    --orange-ink: #9a2f14;
    --muted: #62615d;
    --rule: #c9c3b5;
    --card: #eee8dc;
    --panel: #0f1115;
    --panel-ink: #e8e6e1;
    --panel-muted: #9a9893;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 16px;
    --space-4: 24px;
    --space-5: 32px;
    --space-6: 48px;
    --space-7: 64px;
    --max: 1280px;
    --content-width: min(var(--max), calc(100% - 48px));
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 112px;
  }

  body {
    font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    left: 16px;
    top: 16px;
    z-index: 1000;
    background: var(--ink);
    color: var(--paper);
    padding: 12px 16px;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .mono {
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .wrap {
    width: var(--content-width);
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }

  .masthead {
    min-height: 64px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3);
    align-items: center;
  }

  .mast-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding-inline: 2px;
  }

  .mast-mark {
    width: 8px;
    height: 8px;
    background: var(--orange);
    box-shadow: 2px -1px 0 var(--blue);
    flex: 0 0 auto;
  }

  .mast-name {
    font-family: 'Newsreader Variable', Georgia, serif;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .primary-nav {
    display: flex;
    justify-content: center;
    gap: clamp(14px, 2vw, 24px);
    font-size: 0.86rem;
  }

  .primary-nav a,
  .footer-links a,
  .text-link {
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size 0.2s;
  }

  .primary-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 2px;
  }

  .primary-nav a:hover,
  .footer-links a:hover,
  .text-link:hover {
    background-size: 100% 1px;
  }

  .mast-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--ink);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .mast-cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .mobile-section-nav {
    display: none;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: clamp(12px, 3vw, 20px);
    padding-block: 4px;
  }

  .mobile-section-nav::-webkit-scrollbar {
    display: none;
  }

  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--ink);
    min-height: 44px;
    padding: 10px 16px;
    font-size: 0.8rem;
    font-weight: 650;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .round:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .round.blue {
    background: var(--blue);
    color: white;
    border-color: var(--blue);
  }

  .round.blue:hover {
    background: var(--orange);
    border-color: var(--orange);
  }

  .round.ghost {
    background: transparent;
  }

  .round.ghost-dark {
    border-color: var(--panel-ink);
    color: var(--panel-ink);
  }

  .round.ghost-dark:hover {
    background: var(--panel-ink);
    color: var(--panel);
  }

  .section-pad {
    padding: var(--space-6) 0 var(--space-7);
  }

  .section-index {
    color: var(--orange-ink);
    margin-bottom: var(--space-2);
  }

  .section-lead {
    max-width: 58ch;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.55;
    margin: 0 0 var(--space-5);
  }

  .anchor-slot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* Cover */
  .cover {
    border-bottom: 1px solid var(--ink);
    padding: var(--space-4) 0 var(--space-5);
  }

  .cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-4) var(--space-5);
    align-items: start;
  }

  .cover-kicker {
    color: var(--muted);
  }

  .cover-identity {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .cover-identity img {
    display: block;
    width: clamp(76px, 7vw, 96px);
    height: clamp(76px, 7vw, 96px);
    flex: 0 0 auto;
    border: 1px solid var(--ink);
    object-fit: cover;
    object-position: center 12%;
  }


  .cover h1 {
    font-family: 'Newsreader Variable', Georgia, serif;
    font-size: clamp(1.9rem, 4.2vw, 3.2rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
    max-width: 18ch;
  }

  .cover-support {
    margin-top: var(--space-3);
    max-width: 42ch;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .cover-meta {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    max-width: 46ch;
  }

  .cover-meta div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--space-2);
  }

  .cover-meta dt {
    font-family: 'DM Mono', monospace;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding-top: 3px;
  }

  .cover-meta dd {
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .cover-actions {
    display: grid;
    gap: 10px;
    margin-top: var(--space-3);
  }

  .cover-actions-primary,
  .cover-actions-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .cover-actions-secondary {
    gap: 18px;
    padding-left: 2px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .cover-specimen {
    min-width: 0;
  }

  /* Operating loop */
  .loop-section {
    border-bottom: 1px solid var(--ink);
    position: relative;
  }

  .loop-head h2 {
    font-family: 'Newsreader Variable', Georgia, serif;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: var(--space-2);
  }

  .loop-lead {
    color: var(--muted);
    max-width: 48ch;
    margin-bottom: var(--space-5);
  }

  .loop-field-wrap {
    display: grid;
    gap: var(--space-4);
  }

  .loop-field {
    min-width: 0;
    border: 1px solid var(--ink);
    background:
      radial-gradient(circle, rgba(33, 79, 229, 0.18) 0 1px, transparent 1.4px),
      var(--paper);
    background-size: 8px 8px;
