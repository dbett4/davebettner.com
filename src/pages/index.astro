---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import jakartaFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import monoFont from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';
import {
  aboutSection,
  buildingNow,
  closingCta,
  selectedProof,
  thesis,
  whatIBring,
  whereHeading,
} from '../data/homepage-framing';
import { identity } from '../data/portfolio-entries';
import { provenanceNote } from '../data/public-proof';
import {
  identitySeoLead,
  personSchema,
  siteDescription,
  siteTitle,
  siteUrl,
} from '../data/seo';
import { emailHref, githubUrl, linkedinUrl } from '../data/site-links';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f3efe5" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dave Bettner — operator and implementation leader" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{siteTitle}</title>
    <!-- deploy: 2026-08-11-seo-indexing -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <nav class="primary-nav" aria-label="Primary navigation">
        <a class="brand brand--home" href="#top" aria-label="Home">
          <span class="brand-mark" aria-hidden="true"></span>
        </a>
        <div class="nav-center">
          <a href="#thesis">Thesis</a>
          <a href="#direction">Direction</a>
          <a href="#work">Work</a>
          <a href="#proof">Delivery</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
          <a href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <div class="nav-right">
          <a class="round blue" href={emailHref}>Contact <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
      <nav class="mobile-section-nav" aria-label="Section navigation">
        <a href="#thesis">Thesis</a>
        <a href="#direction">Direction</a>
        <a href="#work">Work</a>
        <a href="#proof">Delivery</a>
        <a href="#about">About</a>
        <a href={githubUrl} rel="me">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="identity-band has-reg-marks" aria-labelledby="identity-heading">
        <div class="wrap identity-grid">
          <div class="identity-copy">
            <div class="identity-title-row">
              <div class="identity-portrait">
                <img
                  src="/images/dave-bettner-headshot-20260808-square.webp"
                  srcset="/images/dave-bettner-headshot-20260808-square.webp 800w, /images/dave-bettner-headshot-20260808-square.jpg 800w"
                  sizes="116px"
                  alt="Dave Bettner smiling in a gray suit"
                  width="800"
                  height="800"
                  loading="eager"
                  decoding="async"
                />
              </div>
              <div class="identity-head">
                <h1 id="identity-heading">{identity.name}</h1>
                {identity.headline ? <p class="identity-headline">{identity.headline}</p> : null}
              </div>
            </div>
            <p class="identity-caption">{identity.caption}</p>
            <p class="identity-seo-lead">{identitySeoLead}</p>
          </div>
          <div class="identity-meta">
            <p class="mono identity-location">{identity.location}</p>
            {identity.availability ? <p class="identity-availability">{identity.availability}</p> : null}
            <div class="identity-actions">
              <a class="round blue" href="#work">See public engineering proof <span aria-hidden="true">↓</span></a>
              <a class="round identity-action-secondary" href="/experience/">View my experience <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </section>

      <section id="thesis" class="thesis-section" aria-labelledby="thesis-heading">
        <div class="wrap section-body">
          <h2 class="section-title" id="thesis-heading">{thesis.title}</h2>
          <div class="prose-block">
            {thesis.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section id="direction" aria-labelledby="direction-heading">
        <div class="wrap section-body">
          <h2 class="section-title" id="direction-heading">{whereHeading.title}</h2>
          <p class="section-lead">{whereHeading.lead}</p>
          <ul class="direction-list">
            {whereHeading.items.map((item) => <li>{item}</li>)}
          </ul>
          <p class="section-close">{whereHeading.close}</p>
        </div>
      </section>

      <section id="bring" class="bring-section" aria-labelledby="bring-heading">
        <div class="wrap section-body">
          <h2 class="section-title" id="bring-heading">{whatIBring.title}</h2>
          <div class="prose-block">
            {whatIBring.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section id="work" aria-labelledby="work-heading">
        <div class="wrap section-body">
          <h2 class="section-title" id="work-heading">{buildingNow.title}</h2>
          <p class="section-lead">{buildingNow.lead}</p>
          <div class="building-list">
            {buildingNow.projects.map((project) => (
              <article class="building-card" id={project.id}>
                <h3>
                  <a href={project.href}>{project.title}</a>
                </h3>
                <dl class="building-facts">
                  <div><dt>Repo</dt><dd><a class="text-link external-repo" href={project.repoUrl} rel="noopener noreferrer">github.com/dbett4/{project.repoUrl.replace('https://github.com/dbett4/', '')} <span aria-hidden="true">↗</span></a></dd></div>
                  <div><dt>What</dt><dd>{project.problem}</dd></div>
                  <div><dt>Evidence</dt><dd>{project.built}</dd></div>
                  <div><dt>Limit</dt><dd>{project.tools}</dd></div>
                </dl>
              </article>
            ))}
          </div>
          <p class="provenance-note">{provenanceNote}</p>
        </div>
      </section>

      <section id="proof" aria-labelledby="proof-heading">
        <div class="wrap section-body">
          <h2 class="section-title" id="proof-heading">{selectedProof.title}</h2>
          <p class="section-lead">{selectedProof.lead}</p>
          <div class="proof-list">
            {selectedProof.stories.map((story) => (
              <article class="proof-story" id={story.id}>
                <p class="proof-label">{story.label}</p>
                <h3>{story.title}</h3>
                <p class="proof-summary">{story.summary}</p>
                <p class="proof-result">{story.result}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="about" aria-labelledby="about-heading">
        <div class="wrap section-body">
          <h2 class="section-title" id="about-heading">{aboutSection.title}</h2>
          <div class="prose-block">
            {aboutSection.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <p class="resume-link-line">
            <a class="text-link" href="/experience/">Career timeline</a>
            <span aria-hidden="true"> · </span>
            <a class="text-link" href="/dave-bettner-resume.pdf" download>Full résumé (PDF)</a>
            <span aria-hidden="true"> · </span>
            <a class="text-link" href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
            <span aria-hidden="true"> · </span>
            <a class="text-link" href={linkedinUrl} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
          </p>
        </div>
      </section>

      <section class="resume-block" id="contact" aria-labelledby="contact-heading">
        <div class="wrap resume-grid">
          <h2 id="contact-heading">{closingCta.title}</h2>
          <div class="resume-side">
            <p>{closingCta.body}</p>
            <div class="resume-actions">
              <a class="round blue" href={emailHref}>Start a conversation <span aria-hidden="true">↗</span></a>
              <a class="round" href="/dave-bettner-resume.pdf" download>Résumé</a>
              <a class="round" href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
              <a class="round" href={linkedinUrl} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-row">
        <span>{identity.location}</span>
        <div class="footer-links">
          <a href="#thesis">Thesis</a>
          <a href="#direction">Direction</a>
          <a href="#work">Work</a>
          <a href="#proof">Delivery</a>
          <a href="#about">About</a>
          <a href="/about/">About page</a>
          <a href="/work/">Work pages</a>
          <a href="/experience/">Experience</a>
          <a href="#contact">Contact</a>
          <a href="/fit/">Role fit</a>
          <a href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
          <a href={linkedinUrl} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href={emailHref}>Email <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root{--paper:#f3efe5;--ink:#151515;--blue:#214fe5;--orange:#cf4120;--muted:#62615d;--rule:#c9c3b5;--card:#eee8dc;--panel:#0f1115;--panel-ink:#e8e6e1;--panel-muted:#9a9893;--panel-border:#2a2d35;--max:1320px;--content-width:min(var(--max),calc(100% - 52px));--content-inset:max(14px,calc((100% - var(--content-width)) / 2))}
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;scroll-padding-top:140px}
  body{font-family:"Plus Jakarta Sans Variable",system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.45;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  .site-header,.identity-band,main,footer{position:relative;z-index:1}
  a{color:inherit;text-decoration:none}
  button{font:inherit;color:inherit}
  a:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  .skip-link{position:fixed;left:16px;top:16px;z-index:1000;background:var(--ink);color:var(--paper);padding:12px 16px;transform:translateY(-200%)}
  .skip-link:focus{transform:none}
  .mono{font-family:"DM Mono",monospace;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}
  .wrap{width:min(var(--max),calc(100% - 52px));margin-inline:auto}
  .site-header{position:relative;z-index:20}
  .primary-nav{height:86px;border-bottom:1px solid var(--ink);display:grid;grid-template-columns:1fr auto 1fr;align-items:center}
  .brand{display:inline-flex;align-items:center;gap:8px}
  .brand-mark{width:8px;height:8px;background:var(--orange);border-radius:50%;flex:0 0 auto;box-shadow:2px -1px 0 var(--blue)}
  .brand--home{padding:4px}
  .nav-center{display:flex;gap:24px;font-size:.88rem}
  .nav-center a,.footer-links a,.text-link{background-image:linear-gradient(currentColor,currentColor);background-position:0 100%;background-repeat:no-repeat;background-size:0 1px;transition:background-size .2s}
  .nav-center a:hover,.footer-links a:hover,.text-link:hover{background-size:100% 1px}
  .nav-right{justify-self:end;display:flex;gap:10px}
  .mobile-section-nav{display:none;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;gap:clamp(14px,4vw,24px);padding:0 4px;justify-content:flex-start}
  .mobile-section-nav::-webkit-scrollbar{display:none}
  .mobile-section-nav a{flex:0 0 auto;white-space:nowrap}
  .round{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--ink);border-radius:999px;min-height:44px;padding:10px 16px;font-size:.8rem;font-weight:650;transition:background .2s,color .2s,border-color .2s}
  .round:hover{background:var(--ink);color:var(--paper)}
  .round.blue{background:var(--blue);color:white;border-color:var(--blue)}
  .round.blue:hover{background:var(--orange);border-color:var(--orange)}
  section{border-bottom:1px solid var(--ink)}
  .has-reg-marks{position:relative}
  .has-reg-marks::before,.has-reg-marks::after{content:'';position:absolute;top:20px;width:12px;height:12px;border:1px solid var(--ink);opacity:.18;pointer-events:none;z-index:0}
  .has-reg-marks::before{left:var(--content-inset);border-width:1px 0 0 1px}
  .has-reg-marks::after{right:var(--content-inset);border-width:1px 1px 0 0}
  .identity-band{padding:56px 0 52px;background:var(--paper)}
  .identity-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:start}
  .identity-copy{display:block;width:100%;max-width:100%}
  .identity-title-row{display:flex;align-items:flex-start;gap:clamp(20px,3vw,32px);position:relative}
  .identity-portrait{position:relative;flex:0 0 auto;width:clamp(76px,11vw,116px);aspect-ratio:1;border-radius:50%;overflow:hidden;border:1px solid var(--ink);background:transparent}
  .identity-portrait img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 12%;border-radius:50%}
  .identity-band h1{font-family:"Newsreader Variable",Georgia,serif;font-size:clamp(2.8rem,5vw,4.2rem);font-weight:500;line-height:1.05;letter-spacing:-.04em;margin:0;text-wrap:balance}
  .identity-head{display:flex;flex-direction:column;gap:10px;min-width:0;padding-top:2px}
  .identity-headline{font-family:"Newsreader Variable",Georgia,serif;font-size:clamp(1.15rem,2.2vw,1.55rem);font-weight:500;line-height:1.25;letter-spacing:-.02em;margin:0;color:var(--ink);text-wrap:balance}
  .identity-caption{font-size:clamp(1.05rem,1.8vw,1.22rem);max-width:640px;margin-top:clamp(16px,2.5vw,22px);color:var(--ink);line-height:1.5;font-weight:450}
  .identity-seo-lead{font-size:clamp(1rem,1.6vw,1.12rem);max-width:640px;margin-top:14px;color:var(--muted);line-height:1.55}
  .identity-meta{display:flex;flex-direction:column;gap:16px;align-items:flex-start;padding-top:6px}
  .identity-location{color:var(--muted)}
  .identity-availability{font-size:.92rem;font-weight:650;max-width:420px;line-height:1.45}
  .identity-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:6px;width:100%}
  .identity-action-secondary{background:var(--paper)}
  .identity-action-secondary:hover{background:var(--ink);color:var(--paper)}
  .section-close{max-width:760px;font-size:1.02rem;line-height:1.55;color:var(--ink);margin-top:20px}
  .prose-block{display:grid;gap:16px;max-width:760px}
  .prose-block p{font-size:1.05rem;line-height:1.58;color:var(--muted)}
  .prose-block p:first-child{color:var(--ink)}
  .thesis-section{background:linear-gradient(180deg,rgba(238,232,220,.35) 0%,var(--paper) 100%)}
  .bring-section{background:linear-gradient(180deg,var(--paper) 0%,rgba(238,232,220,.28) 100%)}
  .direction-list{list-style:none;display:grid;gap:10px;max-width:720px;margin:0 0 8px}
  .direction-list li{position:relative;padding-left:18px;font-size:.98rem;line-height:1.5;color:var(--muted)}
  .direction-list li::before{content:'';position:absolute;left:0;top:.62em;width:6px;height:6px;border-radius:50%;background:var(--blue)}
  .building-list{display:grid;gap:20px;margin-top:8px}
  .building-card{border:1px solid var(--ink);background:var(--card);padding:24px 24px 26px 28px;box-shadow:3px 3px 0 var(--ink)}
  .building-card{min-width:0}
  .building-card h3{font-size:1.25rem;letter-spacing:-.02em;margin-bottom:16px}
  .building-card h3 a{background-image:linear-gradient(currentColor,currentColor);background-position:0 100%;background-repeat:no-repeat;background-size:0 1px;transition:background-size .2s}
  .building-card h3 a:hover{background-size:100% 1px}
  .building-facts{display:grid;gap:12px;margin:0}
  .building-facts div{display:grid;grid-template-columns:minmax(0,88px) minmax(0,1fr);gap:16px;align-items:start}
  .building-facts dt{font-family:"DM Mono",monospace;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding-top:2px}
  .building-facts dd{font-size:.94rem;line-height:1.5;color:var(--muted);margin:0}
  .building-facts dd,.external-repo{min-width:0;overflow-wrap:anywhere}
  .proof-list{display:grid;gap:0;border-top:1px solid var(--ink);margin-top:8px}
  .proof-story{border-top:1px solid var(--rule);padding:28px 0}
  .proof-story:first-child{border-color:var(--ink)}
  .proof-label{font-family:"DM Mono",monospace;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;color:var(--orange);margin-bottom:8px}
  .proof-story h3{font-size:1.2rem;letter-spacing:-.015em;margin-bottom:10px;max-width:720px}
  .proof-summary{font-size:.98rem;line-height:1.55;color:var(--muted);max-width:760px;margin-bottom:8px}
  .proof-result{font-size:.95rem;line-height:1.5;color:var(--ink);max-width:760px;font-weight:550}
  .resume-link-line{margin-top:28px;font-size:.95rem;color:var(--muted)}
  .provenance-note{margin-top:24px;max-width:760px;font-size:.82rem;line-height:1.5;color:var(--muted);border-top:1px solid var(--rule);padding-top:16px}
  .section-title{font-family:"Newsreader Variable",Georgia,serif;font-size:clamp(2rem,3.5vw,3rem);font-weight:500;line-height:1.08;letter-spacing:-.03em;margin:0 0 18px;text-wrap:balance}
  .section-lead{max-width:760px;color:var(--muted);font-size:1.02rem;line-height:1.55;margin:0 0 32px}
  .about-lede{font-size:1.12rem;line-height:1.58;color:var(--ink);max-width:760px;margin:0 0 24px}
  .about-lede:last-of-type{margin-bottom:28px}
  .capability-list{display:grid;gap:0;margin-top:0}
  .capability-row{border-top:1px solid var(--rule);padding:22px 0;display:grid;grid-template-columns:minmax(180px,260px) 1fr;gap:24px;align-items:start}
  .capability-row:first-child{border-color:var(--ink)}
  .capability-row h3{font-size:1.1rem;letter-spacing:-.015em}
  .capability-row p{color:var(--muted);font-size:.95rem;line-height:1.55;max-width:640px}
  .how-section{background:linear-gradient(180deg,rgba(238,232,220,.42) 0%,var(--paper) 72%)}
  .how-section .section-body{padding-bottom:80px}
  .how-step-list{display:grid;gap:0;margin-top:8px;border-top:1px solid var(--ink)}
  .how-step-row{border-top:1px solid var(--rule);padding:26px 0}
  .how-step-row h3{font-size:1.15rem;letter-spacing:-.015em;margin-bottom:8px}
  .how-step-row p{color:var(--muted);font-size:.96rem;line-height:1.58;max-width:680px;margin:0}
  .about-points{list-style:none;display:grid;gap:12px;max-width:720px;margin-bottom:8px}
  .about-points li{position:relative;padding-left:18px;font-size:.96rem;line-height:1.5;color:var(--muted)}
  .about-points li::before{content:'';position:absolute;left:0;top:.62em;width:6px;height:6px;border-radius:50%;background:var(--orange);box-shadow:1px -1px 0 var(--blue)}
  .portfolio-list{display:grid;gap:0;margin-top:4px}
  .portfolio-entry{border-top:none;padding:0}
  .portfolio-card{position:relative;border:1px solid var(--ink);background:var(--card);padding:28px 28px 30px 32px;margin-bottom:24px;outline:none;box-shadow:4px 4px 0 var(--ink);transition:border-color .2s,background .2s}
  .portfolio-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--blue)}
  #insurance-certification::before{background:var(--blue)}
  #gov-reporting::before{background:var(--orange)}
  #clinical-imaging::before{background:var(--blue)}
  .portfolio-card:last-child{margin-bottom:0}
  .portfolio-card:hover,.portfolio-card:focus-visible{border-color:var(--blue);background:#ebe4d6}
  .portfolio-entry-head{margin-bottom:0}
  .portfolio-entry h3{font-size:1.55rem;letter-spacing:-.02em;line-height:1.28}
  .portfolio-entry h3 a{background-image:linear-gradient(currentColor,currentColor);background-position:0 100%;background-repeat:no-repeat;background-size:0 1px;transition:background-size .2s}
  .portfolio-entry h3 a:hover{background-size:100% 1px}
  .entry-link{font-size:.9em}
  .portfolio-problem{font-size:1.02rem;margin:18px 0 16px;max-width:820px;color:var(--ink);line-height:1.55}
  .portfolio-details{display:grid;gap:12px}
  .portfolio-details p{color:var(--muted);font-size:.95rem;line-height:1.55;max-width:820px;margin:0}
  .cv-row{display:grid;grid-template-columns:150px 1fr;gap:24px;border-top:1px solid var(--rule);padding:22px 0;align-items:start}
  .cv-row:first-of-type{border-color:var(--ink)}
  .cv-row time{color:var(--muted);font-size:.72rem}
  .cv-row h3{font-size:1.1rem;letter-spacing:-.015em}
  .cv-row p{color:var(--muted);margin-top:6px;max-width:720px;font-size:.92rem}
