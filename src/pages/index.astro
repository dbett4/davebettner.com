---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import {
  credibilityLine,
  experienceSection,
  heroHeading,
  heroIdentity,
  heroSupport,
  hiringClose,
  howIWork,
  workSection,
} from '../data/homepage-framing';
import { ogImagePath, personSchema, siteDescription, siteTitle, siteUrl } from '../data/seo';
import { emailHref } from '../data/site-links';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F5F2EA" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Agent-readable site guide" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles/working-record.css" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}${ogImagePath}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dave Bettner — Senior Manager, enterprise deployments" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={`${siteUrl}${ogImagePath}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{siteTitle}</title>
  </head>
  <body>
    <!--
      SEED: working-record-20260906
      THESIS: Dave is the subject. The Working Record is a ruled, rectangular, paper-and-ink
      system that states his role, his delivery record, and his public engineering evidence
      in plain reading order — no gradient, glow, glass, canvas, or spectacle stands between
      the visitor and the claim.
      WORLD: Paper #F5F2EA, ink #171717, safety orange #E85D1A for accents, accessible dark
      orange #A93D12 for focus and small text, paper-alt #E9E4D9 for banding, rule #C9C3B8 for
      hairlines. Newsreader Variable carries the h1 and restrained section headings; Archivo
      Variable carries UI and body copy; DM Mono is reserved for dates and short labels.
      STORY: A visitor reads Dave's identity and lane, then his three-role delivery record,
      then two independent engineering proofs with stated boundaries, then his working method,
      then a direct hiring close — one ruled path, no detours.
      FIRST VIEWPORT: compact masthead, identity line, exact h1, support copy, one primary
      action to selected work, two quiet actions (résumé, email), and the source portrait at
      right on a 7/5 grid split that stacks on narrow viewports.
      FORM: The Working Record. Static-first; every state is in the HTML; motion is limited to
      180ms color/background/border/underline feedback and a 200ms active scale(.98).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish
      review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />

    <main id="main">
      <section class="section hero" aria-labelledby="hero-heading">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="identity-line">{heroIdentity}</p>
            <h1 id="hero-heading">{heroHeading}</h1>
            <p class="lead hero-support">{heroSupport}</p>
            <div class="hero-actions">
              <a class="action action-primary" href="/work/">View selected work</a>
              <div class="hero-actions-quiet">
                <a class="quiet-link" href="/dave-bettner-resume.pdf" download>Résumé</a>
                <a class="quiet-link" href={emailHref}>Email</a>
              </div>
            </div>
          </div>
          <figure class="hero-portrait">
            <img
              src="/images/dave-bettner-headshot-20260816-cutout.png"
              alt="Dave Bettner, wearing a gray suit and navy tie"
              width="1312"
              height="1199"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              data-source-portrait
            />
          </figure>
        </div>
      </section>

      <section class="credibility" aria-label="Credibility">
        <div class="wrap">
          <p class="lead credibility-line">{credibilityLine}</p>
        </div>
      </section>

      <section class="section" id="experience" aria-labelledby="experience-heading">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow mono">{experienceSection.eyebrow}</p>
            <h2 id="experience-heading">{experienceSection.title}</h2>
            <p class="lead">{experienceSection.lead}</p>
          </div>
          <ol class="ruled-list">
            {experienceSection.rows.map((row) => (
              <li class="ruled-row evidence-row-grid">
                <div class="evidence-row-meta">
                  <p class="mono">{row.dates}</p>
                  <p class="role-line">{row.role}</p>
                </div>
                <div class="evidence-row-body">
                  <p>{row.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="section-link">
            <a class="text-link" href={experienceSection.href}>{experienceSection.linkLabel} <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </section>

      <section class="section" id="work" aria-labelledby="work-heading">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow mono">{workSection.eyebrow}</p>
            <h2 id="work-heading">{workSection.title}</h2>
            <p class="lead">{workSection.lead}</p>
          </div>
          <ol class="ruled-list">
            {workSection.cases.map((item) => (
              <li class="ruled-row evidence-row-grid" id={item.id}>
                <div class="evidence-row-meta">
                  <p class="mono case-display">{item.display}</p>
                  <h3>{item.title}</h3>
                </div>
                <div class="evidence-row-body">
                  <p>{item.summary}</p>
                  <p class="case-boundary muted">{item.boundary}</p>
                  <p class="section-link">
                    <a class="text-link" href={item.href}>{item.label} <span aria-hidden="true">→</span></a>
                  </p>
                </div>
              </li>
            ))}
          </ol>
          <p class="section-link">
            <a class="text-link" href={workSection.href}>{workSection.linkLabel} <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </section>

      <section class="section" id="how-i-work" aria-labelledby="how-heading">
        <div class="wrap">
          <p class="eyebrow mono">{howIWork.eyebrow}</p>
          <h2 id="how-heading">{howIWork.title}</h2>
          <p class="lead">{howIWork.lead}</p>
          <p class="section-link">
            <a class="text-link" href={howIWork.href}>{howIWork.linkLabel} <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </section>

      <section class="hiring-close" id="contact" aria-labelledby="contact-heading">
        <div class="wrap">
          <p class="eyebrow mono">{hiringClose.eyebrow}</p>
          <h2 id="contact-heading">{hiringClose.title}</h2>
          <p class="lead">{hiringClose.body}</p>
          <div class="hiring-close-actions">
            <a class="action action-primary" href={emailHref}>{hiringClose.primaryLabel}</a>
            <a class="action action-quiet" href="/dave-bettner-resume.pdf" download>{hiringClose.quietLabel}</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
