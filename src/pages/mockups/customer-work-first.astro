---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/dm-mono/400.css';
import SecondaryMasthead from '../../components/SecondaryMasthead.astro';
import { siteUrl } from '../../data/seo';

const title = 'Review mockup · Customer work first | Dave Bettner';
const description = 'Unlinked review mockup for a customer-work-first information architecture and public-proof index.';
const canonical = `${siteUrl}/mockups/customer-work-first/`;

const cases = [
  {
    number: '01',
    label: 'Public case · deployment recovery',
    title: 'Scope tools, separate approval, and recover when the response fails.',
    summary: 'The Hermes Deployment Lab tests the moment an agent has already changed a system but never receives confirmation. The recovery finds the first result instead of creating a second.',
    stakes: 'A committed side effect can become a duplicate action or a manual investigation.',
    decision: 'A synthetic lab pauses the first write for a separate operator grant, injects a post-commit fault, then resumes with the same tracking number.',
    evidence: 'Public CI run 31892965924 forces the failure, restarts the workflow, and verifies one final result across 241 credential-free tests.',
    boundary: 'Synthetic lab, not a client tenant. Cloud configuration is checked, not deployed.',
    href: '/work/hermes-deployment-lab/',
  },
  {
    number: '02',
    label: 'Public case · guarded integration',
    title: 'Keep confirmation, readback, and honest uncertainty inside the tool contract.',
    summary: 'Regulated Reporting MCP is a Workiva-shaped integration lab. It exposes a narrow default surface, confirms writes, reads results back, and does not guess when an outcome is uncertain.',
    stakes: 'A full tool catalog can expose customer-impacting actions before policy has a chance to review them.',
    decision: 'Three guarded tools are available by default; the full registry requires an explicit unsafe opt-in and every write has a confirmation/readback path.',
    evidence: 'Credential-free tests, registered tool-contract coverage, and an offline end-to-end demo that runs without credentials.',
    boundary: 'Local and synthetic proof only. A local receipt is not remote verification or customer data access.',
    href: '/work/regulated-reporting-mcp/',
  },
];

const quietCases = [
  ['How I structure agent work', 'Architecture map · current practice', '/work/agent-operating-system/'],
  ['Stop recurring agent jobs from sending the same work twice', 'Deduplication · 19 tests', '/work/dedup-readback-bridge/'],
  ['Test a Hermes job without pretending the script approved it', 'Evaluation · offline proof', '/work/hermes-field-kit/'],
  ['Spreadsheet QA that reads back every fix', 'Readback · restore on mismatch', '/work/wingman/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="/styles/interstellar-system.css" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SecondaryMasthead context="Review mockup · customer work first" />
    <main id="main">
      <!--
        THESIS: Customer work leads; public engineering makes the method visible. Refuses the equal-weight card wall.
        OWN-WORLD: Interstellar carbon, warm-white Archivo, DM Mono annotations, ember rules, and quiet blue proof marks.
        STORY: A hiring reader sees the customer-delivery record, inspects two consequential public cases, then browses the rest.
        FIRST VIEWPORT: A left-weighted claim and right-weighted proof note, followed by two ruled flagship bands rather than cards.
        FORM: Editorial proof index, position 1, seed customer-work-first-20260821, extended from the established Interstellar route system.
        FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
      -->
      <section class="review-hero">
        <div class="wrap review-hero__grid">
          <div>
            <p class="mono review-label">Review direction · information architecture</p>
            <h1>Customer work first. Public engineering makes the method visible.</h1>
          </div>
          <div class="review-hero__note">
            <p class="mono">The visitor should know</p>
            <p>What Dave has owned with customers, what his newer public systems prove, and where the proof stops.</p>
            <a href="#flagships">Read the two flagship cases <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>

      <section class="record" aria-labelledby="record-heading">
        <div class="wrap record__grid">
          <div class="record__lead">
            <p class="mono">The delivery record</p>
            <h2 id="record-heading">A decade of implementation before the public labs.</h2>
          </div>
          <div class="record__copy">
            <p>I lead technical delivery across discovery, solution design, integration, adoption, and go-live. Finance and assurance are the deepest record; healthcare and public agent engineering show the range and the direction.</p>
            <div class="record__proof" aria-label="Delivery record summary">
              <p><strong>10+ years</strong><span>customer-facing enterprise delivery</span></p>
              <p><strong>Reporting · assurance · healthcare</strong><span>regulated workflow record</span></p>
              <p><strong>Public agent / MCP labs</strong><span>newer independent evidence</span></p>
            </div>
          </div>
        </div>
      </section>

      <section class="flagships" id="flagships" aria-labelledby="flagships-heading">
        <div class="wrap">
          <div class="section-intro">
            <div>
              <p class="mono">Two cases lead</p>
              <h2 id="flagships-heading">The operating judgment most relevant to enterprise deployment.</h2>
            </div>
            <p>Bounded authority, failure recovery, and honest readback—shown as inspectable work rather than a broad promise.</p>
          </div>

          <div class="flagship-list">
            {cases.map((item) => (
              <article class="flagship">
                <div class="flagship__rail">
                  <span class="flagship__number mono">{item.number}</span>
                  <span class="flagship__mark" aria-hidden="true"></span>
                  <span class="flagship__rail-label mono">{item.label}</span>
                </div>
                <div class="flagship__body">
                  <h3>{item.title}</h3>
                  <p class="flagship__summary">{item.summary}</p>
                  <dl class="flagship__facts">
                    <div><dt>Stakes</dt><dd>{item.stakes}</dd></div>
                    <div><dt>Decision</dt><dd>{item.decision}</dd></div>
                    <div><dt>Visible proof</dt><dd>{item.evidence}</dd></div>
                    <div><dt>Honest limit</dt><dd>{item.boundary}</dd></div>
                  </dl>
                  <a class="flagship__link" href={item.href}>Read the case <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="quiet-index" aria-labelledby="index-heading">
        <div class="wrap">
          <div class="section-intro section-intro--index">
            <div>
              <p class="mono">Quiet index</p>
              <h2 id="index-heading">The rest stays available without pretending every case has the same evidence.</h2>
            </div>
            <p>Each row names the method and the proof marker. Open a case for the full boundary.</p>
          </div>
          <ol class="case-index">
            {quietCases.map(([name, proof, href], index) => (
              <li>
                <a href={href}>
                  <span class="case-index__number mono">{String(index + 3).padStart(2, '0')}</span>
                  <span class="case-index__name">{name}</span>
                  <span class="case-index__proof">{proof}</span>
                  <span class="case-index__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="boundary-note"><strong>Evidence boundary.</strong> Customer-delivery examples describe scoped work from Dave’s implementation record; client data and private artifacts remain confidential. Public repositories are sanitized, independent engineering work published in August 2026—not client tenants, customer-production agent deployments, production-engineering tenure, or Nous/Hermes Enterprise affiliation.</p>
        </div>
      </section>

      <section class="review-close">
        <div class="wrap review-close__grid">
          <p class="mono">Next decision</p>
          <div>
            <h2>Does the evidence read faster this way?</h2>
            <p>This route is a review-only mockup. It changes no public route and is not a production recommendation yet.</p>
            <a href="/">Return to the live homepage <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--space); color: var(--warm); font-family: "Archivo Variable", system-ui, sans-serif; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--ember); outline-offset: 4px; }
  .wrap { width: min(100% - 48px, 1180px); margin-inline: auto; }
  .mono { font-family: "DM Mono", ui-monospace, monospace; font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; }
  .review-hero { min-height: 560px; display: grid; align-items: end; border-bottom: 1px solid var(--graphite); background: radial-gradient(ellipse at 88% 96%, rgba(255, 80, 5, .28), transparent 42%), linear-gradient(145deg, #0d0e13, #08090b 68%); }
  .review-hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(240px, .55fr); gap: clamp(32px, 8vw, 120px); align-items: end; padding: 88px 0 72px; }
  .review-label, .record__lead > .mono, .section-intro .mono, .review-close > .mono { color: var(--ember); margin: 0 0 18px; }
  h1, h2, h3 { margin: 0; font-weight: 650; letter-spacing: -.045em; line-height: 1.02; }
  h1 { max-width: 11ch; font-size: clamp(3.5rem, 8vw, 7.2rem); }
  h2 { max-width: 18ch; font-size: clamp(2.2rem, 4.8vw, 4.6rem); }
  h3 { max-width: 22ch; font-size: clamp(1.7rem, 3vw, 3rem); }
  .review-hero__note { max-width: 30ch; padding: 18px 0 0 20px; border-left: 1px solid var(--ember); color: var(--muted); }
  .review-hero__note .mono { margin: 0 0 12px; color: var(--warm); }
  .review-hero__note p:not(.mono) { margin: 0; font-size: 1.02rem; line-height: 1.55; }
  .review-hero__note a, .flagship__link, .review-close a { display: inline-flex; gap: 10px; align-items: center; margin-top: 24px; color: var(--warm); text-decoration: underline; text-decoration-color: var(--ember); text-underline-offset: 5px; }
  .record, .quiet-index { border-bottom: 1px solid var(--graphite); background: var(--space-2); }
  .record__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 8vw, 120px); padding: clamp(72px, 10vw, 132px) 0; }
  .record__lead h2 { max-width: 12ch; }
  .record__copy { max-width: 66ch; color: var(--muted); font-size: 1.04rem; line-height: 1.6; }
  .record__copy > p { margin: 0 0 34px; }
  .record__proof { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--graphite); }
  .record__proof p { margin: 0; padding: 18px 16px 0 0; border-right: 1px solid var(--graphite); }
  .record__proof p + p { padding-left: 16px; }
  .record__proof p:last-child { border-right: 0; }
  .record__proof strong, .record__proof span { display: block; }
  .record__proof strong { color: var(--warm); font-size: .88rem; line-height: 1.3; }
  .record__proof span { margin-top: 8px; font-size: .75rem; line-height: 1.35; }
  .flagships { padding: clamp(72px, 10vw, 132px) 0; border-bottom: 1px solid var(--graphite); background: #090a0c; }
  .section-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, .55fr); gap: 40px; align-items: end; margin-bottom: 52px; }
  .section-intro > p { max-width: 34ch; margin: 0; color: var(--muted); line-height: 1.55; }
  .flagship-list { border-top: 1px solid var(--graphite); }
  .flagship { display: grid; grid-template-columns: 190px minmax(0, 1fr); border-bottom: 1px solid var(--graphite); }
  .flagship__rail { position: relative; display: flex; flex-direction: column; gap: 18px; padding: 22px 22px 28px 0; border-right: 1px solid var(--graphite); color: var(--muted); }
  .flagship__number { color: var(--ember); }
  .flagship__mark { width: 12px; height: 12px; background: var(--ember); box-shadow: -4px 4px 0 var(--periwinkle); }
  .flagship__rail-label { max-width: 15ch; margin-top: auto; line-height: 1.5; }
  .flagship__body { padding: 36px 0 42px 40px; }
  .flagship__summary { max-width: 68ch; margin: 18px 0 34px; color: var(--warm); font-size: 1.05rem; line-height: 1.55; }
  .flagship__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; border-top: 1px solid var(--graphite); }
  .flagship__facts > div { padding: 18px 24px 4px 0; border-bottom: 1px solid var(--graphite); }
  .flagship__facts > div:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--graphite); }
  .flagship__facts dt { color: var(--ember); font: 500 .65rem/1.4 "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
  .flagship__facts dd { margin: 10px 0 0; color: var(--muted); font-size: .9rem; line-height: 1.5; }
  .flagship__link { margin-top: 28px; }
  .quiet-index { padding: clamp(72px, 10vw, 132px) 0; }
  .section-intro--index { margin-bottom: 42px; }
  .section-intro--index h2 { max-width: 21ch; }
  .case-index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--graphite); }
  .case-index li { border-bottom: 1px solid var(--graphite); }
  .case-index a { display: grid; grid-template-columns: 60px minmax(0, 1.25fr) minmax(150px, .7fr) 20px; gap: 20px; align-items: center; min-height: 82px; transition: background .18s ease, transform .18s ease; }
  .case-index a:hover, .case-index a:focus-visible { transform: translateX(6px); background: #101114; }
  .case-index__number { color: var(--ember); }
  .case-index__name { font-size: 1.08rem; font-weight: 600; }
  .case-index__proof { color: var(--muted); font-size: .82rem; }
  .case-index__arrow { color: var(--teal); font-size: 1.2rem; }
  .boundary-note { max-width: 78ch; margin: 42px 0 0; color: var(--muted); font-size: .78rem; line-height: 1.55; }
  .boundary-note strong { color: var(--warm); }
  .review-close { padding: clamp(72px, 10vw, 120px) 0; background: var(--warm); color: var(--space); }
  .review-close__grid { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 40px; }
  .review-close__grid > .mono { color: var(--ember); }
  .review-close h2 { max-width: 12ch; }
  .review-close p { max-width: 58ch; margin: 22px 0 0; color: #4e4a46; line-height: 1.55; }
  .review-close a { color: var(--space); }
  @media (max-width: 760px) {
    .wrap { width: min(100% - 28px, 1180px); }
    .review-hero { min-height: 0; }
    .review-hero__grid, .record__grid, .section-intro, .review-close__grid { grid-template-columns: 1fr; gap: 28px; }
    .review-hero__grid { padding: 62px 0 58px; }
    h1 { max-width: 12ch; font-size: clamp(3rem, 14vw, 5rem); }
    .review-hero__note { max-width: none; }
    .record__grid, .flagships, .quiet-index { padding-block: 72px; }
    .record__proof { grid-template-columns: 1fr; }
    .record__proof p, .record__proof p + p { padding: 16px 0; border-right: 0; border-bottom: 1px solid var(--graphite); }
    .record__proof p:last-child { border-bottom: 0; }
    .flagship { grid-template-columns: 1fr; }
    .flagship__rail { flex-direction: row; align-items: center; min-height: 66px; padding: 14px 0; border-right: 0; border-bottom: 1px solid var(--graphite); }
    .flagship__rail-label { max-width: none; margin: 0 0 0 auto; }
    .flagship__body { padding: 28px 0 34px; }
    .flagship__facts { grid-template-columns: 1fr; }
    .flagship__facts > div, .flagship__facts > div:nth-child(even) { padding: 16px 0 4px; border-left: 0; }
    .case-index a { grid-template-columns: 36px minmax(0, 1fr) 18px; gap: 12px; min-height: 76px; }
    .case-index__proof { grid-column: 2; grid-row: 2; font-size: .76rem; }
    .case-index__arrow { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
