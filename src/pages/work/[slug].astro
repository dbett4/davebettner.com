---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import EvidenceMotif from '../../components/EvidenceMotif.astro';
import RecoveryProofExplorer from '../../components/RecoveryProofExplorer.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { cases, type CaseStudy } from '../../data/cases';
import { provenanceNote } from '../../data/public-proof';
import { ogImagePath, siteUrl } from '../../data/seo';

export function getStaticPaths() {
  return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: CaseStudy };
const projectNames = {
  'agent-operating-system': 'Agent Operating System',
  'dedup-readback-bridge': 'Dedup Read-Back Bridge',
  'regulated-reporting-mcp': 'Regulated Reporting MCP',
  'hermes-deployment-lab': 'Hermes Deployment Lab',
  'hermes-field-kit': 'Hermes Enterprise Evaluation Kit',
  wingman: 'Confirm-before-write spreadsheet quality',
} as const;
const projectName = projectNames[item.id as keyof typeof projectNames];
const canonical = `${siteUrl}/work/${item.id}/`;
const title = `${projectName} | Dave Bettner`;
const independentEvidenceNote =
  item.id === 'hermes-deployment-lab' || item.id === 'hermes-field-kit' || item.id === 'agent-operating-system'
    ? 'The "Hermes" name in this project is Dave\u2019s own naming choice for independent, synthetic public engineering work. It is not a Nous Research product and implies no Nous/Hermes Enterprise affiliation.'
    : null;
const incidentNarrative = {
  'dedup-readback-bridge': {
    heading: 'The second run should have nothing new to send.',
    copy: 'Recurring agent jobs often see the same items again. Without a durable record and an atomic reservation, the next run can spend money twice or leave the operator guessing what happened.',
    steps: [['01', 'Receive', 'A run gets a batch of items.'], ['02', 'Reserve', 'Stable keys claim new work once.'], ['03', 'Process', 'The processor handles the reserved items.'], ['04', 'Record', 'The run leaves a read-back record.']],
  },
  wingman: {
    heading: 'A spreadsheet can tie out and still be wrong.',
    copy: 'A statement may balance while a formula, link, or mapping has drifted. The fix needs a confirmation gate, a saved prior state, and a readback that can restore the change when the result does not match.',
    steps: [['01', 'Detect', 'Find a suspicious formula or link.'], ['02', 'Classify', 'Separate a defect from an accounting judgment.'], ['03', 'Confirm', 'Show the user the narrow change.'], ['04', 'Restore', 'Read it back and reverse a mismatch.']],
  },
  'regulated-reporting-mcp': {
    heading: 'An agent can inherit every write in a reporting catalog.',
    copy: 'Connect an agent to a reporting platform the usual way and it can see the whole tool surface, including writes no one approved for the job. In a regulated reporting cycle, an unreviewed write can enter a filing package. That leaves a broken audit trail and a manual re-tie of the affected statements.',
    consequence: 'The safe default is a smaller surface: a few reviewed tools, a write that needs confirmation, a result read back from the platform, and a receipt with no client values.',
    steps: [['01', 'Narrow', 'Only three guarded tools are served by default.'], ['02', 'Confirm', 'A write is refused until it is explicitly confirmed.'], ['03', 'Read back', 'The result is fetched from the platform, not assumed.'], ['04', 'Redact', 'The receipt records the action without client values.']],
  },
  'hermes-field-kit': {
    heading: 'A green script is not a human decision.',
    copy: 'Many evaluation harnesses report a pass and stop. That becomes a problem when a run effectively signs itself off. The organization may think an agent is cleared for business use even though no accountable person reviewed it.',
    consequence: 'That can move a configuration toward approval or turn on a workflow before the first real failure has been found in evaluation.',
    steps: [['01', 'Qualify', 'The job is checked against a policy pack first.'], ['02', 'Bound', 'The run uses a pinned configuration.'], ['03', 'Check', 'Independent and negative tests inspect the result.'], ['04', 'Withhold', 'Weak evidence stays labeled weak and unaccepted.']],
  },
  'agent-operating-system': {
    heading: 'A good answer is not the same as a safe workflow.',
    copy: 'A model can produce useful work while the workflow around it lacks context routing, an authority boundary, a recovery path, and a record of what changed. The answer may look fine, but no one can explain the work afterward.',
    consequence: 'When that happens on business work, the cost is rework and lost trust: nobody can say which change was applied, who allowed it, or whether it was ever checked, so the whole run has to be redone by hand.',
    steps: [['01', 'Route', 'Context and capability are resolved before work starts.'], ['02', 'Bound', 'Tools and authority are scoped to the job.'], ['03', 'Recover', 'The hard path has a defined recovery, not a retry.'], ['04', 'Record', 'A receipt and an independent check close the loop.']],
  },
} as const;
const narrative = incidentNarrative[item.id as keyof typeof incidentNarrative];

type AcceptanceStep = readonly [string, string, string, string | null, string | null];
const acceptanceChains: Partial<Record<string, { lede: string; steps: readonly AcceptanceStep[] }>> = {
  'regulated-reporting-mcp': {
    lede: 'Nothing in this integration counts as done because the model said so. Each state has to be inspectable.',
    steps: [
      ['01', 'Scoped', 'Only three guarded tools are exposed by default; the larger registry has to be turned on deliberately.', item.repoUrl, 'Inspect repository ↗'],
      ['02', 'Changed', 'A write is refused until it is confirmed, so reading information cannot quietly trigger a change.', item.repoUrl, 'Inspect the write gate ↗'],
      ['03', 'Checked in the system', 'The result is fetched from the platform after the write. An uncertain formula result is reported as uncertain rather than guessed.', item.proofUrl ?? null, 'Open technical notes ↗'],
      ['04', 'Checked separately', 'Lint, a tool-contract check, the credential-free test suite, and an offline end-to-end demo inspect the same behavior.', item.proofUrl ?? null, 'Open proof ↗'],
      ['05', 'Decision', 'The offline proof passes for what it covers. A local action record does not prove a remote change, so live regulated writes still need review.', null, null],
    ],
  },
  'hermes-field-kit': {
    lede: 'The kit is designed so it cannot mark its own homework. The last state is allowed to stay unresolved.',
    steps: [
      ['01', 'Scoped', 'A plain-language job is checked against a policy pack and a fixed configuration before it runs.', item.repoUrl, 'Inspect repository ↗'],
      ['02', 'Run', 'The job stays inside those declared limits and takes no external action on anyone else’s system.', item.repoUrl, 'Inspect the policy packs ↗'],
      ['03', 'Recomputed', 'The action records are hash-checked and a separate calculation recomputes the result instead of trusting the run’s own summary.', item.proofUrl ?? null, 'Open the receipt checks ↗'],
      ['04', 'Challenged', 'Eight negative tests, a capability map with an explicit gap list, and a pinned suite replay inspect the same evidence.', item.proofUrl ?? null, 'Open proof ↗'],
      ['05', 'Decision', 'Offline proof passes. The live example remains in review because no person accepted it and two execution exceptions remain.', null, null],
    ],
  },
  'agent-operating-system': {
    lede: 'The other cases use this operating approach. This page describes what is adopted today, not everything the system may do later.',
    steps: [
      ['01', 'Scoped', 'A request is matched to the right context, tools, and authority before any action begins.', '/work/', 'Open the public work index ↗'],
      ['02', 'Run', 'The work is split into limited actions instead of one open-ended instruction.', '/work/hermes-deployment-lab/', 'Inspect the recovery lab ↗'],
      ['03', 'Checked in the system', 'A consequential change is checked where it actually lives, and the failure path has a recovery plan.', 'https://github.com/dbett4/hermes-enterprise-deployment-lab/blob/main/PROOF.md', 'Open the recovery proof ↗'],
      ['04', 'Checked separately', 'Public tests and separate checks inspect the deployment, integration, evaluation, and spreadsheet-quality examples.', 'https://github.com/dbett4/hermes-enterprise-evaluation-kit/blob/main/PROOF.md', 'Open the evaluation proof ↗'],
      ['05', 'Decision', 'Working controls are separated from ideas that are not wired yet. Unfinished controls stay labeled unfinished.', null, null],
    ],
  },
};
const acceptanceChain = acceptanceChains[item.id];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={item.summary} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F5F2EA" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles/working-record.css" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={item.summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImagePath}`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <section class="section case-cover" aria-labelledby="case-heading">
        <div class="wrap case-cover-grid">
          <div class="case-intro">
            <p class="eyebrow mono">{item.eyebrow}</p>
            <h1 id="case-heading">{item.title}</h1>
            <p class="case-headline">{projectName}</p>
            <p class="lead">{item.summary}</p>
            <p class="case-value-line"><strong class="mono">Why it matters</strong>{item.value}</p>
            <p class="case-actions">
              <a class="action action-primary" href={item.id === 'agent-operating-system' ? '/work/' : item.repoUrl} rel={item.id === 'agent-operating-system' ? undefined : 'noopener noreferrer'}>
                {item.id === 'agent-operating-system' ? 'Explore public evidence' : 'View repository'} <span aria-hidden="true">↗</span>
              </a>
              {item.id === 'agent-operating-system' ? <a class="action action-quiet" href={item.repoUrl} rel="noopener noreferrer">GitHub profile <span aria-hidden="true">↗</span></a> : null}
              {item.proofUrl ? (
                <a class="action action-quiet" href={item.proofUrl} rel="noopener noreferrer">View proof <span aria-hidden="true">↗</span></a>
              ) : null}
            </p>
          </div>
          <EvidenceMotif motif={item.motif} />
        </div>
      </section>

      <div class="wrap case-page">
        {item.id === 'hermes-deployment-lab' ? (
          <section class="incident-story" aria-labelledby="incident-heading">
            <p class="eyebrow mono">The incident</p>
            <h2 id="incident-heading">The difficult part is recovering a write you cannot confirm.</h2>
            <p class="lead">The tool may have finished the write. The coordinator failed before it got the confirmation. A blind retry could write the same change twice.</p>
            <ol class="incident-path evidence-motif" aria-label="Recovery path">
              {[
                ['01', 'Request', 'A bounded job starts.'],
                ['02', 'Action', 'The tool may finish the write.'],
                ['03', 'Unknown', 'The confirmation never arrives.'],
                ['04', 'Recovery', 'Look for the first result before retrying.'],
              ].map(([number, label, text]) => (
                <li class={label === 'Unknown' ? 'incident-step incident-step--risk' : 'incident-step'}>
                  <span class="mono">{number}</span><strong>{label}</strong><small>{text}</small>
                </li>
              ))}
            </ol>
            <p class="incident-consequence"><strong class="mono">Why it matters</strong> If the system treats unknown as failed, it can make the original problem worse. It needs to find the first result or stop for review.</p>
          </section>
        ) : null}

        {narrative ? (
          <section class="incident-story" aria-labelledby="incident-heading">
            <p class="eyebrow mono">The failure mode</p>
            <h2 id="incident-heading">{narrative.heading}</h2>
            <p class="lead">{narrative.copy}</p>
            <ol class="incident-path evidence-motif" aria-label="Control path">
              {narrative.steps.map(([number, label, text]) => (
                <li class="incident-step"><span class="mono">{number}</span><strong>{label}</strong><small>{text}</small></li>
              ))}
            </ol>
            {'consequence' in narrative && narrative.consequence ? (
              <p class="incident-consequence"><strong class="mono">Why it matters</strong> {narrative.consequence}</p>
            ) : null}
          </section>
        ) : null}

        {acceptanceChain ? (
          <section class="acceptance-chain" aria-labelledby="acceptance-heading">
            <p class="eyebrow mono">How I know it worked</p>
            <h2 id="acceptance-heading">The result has to be inspectable.</h2>
            <p class="lead">{acceptanceChain.lede}</p>
            <ol class="ruled-list acceptance-list">
              {acceptanceChain.steps.map(([number, state, text, link, linkLabel]) => (
                <li class="ruled-row evidence-row-grid">
                  <div class="evidence-row-meta">
                    <span class="mono">{number}</span>
                    <h3>{state}</h3>
                  </div>
                  <div class="evidence-row-body">
                    <p>{text}</p>
                    {link && linkLabel ? (
                      <a href={link} class="text-link" rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}>{linkLabel}</a>
                    ) : null}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        {item.id === 'hermes-deployment-lab' ? (
          <section class="acceptance-chain" aria-labelledby="acceptance-heading-recovery">
            <p class="eyebrow mono">How I know it worked</p>
            <h2 id="acceptance-heading-recovery">The result has to survive the failure.</h2>
            <p class="lead">The model can propose the next move. The run only advances when each control has evidence.</p>
            <ol class="ruled-list acceptance-list">
              {[
                ['01', 'Scoped', 'The job has one limited action and a named approval point.', item.repoUrl],
                ['02', 'Run', 'The tool makes one distinct attempt, not an open-ended retry.', null],
                ['03', 'Checked in the system', 'The workflow looks for the actual result instead of trusting a missing reply.', '#recovery-proof-heading'],
                ['04', 'Checked separately', 'Public tests force the same failure and inspect the result.', item.proofUrl],
                ['05', 'Decision', 'The result is accepted, blocked, or clearly left for review.', null],
              ].map(([number, heading, text, link]) => (
                <li class="ruled-row evidence-row-grid">
                  <div class="evidence-row-meta">
                    <span class="mono">{number}</span>
                    <h3>{heading}</h3>
                  </div>
                  <div class="evidence-row-body">
                    <p>{text}</p>
                    {link ? <a href={link} class="text-link" rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}>{heading === 'Checked separately' ? 'Open proof ↗' : heading === 'Checked in the system' ? 'See the recovery trace ↓' : 'Inspect repository ↗'}</a> : null}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        <section class="evidence-map" aria-labelledby="evidence-map-heading">
          <div class="evidence-heading">
            <p class="eyebrow mono" id="evidence-map-heading">Result and evidence</p>
            <p class="mono evidence-state">What worked · how checked · honest limit</p>
          </div>
          <h2 class="evidence-signal">{item.evidenceMap.signal}</h2>
          <p class="lead evidence-method">{item.evidenceMap.method}</p>
          {item.id === 'agent-operating-system' ? <p class="workflow-caption">A bounded change is confirmed, written, then read back before it counts as applied.</p> : null}
          <ol class="evidence-steps">
            {item.evidenceMap.steps.map((step, index) => <li><span class="mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{step}</li>)}
          </ol>
          <p class="evidence-boundary"><strong class="mono">Honest limit</strong>{item.evidenceMap.boundary}</p>
        </section>

        {item.id === 'hermes-deployment-lab' ? <RecoveryProofExplorer /> : null}

        {item.id === 'agent-operating-system' ? (
          <section class="stack-explainer" aria-labelledby="stack-explainer-heading">
            <p class="eyebrow mono">The whole workflow</p>
            <h2 id="stack-explainer-heading">The whole system, from request to proof.</h2>
            <p class="lead">The list below is an explanation, not a live feed. The linked repositories and upstream contributions are the places to inspect the underlying work.</p>
            <ol class="ruled-list stack-layers">
              {[
                ['01', 'You', 'Ask in plain language, watch the work, and approve at the decision gates.'],
                ['02', 'Coordinator', 'Routes the request, breaks it into bounded pieces, and tracks the job to a receipt.'],
                ['03', 'Team', 'Role-based agents handle product, authority, backend, UX, and independent verification; runtimes are chosen by fit.'],
                ['04', 'Guardrails', 'Changes are bounded, read back, independently checked, and recoverable when the hard path fails.'],
                ['05', 'Tools', 'APIs, reporting platforms, browsers, Git, memory, and other action surfaces carry the real work.'],
                ['06', 'Machines', 'A local-first execution plane, control terminal, model providers, and public repositories support the operation.'],
              ].map(([index, label, text]) => (
                <li class="ruled-row evidence-row-grid">
                  <div class="evidence-row-meta"><span class="mono">{index}</span><h3>{label}</h3></div>
                  <div class="evidence-row-body"><p>{text}</p></div>
                </li>
              ))}
            </ol>
            <p class="stack-proof">
              <strong class="mono">Where to check</strong>
              The public deployment lab, reporting MCP, evaluation kit, and Wingman repository show bounded tools, recovery, readback, and human gates. Upstream contributions show work on real agent infrastructure: coordinated rate-limit retries and desktop session recovery.
            </p>
            <p class="stack-links">
              <a class="text-link" href="https://github.com/block/buzz/pull/5620" rel="noopener noreferrer">Buzz PR #5620 ↗</a>
              <a class="text-link" href="https://github.com/NousResearch/hermes-agent/pull/84621" rel="noopener noreferrer">Hermes Agent PR #84621 ↗</a>
            </p>
          </section>
        ) : null}

        <section class="case-detail" aria-labelledby="case-detail-heading">
          <p class="eyebrow mono">What I owned</p>
          <h2 id="case-detail-heading">The problem, the build, and the limits.</h2>
          <dl class="case-list">
            <dt>Problem</dt><dd>{item.constraint}</dd>
            <dt>What I built</dt><dd>{item.built}</dd>
            <dt>My role</dt><dd>{item.role}</dd>
            <dt>What stays human</dt><dd>{item.boundary}</dd>
            <dt>Public proof</dt><dd>{item.evidence}</dd>
            <dt>Scope</dt><dd>{item.scope}</dd>
          </dl>
        </section>

        {independentEvidenceNote ? <p class="independent-note muted">{independentEvidenceNote}</p> : null}

        <details class="provenance-note">
          <summary>How to read the public proof and its limits</summary>
          <p class="muted">{provenanceNote}</p>
        </details>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .case-cover-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4) var(--gutter);
    align-items: start;
  }

  .case-intro {
    grid-column: 1 / 8;
    min-width: 0;
  }

  .case-cover-grid > .evidence-motif {
    grid-column: 8 / 13;
  }

  .case-headline {
    font-weight: 650;
    margin: 4px 0 var(--space-2);
  }

  .case-value-line {
    border-top: 1px solid var(--orange);
    padding-top: var(--space-2);
    margin-top: var(--space-2);
    max-width: 60ch;
  }

  .case-value-line strong {
    display: block;
    color: var(--orange-dark);
    margin-bottom: 4px;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .case-page {
    padding-block: var(--space-5);
    max-width: 900px;
  }

  .case-page > * + * {
    margin-top: var(--space-5);
  }

  .incident-story,
  .acceptance-chain,
  .evidence-map,
  .stack-explainer,
  .case-detail {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-3);
  }

  .incident-path {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  .incident-path li {
    border: 0;
    border-right: 1px solid var(--rule);
    padding: var(--space-2);
  }

  .incident-path li:last-child {
    border-right: 0;
  }

  .incident-path .mono {
    display: block;
    color: var(--orange-dark);
    margin-bottom: var(--space-2);
  }

  .incident-path strong {
    display: block;
    margin-bottom: 6px;
  }

  .incident-path small {
    display: block;
    color: #4b4b46;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .incident-step--risk .mono,
  .incident-step--risk strong {
    color: var(--orange-dark);
  }

  .incident-consequence {
    margin-top: var(--space-3);
    border-top: 1px solid var(--orange);
    padding-top: var(--space-2);
    max-width: 64ch;
  }

  .incident-consequence strong {
    display: block;
    color: var(--orange-dark);
    margin-bottom: 4px;
  }

  .acceptance-list h3 {
    margin-bottom: 4px;
  }

  .evidence-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }

  .evidence-state {
    color: #4b4b46;
  }

  .evidence-signal {
    margin-top: var(--space-2);
  }

  .evidence-method {
    margin-top: var(--space-2);
  }

  .workflow-caption {
    border-top: 1px solid var(--orange);
    padding-top: var(--space-2);
    margin-top: var(--space-2);
    font-weight: 650;
  }

  .evidence-steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .evidence-steps li {
    flex: 1 1 140px;
    border: 1px solid var(--ink);
    padding: 10px 12px;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .evidence-steps li .mono {
    display: block;
    color: var(--orange-dark);
    margin-bottom: 6px;
  }

  .evidence-boundary {
    border-top: 2px solid var(--orange);
    padding-top: var(--space-2);
    margin-top: var(--space-3);
    max-width: 64ch;
  }

  .evidence-boundary strong {
    display: block;
    color: var(--orange-dark);
    margin-bottom: 4px;
  }

  .stack-layers .mono {
    color: var(--orange-dark);
  }

  .stack-proof {
    margin-top: var(--space-3);
    border: 1px solid var(--ink);
    background: var(--paper-alt);
    padding: var(--space-3);
    max-width: 78ch;
  }

  .stack-proof strong {
    display: block;
    color: var(--orange-dark);
    margin-bottom: 6px;
  }

  .stack-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-2);
  }

  .case-list {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 160px 1fr;
    font-size: 0.92rem;
  }

  .case-list dt,
  .case-list dd {
    border-top: 1px solid var(--rule);
    padding: var(--space-2) 0;
  }

  .case-list dt {
    color: #4b4b46;
    padding-right: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .independent-note {
    max-width: 72ch;
    font-size: 0.82rem;
    line-height: 1.5;
    border-top: 1px solid var(--rule);
    padding-top: var(--space-2);
  }

  .contact-block {
    border: 1px solid var(--ink);
    background: var(--paper-alt);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .contact-block .action {
    justify-self: start;
  }

  .provenance-note {
    max-width: 82ch;
  }

  .provenance-note summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--orange-dark);
  }

  .provenance-note p {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .case-intro,
