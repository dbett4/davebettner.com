---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import EvidenceMotif from '../../components/EvidenceMotif.astro';
import RecoveryProofExplorer from '../../components/RecoveryProofExplorer.astro';
import SecondaryMasthead from '../../components/SecondaryMasthead.astro';
import { cases, type CaseStudy } from '../../data/cases';
import { provenanceNote } from '../../data/public-proof';
import { siteUrl } from '../../data/seo';
import { emailHref } from '../../data/site-links';

export function getStaticPaths() {
  return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: CaseStudy };
const projectNames = {
  'agent-operating-system': 'Agent Operating System',
  'dedup-readback-bridge': 'Dedup Read-Back Bridge',
  'regulated-reporting-mcp': 'Regulated Reporting MCP',
  'hermes-deployment-lab': 'Hermes Deployment Lab',
  'hermes-field-kit': 'Hermes Enterprise Evaluation Kit',
  wingman: 'Confirm-before-write spreadsheet quality',
} as const;
const projectName = projectNames[item.id as keyof typeof projectNames];
const plateNumber = String(cases.findIndex((candidate) => candidate.id === item.id) + 1).padStart(2, '0');
const canonical = `${siteUrl}/work/${item.id}/`;
const title = `${projectName} | Dave Bettner`;
const incidentNarrative = {
  'dedup-readback-bridge': {
    heading: 'The second run should have nothing new to send.',
    copy: 'Recurring agent jobs often see the same items again. Without a durable record and an atomic reservation, the next run can spend money twice or leave the operator guessing what happened.',
    steps: [['01', 'Receive', 'A run gets a batch of items.'], ['02', 'Reserve', 'Stable keys claim new work once.'], ['03', 'Process', 'The processor handles the reserved items.'], ['04', 'Record', 'The run leaves a read-back record.']],
  },
  wingman: {
    heading: 'A spreadsheet can tie out and still be wrong.',
    copy: 'A statement may balance while a formula, link, or mapping has drifted. The fix needs a confirmation gate, a saved prior state, and a readback that can restore the change when the result does not match.',
    steps: [['01', 'Detect', 'Find a suspicious formula or link.'], ['02', 'Classify', 'Separate a defect from an accounting judgment.'], ['03', 'Confirm', 'Show the user the narrow change.'], ['04', 'Restore', 'Read it back and reverse a mismatch.']],
  },
  'regulated-reporting-mcp': {
    heading: 'An agent can inherit every write in a reporting catalog.',
    copy: 'Connect an agent to a reporting platform the usual way and it can see the whole tool surface, including writes no one approved for the job. In a regulated reporting cycle, an unreviewed write can enter a filing package. That leaves a broken audit trail and a manual re-tie of the affected statements.',
    consequence: 'The safe default is a smaller surface: a few reviewed tools, a write that needs confirmation, a result read back from the platform, and a receipt with no client values.',
    steps: [['01', 'Narrow', 'Only three guarded tools are served by default.'], ['02', 'Confirm', 'A write is refused until it is explicitly confirmed.'], ['03', 'Read back', 'The result is fetched from the platform, not assumed.'], ['04', 'Redact', 'The receipt records the action without client values.']],
  },
  'hermes-field-kit': {
    heading: 'A green script is not a human decision.',
    copy: 'Many evaluation harnesses report a pass and stop. That becomes a problem when a run effectively signs itself off. The organization may think an agent is cleared for business use even though no accountable person reviewed it.',
    consequence: 'That can move a configuration toward approval or turn on a workflow before the first real failure has been found in evaluation.',
    steps: [['01', 'Qualify', 'The job is checked against a policy pack first.'], ['02', 'Bound', 'The run uses a pinned, approved configuration.'], ['03', 'Check', 'Independent and negative tests inspect the result.'], ['04', 'Withhold', 'Weak evidence stays labeled weak and unaccepted.']],
  },
  'agent-operating-system': {
    heading: 'A good answer is not the same as a safe workflow.',
    copy: 'A model can produce useful work while the workflow around it lacks context routing, an authority boundary, a recovery path, and a record of what changed. The answer may look fine, but no one can explain the work afterward.',
    consequence: 'When that happens on business work, the cost is rework and lost trust: nobody can say which change was applied, who allowed it, or whether it was ever checked, so the whole run has to be redone by hand.',
    steps: [['01', 'Route', 'Context and capability are resolved before work starts.'], ['02', 'Bound', 'Tools and authority are scoped to the job.'], ['03', 'Recover', 'The hard path has a defined recovery, not a retry.'], ['04', 'Record', 'A receipt and an independent check close the loop.']],
  },
} as const;
const narrative = incidentNarrative[item.id as keyof typeof incidentNarrative];

type AcceptanceStep = readonly [string, string, string, string | null, string | null];
const acceptanceChains: Partial<Record<string, { lede: string; steps: readonly AcceptanceStep[] }>> = {
  'regulated-reporting-mcp': {
    lede: 'Nothing in this integration counts as done because the model said so. Each state has to be inspectable.',
    steps: [
      ['01', 'Allowed', 'Only three guarded tools are exposed by default; the full registry requires an explicit unsafe opt-in.', item.repoUrl, 'Inspect repository ↗'],
      ['02', 'Applied', 'A write is gated in code and refused until it is confirmed, so no action happens as a side effect of a read.', item.repoUrl, 'Inspect the write gate ↗'],
      ['03', 'Read back', 'The result is fetched from the platform after the write; an uncertain formula result is reported as indeterminate rather than guessed.', item.proofUrl ?? null, 'Open technical notes ↗'],
      ['04', 'Independently checked', 'Lint, a tool-contract manifest check, the credential-free pytest suite, and an offline end-to-end demo run without any credentials.', item.proofUrl ?? null, 'Open proof ↗'],
      ['05', 'Accepted / needs_review', 'The offline proof is accepted for what it covers. A local write receipt is not treated as remote verification, so live regulated writes stay needs_review.', null, null],
    ],
  },
  'hermes-field-kit': {
    lede: 'The kit is designed so it cannot mark its own homework. The last state is allowed to stay unresolved.',
    steps: [
      ['01', 'Allowed', 'A plain-language job is qualified against a policy pack and a pinned, approved configuration before it runs.', item.repoUrl, 'Inspect repository ↗'],
      ['02', 'Applied', 'The run executes inside those bounds, with no external action taken on anyone else’s system.', item.repoUrl, 'Inspect the policy packs ↗'],
      ['03', 'Read back', 'Receipts are hash-checked and a deterministic oracle recomputes the result instead of reading the run’s own summary.', item.proofUrl ?? null, 'Open the receipt checks ↗'],
      ['04', 'Independently checked', 'Eight negative tests, a capability map with an explicit gap list, and a pinned v2026.8.3 suite replay check the same evidence.', item.proofUrl ?? null, 'Open proof ↗'],
      ['05', 'Accepted / needs_review', 'Offline proof passes. The one live one-shot has native CLI attestation and an oracle pass but remains needs_review: no human disposition, an estimated rather than billed cost, and two recorded execution-time exceptions.', null, null],
    ],
  },
  'agent-operating-system': {
    lede: 'The other cases use this operating approach. This page describes what is adopted today, not everything the system may do later.',
    steps: [
      ['01', 'Allowed', 'A request is routed to context, capability, and an authority boundary before any tool is used.', '/work/', 'Open the public evidence index ↗'],
      ['02', 'Applied', 'Work runs as bounded pieces through scoped tools rather than as one open-ended action.', '/work/hermes-deployment-lab/', 'Inspect the bounded-action lab ↗'],
      ['03', 'Read back', 'A consequential change is read back from the system that holds it, and recovery is defined for the hard path.', 'https://github.com/dbett4/hermes-enterprise-deployment-lab/blob/main/PROOF.md', 'Open the recovery proof ↗'],
      ['04', 'Independently checked', 'The verifier is never the builder. The public deployment, MCP, evaluation, and spreadsheet-quality cases each carry their own external proof.', 'https://github.com/dbett4/hermes-enterprise-evaluation-kit/blob/main/PROOF.md', 'Open independent-check proof ↗'],
      ['05', 'Accepted / needs_review', 'Adopted capabilities are separated from target doctrine. Controls that are not fully wired are held as needs_review, not described as production behavior.', null, null],
    ],
  },
};
const acceptanceChain = acceptanceChains[item.id];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={item.summary} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles/interstellar-system.css" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={item.summary} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SecondaryMasthead backHref="/work/" backLabel="Evidence index" context="Case study · public proof" />
    <main id="main">
      <section class={`case-cover visual-${item.visual}`}>
        <div class="wrap case-cover-grid route-intro">
          <div class="case-intro">
            {item.id === 'agent-operating-system' ? <p class="author-line mono">Designed and operated by Dave Bettner · Forward-deployed technical leader</p> : null}
            <p class="eyebrow mono">{item.eyebrow}</p>
            <h1>{projectName}</h1>
            <p class="case-headline">{item.title}</p>
            <p class="summary">{item.summary}</p>
            <p class="repo-links">
              <a class="round blue" href={item.id === 'agent-operating-system' ? '/work/' : item.repoUrl} rel={item.id === 'agent-operating-system' ? undefined : 'noopener noreferrer'} data-shader-host><span data-shader-label>{item.id === 'agent-operating-system' ? 'Explore public evidence' : 'View repository'} <span aria-hidden="true">↗</span></span></a>
              {item.id === 'agent-operating-system' ? <a class="round" href={item.repoUrl} rel="noopener noreferrer">GitHub profile <span aria-hidden="true">↗</span></a> : null}
              {item.id === 'agent-operating-system' ? <a class="round" href="/dave-bettner-resume.pdf" download>Résumé <span aria-hidden="true">↓</span></a> : null}
              {item.proofUrl ? (
                <a class="round" href={item.proofUrl} rel="noopener noreferrer">Technical notes <span aria-hidden="true">↗</span></a>
              ) : null}
            </p>
          </div>
          <div class="case-plate" aria-hidden="true">
            <EvidenceMotif motif={item.motif} />
            <span class="plate-chrome mono">WORKFLOW · {plateNumber}</span>
            <span class="plate-mark"></span>
            <span class="plate-proof mono">{item.plateProof}</span>
          </div>
        </div>
      </section>

      <div class="wrap case-page">
        {item.id === 'hermes-deployment-lab' ? (
          <section class="incident-story" aria-labelledby="incident-heading">
            <div class="incident-heading">
              <p class="mono">The incident</p>
              <h2 id="incident-heading">The difficult part is recovering a write you cannot confirm.</h2>
              <p>The tool may have finished the write. The coordinator failed before it got the confirmation. A blind retry could write the same change twice.</p>
            </div>
            <ol class="incident-path" aria-label="Recovery path">
              {[
                ['01', 'Request', 'A bounded job starts.'],
                ['02', 'Action', 'The tool may finish the write.'],
                ['03', 'Unknown', 'The confirmation never arrives.'],
                ['04', 'Recovery', 'Look for the first result before retrying.'],
              ].map(([number, label, text]) => (
                <li class={label === 'Unknown' ? 'incident-step incident-step--risk' : 'incident-step'}>
                  <span class="mono">{number}</span><strong>{label}</strong><small>{text}</small>
                </li>
              ))}
            </ol>
            <div class="incident-consequence">
              <span class="mono">Why it matters</span>
              <p>If the system treats unknown as failed, it can make the original problem worse. It needs to find the first result or stop for review.</p>
            </div>
          </section>
        ) : null}

        {narrative ? (
          <section class="incident-story" aria-labelledby="incident-heading">
            <div class="incident-heading">
              <p class="mono">The failure mode</p>
              <h2 id="incident-heading">{narrative.heading}</h2>
              <p>{narrative.copy}</p>
            </div>
            <ol class="incident-path" aria-label="Control path">
              {narrative.steps.map(([number, label, text]) => (
                <li class="incident-step"><span class="mono">{number}</span><strong>{label}</strong><small>{text}</small></li>
              ))}
            </ol>
            {'consequence' in narrative && narrative.consequence ? (
              <div class="incident-consequence">
                <span class="mono">Why it matters</span>
                <p>{narrative.consequence}</p>
              </div>
            ) : null}
          </section>
        ) : null}

        {acceptanceChain ? (
          <section class="acceptance-chain" aria-labelledby="acceptance-heading">
            <div class="detail-head">
              <p class="eyebrow mono">Acceptance chain</p>
              <h2 id="acceptance-heading">What counts as accepted.</h2>
              <p class="acceptance-lede">{acceptanceChain.lede}</p>
            </div>
            <ol class="acceptance-list">
              {acceptanceChain.steps.map(([number, state, text, link, linkLabel]) => (
                <li>
                  <span class="mono">{number}</span>
                  <div>
                    <h3>{state}</h3>
                    <p>{text}</p>
                    {link && linkLabel ? (
                      <a href={link} class="acceptance-link" rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}>{linkLabel}</a>
                    ) : null}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        {item.id === 'hermes-deployment-lab' ? (
          <section class="acceptance-chain" aria-labelledby="acceptance-heading">
            <div class="detail-head">
              <p class="eyebrow mono">Acceptance path</p>
              <h2 id="acceptance-heading">What counts as accepted.</h2>
              <p class="acceptance-lede">The model can propose the next move. The run only advances when each control has evidence.</p>
            </div>
            <ol class="acceptance-list">
              {[
                ['01', 'Allowed', 'The run has a bounded action and a named approval boundary.', item.repoUrl],
                ['02', 'Applied', 'The tool call has a distinct effect, not an open-ended retry.', null],
                ['03', 'Read back', 'The system checks the external result instead of trusting the response.', '#recovery-proof-heading'],
                ['04', 'Checked', 'Independent tests and verification inspect the same evidence.', item.proofUrl],
                ['05', 'Disposition', 'The result is accepted, blocked, or left needs_review.', null],
              ].map(([number, title, text, link]) => (
                <li>
                  <span class="mono">{number}</span>
                  <div><h3>{title}</h3><p>{text}</p>{link ? <a href={link} class="acceptance-link" rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}>{title === 'Checked' ? 'Open proof ↗' : title === 'Read back' ? 'See the recovery trace ↓' : 'Inspect repository ↗'}</a> : null}</div>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        <section class="evidence-map" aria-labelledby="evidence-map-heading">
          <div class="evidence-heading">
            <p class="mono evidence-map-label" id="evidence-map-heading">Evidence map</p>
            <p class="mono evidence-state">Method → proof → boundary</p>
          </div>
          <h2 class="evidence-signal">{item.evidenceMap.signal}</h2>
          <p class="evidence-method">{item.evidenceMap.method}</p>
          {item.id === 'agent-operating-system' ? <p class="workflow-caption">A bounded change is confirmed, written, then read back before it counts as applied.</p> : null}
          <ol class="evidence-steps">
            {item.evidenceMap.steps.map((step) => <li>{step}</li>)}
          </ol>
          <div class="evidence-boundary">
            <span class="mono">Boundary</span>
            <p>{item.evidenceMap.boundary}</p>
          </div>
        </section>

        {item.id === 'hermes-deployment-lab' ? <RecoveryProofExplorer /> : null}

        {item.id === 'agent-operating-system' ? (
          <section class="stack-explainer" aria-labelledby="stack-explainer-heading">
            <div class="detail-head">
              <p class="eyebrow mono">The Stack · plain-language view</p>
              <h2 id="stack-explainer-heading">The whole system, from request to proof.</h2>
              <p class="stack-lede">The animation is an explanation, not a live feed. The linked repositories and upstream contributions are the places to inspect the underlying work.</p>
            </div>
            <div class="stack-layers">
              {[
                ['01', 'You', 'Ask in plain language, watch the work, and approve at the decision gates.'],
                ['02', 'Coordinator', 'Routes the request, breaks it into bounded pieces, and tracks the job to a receipt.'],
                ['03', 'Team', 'Role-based agents handle product, authority, backend, UX, and independent verification; runtimes are chosen by fit.'],
                ['04', 'Guardrails', 'Changes are bounded, read back, independently checked, and recoverable when the hard path fails.'],
                ['05', 'Tools', 'APIs, reporting platforms, browsers, Git, memory, and other action surfaces carry the real work.'],
                ['06', 'Machines', 'A local-first execution plane, control terminal, model providers, and public repositories support the operation.'],
              ].map(([index, label, text]) => (
                <article class="stack-layer">
                  <span class="mono">{index}</span>
                  <h3>{label}</h3>
                  <p>{text}</p>
                </article>
              ))}
            </div>
            <div class="stack-proof">
              <p class="mono">Where to check</p>
              <p>The public deployment lab, reporting MCP, evaluation kit, and Wingman repository show bounded tools, recovery, readback, and human gates. Upstream contributions show work on real agent infrastructure: coordinated rate-limit retries and desktop session recovery.</p>
              <p class="stack-links"><a href="https://github.com/block/buzz/pull/5620" rel="noopener noreferrer">Buzz PR #5620 ↗</a><a href="https://github.com/NousResearch/hermes-agent/pull/84621" rel="noopener noreferrer">Hermes Agent PR #84621 ↗</a></p>
            </div>
          </section>
        ) : null}

        <section class="case-detail" aria-labelledby="case-detail-heading">
          <div class="detail-head">
            <p class="eyebrow mono">Build record</p>
            <h2 id="case-detail-heading">What the workflow records.</h2>
          </div>
          <dl class="case-list">
            <dt>Constraint</dt><dd>{item.constraint}</dd>
            <dt>Built</dt><dd>{item.built}</dd>
            <dt>Role</dt><dd>{item.role}</dd>
            <dt>Human boundary</dt><dd>{item.boundary}</dd>
            <dt>Evidence</dt><dd>{item.evidence}</dd>
            <dt>Scope</dt><dd>{item.scope}</dd>
          </dl>
        </section>
        <section class="contact-block" aria-labelledby="contact-heading">
          <p class="mono">Next</p>
          <h2 id="contact-heading">Need this kind of deployment rigor?</h2>
          <a class="round blue contact-link" href={emailHref} data-shader-host><span data-shader-label>Get in touch <span aria-hidden="true">↗</span></span></a>
        </section>
        <p class="provenance-note">{provenanceNote}</p>
      </div>
    </main>
    <script is:inline type="module" src="/interstellar.js"></script>
  </body>
</html>

<style is:global>
  :root{--max:1280px}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:"Archivo Variable",system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.45;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  .skip-link{position:fixed;left:16px;top:16px;z-index:1000;background:var(--ink);color:var(--paper);padding:12px 16px;transform:translateY(-200%)}
  .skip-link:focus{transform:none}
  .mono{font-family:"DM Mono",monospace;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}
  .wrap{width:min(var(--max),calc(100% - 52px));margin-inline:auto}
  .page-mast{position:sticky;top:0;z-index:10;background:var(--paper);border-bottom:1px solid var(--ink)}
  .mast-row{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .mast-status{color:var(--muted)}
  .case-cover{border-bottom:1px solid var(--ink);background:linear-gradient(90deg,transparent 79px,rgba(201,195,181,.32) 79px 80px,transparent 80px),var(--paper)}
  .case-cover-grid{padding:clamp(40px,6vw,88px) 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.78fr);gap:40px;align-items:center}
  .case-page{padding:clamp(48px,6vw,88px) 0 100px;max-width:900px}
  .back-link{display:inline-flex;align-items:center;min-height:44px;color:var(--muted)}
  .back-link:hover{color:var(--ink)}
  .eyebrow{color:var(--orange-ink);margin-bottom:18px}.author-line{color:var(--muted);font-size:.62rem;margin-bottom:18px}
  h1{font-family:"Archivo Variable",system-ui,sans-serif;font-size:clamp(2.8rem,6vw,4.8rem);font-weight:700;line-height:1.02;letter-spacing:-.04em;margin-bottom:20px}
  .case-headline{font-family:"Archivo Variable",system-ui,sans-serif;font-size:clamp(1.25rem,2.4vw,1.8rem);font-weight:600;line-height:1.16;max-width:760px;margin:-4px 0 14px;color:var(--ink)}
  .summary{color:var(--muted);font-size:1.05rem;max-width:620px;margin-bottom:20px}
  .repo-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
  .provenance-note{margin-top:32px;max-width:620px;font-size:.82rem;line-height:1.5;color:var(--muted)}
  .case-plate{position:relative;min-height:360px;border:1px solid var(--ink);overflow:hidden;background:var(--ink);isolation:isolate}
  .plate-chrome,.plate-proof{position:absolute;background:var(--ink);color:var(--paper);padding:6px 7px;font-size:.62rem}
  .plate-chrome{top:12px;left:12px}.plate-proof{right:12px;bottom:12px}.plate-mark{position:absolute;top:12px;right:12px;width:10px;height:10px;background:var(--orange);box-shadow:-3px 3px 0 var(--blue)}
  .evidence-map{border:1px solid var(--ink);padding:24px 22px 20px;margin-bottom:64px;background:radial-gradient(circle,rgba(33,79,229,.16) 0 1px,transparent 1.4px),var(--paper);background-size:8px 8px}
  .incident-story{border:1px solid #34353a;padding:clamp(22px,4vw,40px);margin-bottom:64px;background:#101114;color:#f2eadf}
  .incident-heading{max-width:670px}.incident-heading>.mono{color:var(--orange);margin-bottom:12px}.incident-heading h2{font-family:"Archivo Variable",system-ui,sans-serif;font-size:clamp(1.8rem,4vw,3rem);line-height:1.02;letter-spacing:-.04em;margin-bottom:14px}.incident-heading p{color:#c9c3b5;max-width:58ch;line-height:1.5}
  .incident-path{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin:32px 0 0;padding:0;border-top:1px solid #45464b;border-bottom:1px solid #45464b}.incident-step{position:relative;min-height:148px;padding:16px 14px 18px 0;border-right:1px solid #45464b}.incident-step:not(:first-child){padding-left:14px}.incident-step:last-child{border-right:0}.incident-step>.mono{display:block;color:var(--tide);font-size:.62rem;margin-bottom:28px}.incident-step strong{display:block;font-size:1rem;margin-bottom:7px}.incident-step small{display:block;color:#c9c3b5;font-size:.76rem;line-height:1.4}.incident-step--risk>.mono,.incident-step--risk strong{color:var(--orange)}
  .incident-consequence{border-left:2px solid var(--orange);padding:10px 0 10px 14px;margin-top:24px;max-width:640px}.incident-consequence .mono{display:block;color:var(--orange);font-size:.62rem;margin-bottom:6px}.incident-consequence p{font-size:.88rem;font-weight:600;line-height:1.45}
  .acceptance-chain{border-top:2px solid var(--blue);padding-top:20px;margin-bottom:64px}.acceptance-lede{max-width:620px;color:var(--muted);font-size:.9rem}.acceptance-list{list-style:none;border-top:1px solid var(--rule);margin-top:24px}.acceptance-list li{display:grid;grid-template-columns:42px minmax(0,1fr);gap:18px;padding:16px 0;border-bottom:1px solid var(--rule)}.acceptance-list li>.mono{color:var(--blue);padding-top:3px}.acceptance-list h3{font-size:1rem;margin-bottom:4px}.acceptance-list p{color:var(--muted);font-size:.82rem;line-height:1.45}
  .acceptance-link{display:inline-flex;margin-top:8px;color:var(--blue);font-family:"DM Mono",monospace;font-size:.62rem;text-decoration:underline;text-underline-offset:4px}
