---
import '@fontsource-variable/archivo/wdth.css'; import '@fontsource/dm-mono/400.css'; import SecondaryMasthead from '../../components/SecondaryMasthead.astro'; import { cases } from '../../data/cases'; import ContactLinks from '../../components/ContactLinks.astro';
import { siteUrl } from '../../data/seo';
const featuredIds=['hermes-deployment-lab','regulated-reporting-mcp']; const featured=featuredIds.map(id=>cases.find(c=>c.id===id)!); const indexCases=cases.filter(c=>!featuredIds.includes(c.id));
const title = 'Work | Dave Bettner';
const description =
  'Public engineering work from Dave Bettner: recovery after a failed write and a guarded reporting integration, plus additional public labs and their proof.';
const canonical = `${siteUrl}/work/`;
const boundary='Client work stays private. These repositories are independent labs and sanitized extracts published in August 2026. They are not client deployments, production tenure, or a Nous affiliation. GitHub dates show when I published the work.';
const flagshipPresentation: Record<string,{title:string;artifact:string;alt:string;caption:string;problem:string;built:string;evidence:string;limit:string}>={
  'hermes-deployment-lab':{title:'When the write succeeds but the response fails',artifact:'/mockup-artifacts/deployment-recovery-receipt.svg',alt:'Deployment recovery receipt with approval and idempotent resume',caption:'The same idempotency key prevents a duplicate after the failed response.',problem:'The API may commit a write and then fail before the caller gets a response. Retrying blindly can create a duplicate.',built:'I built a synthetic API and workflow runner that pauses for operator approval. After the simulated post-commit failure, it resumes with the same idempotency key.',evidence:'Public Actions run 31892965924 covers restart and replay, telemetry, a fresh-clone run, and 241 credential-free tests.',limit:'Synthetic lab, not a client tenant or model-driven production run. The cloud configuration is validate-only.'},
  'regulated-reporting-mcp':{title:'Three guarded tools by default',artifact:'/mockup-artifacts/regulated-reporting-contract.svg',alt:'Regulated reporting contract manifest showing guarded tools and readback',caption:'The default surface exposes three guarded operations.',problem:'A reporting tool can change a remote system. The safe version should make confirmation and readback hard to bypass.',built:'I kept the default surface to three guarded tools. Writes require confirmation, results are read back, receipts are redacted, and uncertain formula results stay uncertain.',evidence:'The repository has 126 credential-free tests and 117 registered tool contracts. Its offline demo runs without credentials.',limit:'Local proof only. A local receipt does not prove that a remote write was verified.'},
};
const indexTitles: Record<string,string>={
  'agent-operating-system':'Agent operating system',
  'dedup-readback-bridge':'Dedup read-back bridge',
  'hermes-field-kit':'Hermes evaluation kit',
  wingman:'Wingman spreadsheet QA',
};
const indexProof: Record<string,string>={
  'agent-operating-system':'Architecture map and public case index',
  'dedup-readback-bridge':'19 tests and a runnable CLI demo',
  'hermes-field-kit':'Offline proof and eight negative tests',
  wingman:'462 Python tests and 243 extension tests',
};
---
<!doctype html><html lang="en"><head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="robots" content="index, follow"/>
  <meta name="theme-color" content="#08090b"/>
  <meta name="color-scheme" content="dark"/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="stylesheet" href="/styles/interstellar-system.css"/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og.jpg`}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <title>{title}</title>
</head><body><a class="skip-link" href="#main">Skip to content</a><SecondaryMasthead context="Work · public proof"/><main id="main"><section class="route-intro"><div class="wrap content-page"><h1>Start with the work that best shows how I think.</h1><p class="lead">Both projects deal with a write that can affect another system. One handles recovery after a failed response. The other narrows the tool surface and checks the result. The rest is in the index below.</p></div></section><section class="work-section"><div class="wrap content-page"><div class="flagship-stack">{featured.map((item)=><article class="flagship" id={item.id}><figure class="flagship-art"><a href={flagshipPresentation[item.id].artifact} target="_blank" rel="noopener"><img src={flagshipPresentation[item.id].artifact} alt={flagshipPresentation[item.id].alt}/><figcaption>{flagshipPresentation[item.id].caption}<span>Open evidence ↗</span></figcaption></a></figure><div><h2>{flagshipPresentation[item.id].title}</h2><p class="case-category">{item.eyebrow}</p><dl><div><dt>Problem</dt><dd>{flagshipPresentation[item.id].problem}</dd></div><div><dt>What I built</dt><dd>{flagshipPresentation[item.id].built}</dd></div><div><dt>Evidence</dt><dd>{flagshipPresentation[item.id].evidence}</dd></div><div><dt>Limit</dt><dd>{flagshipPresentation[item.id].limit}</dd></div></dl><a class="text-link" href={`/work/${item.id}/`}>Read the case →</a></div></article>)}</div><div class="quiet-index"><h2 class="index-heading">More public work</h2>{indexCases.map(item=><div class="index-row"><span><small>{item.eyebrow}</small><strong>{indexTitles[item.id] ?? item.title}</strong></span><span class="proof-marker">{indexProof[item.id] ?? item.plateProof}</span><a class="text-link" href={`/work/${item.id}/`}>Inspect →</a></div>)}</div><p class="evidence-boundary">{boundary}</p><nav class="page-links"><a href="/">Home</a><a href="/experience/">Experience</a><a href="/fit/">Field approach</a><ContactLinks/></nav></div></section></main><script is:inline type="module" src="/interstellar.js"></script></body></html>
<style is:global>
.content-page{padding:clamp(40px,6vw,88px) 0}.route-intro .content-page{padding-bottom:52px}.route-intro h1{max-width:20ch}.lead{max-width:68ch;color:var(--muted);margin-top:18px}.work-section{border-top:1px solid var(--rule)}.flagship-stack{display:grid;gap:56px}.flagship{display:grid;grid-template-columns:minmax(280px,1fr) minmax(0,1fr);gap:clamp(24px,5vw,72px);padding-bottom:56px;border-bottom:1px solid var(--rule);align-items:start}.flagship-art{margin:0}.flagship-art a{display:block;color:inherit;text-decoration:none}.flagship-art img{display:block;width:100%;border:1px solid var(--rule);background:#111}.flagship-art figcaption{padding:12px 0 0;color:var(--muted);font-size:.82rem;line-height:1.45}.flagship-art figcaption span{display:block;margin-top:4px;color:var(--orange);font:500 .72rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.04em}.flagship h2{max-width:20ch;margin-bottom:8px;line-height:1.06;word-spacing:.08em;letter-spacing:-.025em}.case-category{margin:0 0 20px;color:var(--orange);font:500 .76rem/1.4 'DM Mono',monospace;letter-spacing:.04em}.flagship dl{display:grid;gap:14px;margin-bottom:20px}.flagship dl div{display:grid;grid-template-columns:110px 1fr;gap:14px}.flagship dt{font:700 .75rem 'DM Mono',monospace;text-transform:uppercase;color:var(--orange)}.flagship dd{font-size:.9rem;color:var(--muted)}.quiet-index{margin-top:60px}.index-heading{margin:0 0 22px;font-size:clamp(1.6rem,3vw,2.4rem)}.index-row{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(180px,.8fr) auto;gap:18px;padding:16px 0;border-top:1px solid var(--rule);align-items:center}.index-row small,.index-row strong{display:block}.index-row small{font: .7rem 'DM Mono',monospace;color:var(--orange);text-transform:uppercase}.index-row strong{font-size:1rem}.proof-marker{color:var(--muted);font-size:.82rem}.evidence-boundary{margin-top:48px;padding-top:20px;border-top:1px solid var(--rule);max-width:80ch;color:var(--muted);font-size:.8rem}.page-links{display:flex;gap:18px;flex-wrap:wrap;margin-top:28px}.page-links a{min-height:44px;display:inline-flex;align-items:center}@media(max-width:720px){.flagship{grid-template-columns:1fr}.flagship-art{order:-1}.flagship dl div{grid-template-columns:1fr;gap:4px}.index-row{grid-template-columns:1fr;gap:6px}.wrap{width:calc(100% - 28px)}}
</style>