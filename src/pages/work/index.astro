---
import Profile from '../../layouts/Profile.astro';
import SelectedProducts from '../../components/SelectedProducts.astro';
import { projects } from '../../data/profile-projects';
---
<Profile title="Projects — Dave Bettner" page="work" description="Explore Dave Bettner’s products and technical projects, including Passal, Leasekite, and inspectable tools for agent API access, evidence checks, and recovery.">
  <section class="page-intro wrap">
    <h1>Products and tools.</h1>
  </section>
  <section class="wrap" style="padding-bottom: 64px">
    <SelectedProducts headingLevel="h2" />
  </section>
  <section class="paper">
    <div class="section wrap page-projects">
      <h2 style="margin-bottom: 24px; font-size: 32px">Technical tools</h2>
      <p style="max-width: 760px; margin-bottom: 38px">These personal projects explore how agents use APIs, check evidence, and recover from failed actions. The code and demos are separate from my client delivery work. <a href="/ai-workflows/">See the workflows and personal stack behind this approach.</a> <a href="/learn/verify-an-ai-update/">Try the interactive workflow lesson.</a></p>
      <div class="project-list">
        {projects.slice(0, 2).map(project => <article class="project">
          <h2><a href={'/work/' + project.id + '/'}>{project.name}</a></h2>
          <p>{project.summary}</p>
          <p class="project-limit">{project.scope}</p>
          <div class="project-links">
            <a href={'/work/' + project.id + '/'} aria-label={`About the project: ${project.name}`}>About the project</a>
            <a href={project.repo} aria-label={`View repository: ${project.name}`}>View repository</a>
          </div>
        </article>)}
      </div>
      <section class="archive">
        <h2>Further technical work</h2>
        <ul class="archive-list">
          {projects.slice(2).map(project => <li>
            <a href={'/work/' + project.id + '/'}>{project.name}</a>
            <p>{project.summary}</p>
          </li>)}
        </ul>
      </section>
    </div>
  </section>
</Profile>
