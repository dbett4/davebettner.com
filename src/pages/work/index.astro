---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/dm-mono/400.css';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { cases } from '../../data/cases';
import { provenanceNote } from '../../data/public-proof';
import { ogImagePath, siteUrl } from '../../data/seo';

const canonical = `${siteUrl}/work/`;
const title = 'Work | Dave Bettner';
const description =
  'Every public engineering case Dave Bettner has published, with what each one proves, what it does not, and a direct link to the repository.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F5F2EA" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/working-record.css" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImagePath}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <section class="section" aria-labelledby="work-heading">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow mono">Work</p>
            <h1 id="work-heading">Every public case, indexed with its proof and its boundary.</h1>
            <p class="lead">
              Each project links directly to its repository. The proof is public and credential-free; the boundary is
              stated next to it, not left for fine print.
            </p>
          </div>

          <ol class="ruled-list">
            {cases.map((item) => (
              <li class="ruled-row evidence-row-grid" id={item.id}>
                <div class="evidence-row-meta">
                  <p class="mono case-display">{item.eyebrow}</p>
                  <h2>{item.title}</h2>
                </div>
                <div class="evidence-row-body">
                  <p>{item.summary}</p>
                  <p class="muted case-boundary"><strong>Proof:</strong> {item.evidence}</p>
                  <p class="muted case-boundary"><strong>Boundary:</strong> {item.boundary}</p>
                  <p class="section-link work-index-links">
                    <a class="text-link" href={`/work/${item.id}/`}>Read the case <span aria-hidden="true">→</span></a>
                    <a class="text-link" href={item.repoUrl} rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>
                  </p>
                </div>
              </li>
            ))}
          </ol>

          <details class="provenance-disclosure">
            <summary>How to read this evidence</summary>
            <p class="muted">{provenanceNote}</p>
          </details>

          <p class="section-link">
            <a class="text-link" href="/experience/">See the customer-delivery record behind this work <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .work-index-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .provenance-disclosure {
    margin-top: var(--space-4);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-3);
  }

  .provenance-disclosure summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--orange-dark);
  }

  .provenance-disclosure p {
    margin-top: var(--space-2);
    max-width: 82ch;
    font-size: 0.85rem;
    line-height: 1.55;
  }
</style>
