---
import Profile from '../../layouts/Profile.astro';
import {projects} from '../../data/profile-projects';
---
<Profile title="Projects — Dave Bettner" page="work"><section class="page-intro wrap"><h1>AI tools.<br/>Testable behavior.</h1><p class="lead">These personal projects explore how agents use APIs, check evidence, and recover from failed actions. Finance and reporting provide the test cases. The code and demos are separate from my client delivery work.</p></section><section class="paper"><div class="section wrap page-projects"><div class="project-list">{projects.slice(0,2).map(project=><article class="project"><h2><a href={'/work/'+project.id+'/'}>{project.name}</a></h2><p>{project.summary}</p><p class="project-limit">{project.scope}</p><div class="project-links"><a href={'/work/'+project.id+'/'} aria-label={`About the project: ${project.name}`}>About the project</a><a href={project.repo} aria-label={`View repository: ${project.name}`}>View repository</a></div></article>)}</div><section class="archive"><h2>Further technical work</h2><ul class="archive-list">{projects.slice(2).map(project=><li><a href={'/work/'+project.id+'/'}>{project.name}</a><p>{project.summary}</p></li>)}</ul></section></div></section></Profile>
