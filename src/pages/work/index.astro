---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import { cases } from '../../data/cases';
import { provenanceNote } from '../../data/public-proof';
import { siteUrl } from '../../data/seo';
import { githubUrl } from '../../data/site-links';

const canonical = `${siteUrl}/work/`;
const title = 'Work | Dave Bettner — Forward-Deployed Delivery and Agent Systems';
const description =
  'Public labs and case studies from Dave Bettner on enterprise deployment recovery, guarded API tools, and customer workflow quality.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="page-mast">
      <div class="wrap mast-row">
        <a class="back-link mono" href="/">← Home</a>
        <a class="mast-github" href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main">
      <section class="work-cover">
        <div class="wrap content-page">
          <p class="eyebrow mono">Public engineering proof</p>
          <h1>Four public repos. Each page says what the tests actually prove.</h1>
          <p class="lead">
            Deployment recovery, guarded API tools, evaluation, and confirm-before-write quality.
            Each plate links to the repo, the proof, and the stated limits.
          </p>
        </div>
      </section>

      <section class="work-section" aria-labelledby="plates-heading">
        <div class="wrap content-page">
          <div class="section-head">
            <p class="eyebrow mono">Evidence plates · {String(cases.length).padStart(2, '0')}</p>
            <h2 id="plates-heading">Systems built for the hard parts.</h2>
          </div>
          <ul class="work-list">
            {cases.map((item, index) => (
              <li>
                <a class={`work-card visual-${item.visual}`} href={`/work/${item.id}/`}>
                  <span class="work-visual" aria-hidden="true">
                    <span class="work-visual-index mono">PLATE · {String(index + 1).padStart(2, '0')}</span>
                    <span class="work-visual-mark"></span>

                  </span>
                  <span class="work-copy">
                    <span class="work-eyebrow mono">{item.eyebrow}</span>
                    <span class="work-title">{item.title}</span>
                    <span class="work-summary">{item.summary}</span>
                    <span class="work-evidence"><strong>Proof:</strong> {item.evidence}</span>
                    <span class="work-boundary"><strong>Boundary:</strong> {item.boundary}</span>
                    <span class="work-footer">
                      <span class="work-repo mono">{item.repoUrl.replace('https://github.com/', '')}</span>
                      <span class="work-open mono">Open case →</span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <p class="provenance-note">{provenanceNote}</p>

          <nav class="page-links" aria-label="Related pages">
            <a href="/">Home</a>
            <a href="/about/">About Dave Bettner</a>
            <a href="/experience/">Experience</a>
            <a href={githubUrl} rel="me">GitHub <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root { --paper:#f3efe5; --ink:#151515; --blue:#214fe5; --orange:#cf4120; --orange-ink:#9a2f14; --muted:#62615d; --rule:#c9c3b5; --card:#eee8dc; }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:"Plus Jakarta Sans Variable",system-ui,sans-serif; background:var(--paper); color:var(--ink); line-height:1.5; }
  a { color:inherit; text-decoration:none; }
  a:focus-visible { outline:3px solid var(--orange); outline-offset:4px; }
  .skip-link { position:fixed; left:16px; top:16px; z-index:1000; background:var(--ink); color:var(--paper); padding:12px 16px; transform:translateY(-200%); }
  .skip-link:focus { transform:none; }
  .wrap { width:min(100% - 48px, 1280px); margin-inline:auto; }
  .content-page { padding:clamp(40px, 6vw, 88px) 0; }
  .mono { font-family:"DM Mono",ui-monospace,monospace; font-size:.68rem; letter-spacing:.08em; text-transform:uppercase; }
  .page-mast { position:sticky; top:0; z-index:10; background:var(--paper); border-bottom:1px solid var(--ink); }
  .mast-row { min-height:64px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
  .back-link, .mast-github { min-height:44px; display:inline-flex; align-items:center; }
  .back-link { color:var(--muted); }
  .mast-github { border:1px solid var(--ink); padding:0 14px; font-size:.78rem; font-weight:650; }
  .mast-github:hover { background:var(--ink); color:var(--paper); }
  .work-cover { border-bottom:1px solid var(--ink); background:linear-gradient(90deg, transparent 79px, rgba(201,195,181,.32) 79px 80px, transparent 80px), var(--paper); }
  .work-cover .content-page { max-width:900px; margin-left:max(0px, calc((100% - 1280px) / 2)); }
  .eyebrow { color:var(--orange-ink); margin-bottom:12px; }
  h1, h2 { font-family:"Newsreader Variable",Georgia,serif; font-weight:500; letter-spacing:-.04em; line-height:1.04; }
  h1 { max-width:18ch; font-size:clamp(2.35rem,5vw,4.5rem); }
  h2 { font-size:clamp(1.8rem,3.4vw,2.8rem); }
  .lead { max-width:60ch; margin-top:20px; color:var(--muted); font-size:clamp(.96rem,1.5vw,1.08rem); }

  .work-section { background:var(--card); border-bottom:1px solid var(--ink); }
  .section-head { display:grid; gap:10px; margin-bottom:32px; }
  .work-list { list-style:none; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
  .work-card { display:grid; grid-template-columns:minmax(126px,.42fr) minmax(0,1fr); min-height:340px; border:1px solid var(--ink); background:var(--paper); transition:transform .2s ease, box-shadow .2s ease; }
  .work-card:hover, .work-card:focus-visible { transform:translate(-3px,-3px); box-shadow:3px 3px 0 var(--ink); }
  .work-visual { position:relative; min-height:100%; overflow:hidden; border-right:1px solid var(--ink); background:var(--ink); }
  .work-visual::before, .work-visual::after { content:""; position:absolute; inset:0; image-rendering:pixelated; }
  .visual-flow .work-visual::before { background:linear-gradient(90deg, transparent 57%, rgba(33,79,229,.92) 57% 68%, transparent 68%), repeating-linear-gradient(0deg,rgba(243,239,229,.85) 0 1px,transparent 1px 5px); }
  .visual-flow .work-visual::after { inset:25% 14% 25% 0; border:1px solid var(--orange); border-left:0; }
  .visual-rings .work-visual::before { background:repeating-radial-gradient(circle at 50% 50%,transparent 0 12px,rgba(243,239,229,.78) 12px 13px,transparent 13px 24px); }
  .visual-rings .work-visual::after { inset:36% 22%; border:1px solid var(--blue); transform:rotate(45deg); }
  .visual-difference .work-visual::before { background:linear-gradient(90deg,rgba(207,65,32,.9) 0 48%,transparent 48% 52%,rgba(33,79,229,.9) 52% 100%),repeating-linear-gradient(0deg,transparent 0 7px,rgba(243,239,229,.6) 7px 8px); }
  .visual-difference .work-visual::after { inset:14px; border:1px dashed var(--ink); }
  .work-visual-index { position:absolute; z-index:2; color:var(--paper); background:var(--ink); padding:5px 6px; }
  .work-visual-index { top:10px; left:10px; }
  .work-visual-mark { position:absolute; z-index:2; width:9px; height:9px; right:10px; top:10px; background:var(--orange); box-shadow:-3px 3px 0 var(--blue); }
  .work-copy { min-width:0; padding:20px; display:flex; flex-direction:column; align-items:flex-start; }
  .work-eyebrow { color:var(--orange-ink); line-height:1.35; }
  .work-title { display:block; margin:12px 0 10px; font-size:clamp(1.16rem,2vw,1.46rem); font-weight:650; letter-spacing:-.025em; line-height:1.15; }
  .work-summary { color:var(--muted); font-size:.88rem; line-height:1.48; }
  .work-evidence { margin-top:14px; padding-top:12px; border-top:1px solid var(--rule); color:var(--ink); font-size:.76rem; line-height:1.42; }
  .work-boundary { margin-top:8px; color:var(--muted); font-size:.72rem; line-height:1.42; }
  .work-footer { width:100%; display:flex; flex-wrap:wrap; justify-content:space-between; gap:8px 12px; align-items:flex-end; margin-top:auto; padding-top:18px; }
  .work-repo { color:var(--muted); font-size:.7rem; overflow-wrap:anywhere; }
  .work-open { color:var(--blue); font-size:.72rem; white-space:nowrap; }
  .provenance-note { max-width:75ch; margin-top:48px; padding-top:20px; border-top:1px solid var(--rule); color:var(--muted); font-size:.8rem; line-height:1.5; }
  .page-links { display:flex; flex-wrap:wrap; gap:12px 22px; margin-top:32px; }
  .page-links a { min-height:44px; display:inline-flex; align-items:center; text-decoration:underline; text-underline-offset:4px; }
  @media (max-width:760px) { .wrap{width:min(100% - 28px,1280px)} .work-cover .content-page{margin-left:0} .work-list{grid-template-columns:1fr} .work-card{grid-template-columns:100px minmax(0,1fr); min-height:300px} .work-copy{padding:16px} .work-evidence{font-size:.74rem} }
  @media (max-width:420px) { .mast-row{min-height:56px} .work-card{grid-template-columns:1fr; min-height:0} .work-visual{min-height:82px; border-right:0; border-bottom:1px solid var(--ink)} }
  @media (prefers-reduced-motion:reduce) { .work-card{transition:none} .work-card:hover,.work-card:focus-visible{transform:none;box-shadow:none} }
</style>
