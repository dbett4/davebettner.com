---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import { cases } from '../../data/cases';
import { provenanceNote } from '../../data/public-proof';
import { siteUrl } from '../../data/seo';
import { githubUrl } from '../../data/site-links';

const canonical = `${siteUrl}/work/`;
const title = 'Work | Dave Bettner — AI Implementation and Strategic Operations';
const description =
  'Case studies from Dave Bettner on agent operations, deployment, and quality control.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/images/dave-bettner-og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="wrap content-page">
      <a class="back-link mono" href="/">← Home</a>
      <p class="eyebrow mono">Work</p>
      <h1>Selected work</h1>
      <p class="lead">
        Inspectable public repositories with credential-free or offline proof. Each case links to the
        exact GitHub repo and states what is—and is not—claimed.
      </p>

      <ul class="work-list">
        {cases.map((item) => (
          <li>
            <a href={`/work/${item.id}/`}>
              <span class="mono">{item.eyebrow}</span>
              <span class="work-title">{item.title}</span>
              <span class="work-summary">{item.summary}</span>
              <span class="work-repo mono">{item.repoUrl.replace('https://github.com/', '')}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="provenance-note">{provenanceNote}</p>

      <nav class="page-links" aria-label="Related pages">
        <a href="/">Home</a>
        <a href="/about/">About Dave Bettner</a>
        <a href="/experience/">Experience</a>
        <a href={githubUrl} rel="me">GitHub</a>
      </nav>
    </main>
  </body>
</html>

<style is:global>
  :root{--paper:#f3efe5;--ink:#151515;--muted:#62615d}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:"Plus Jakarta Sans Variable",system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.55}
  a{color:inherit;text-decoration:none}
  .skip-link{position:absolute;left:-9999px}
  .skip-link:focus{left:16px;top:16px;z-index:9;background:#fff;padding:8px 12px}
  .content-page{padding:clamp(32px,6vw,72px) 24px 80px;max-width:900px;margin:0 auto}
  .mono{font-family:"DM Mono",ui-monospace,monospace;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
  .back-link{display:inline-block;margin-bottom:24px;color:var(--muted)}
  .eyebrow{color:var(--muted);margin-bottom:12px}
  h1{font-family:"Newsreader Variable",Georgia,serif;font-size:clamp(2rem,4vw,2.8rem);margin-bottom:16px}
  .lead{margin-bottom:32px;max-width:640px}
  .work-list{list-style:none;display:grid;gap:20px}
  .work-list a{display:block;padding:20px 0;border-top:1px solid #c9c3b5}
  .work-list a:hover .work-title{text-decoration:underline}
  .work-title{display:block;font-size:1.25rem;font-weight:600;margin:8px 0}
  .work-summary{display:block;color:var(--muted);max-width:640px}
  .work-repo{display:block;color:var(--muted);margin-top:8px;font-size:.68rem}
  .provenance-note{margin-top:32px;font-size:.82rem;line-height:1.5;color:var(--muted);max-width:640px}
  .page-links{display:flex;flex-wrap:wrap;gap:12px 20px;margin-top:36px}
  .page-links a{text-decoration:underline;text-underline-offset:3px}
</style>
